&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыПодбора = Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор", Ложь, Истина);
	ОткрытьФорму("Документ.ПоступлениеТоваровУслуг.ФормаВыбора", ПараметрыПодбора, Элементы.Поступления);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоступленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПоступленияОбработкаВыбораНаСервере(ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРеализацию(Команда)
	
	// 1.1
	// Получаем форму нового подчиненного документа
	ВыбранныйВидОперации = ПолучитьВидОперацииНаСервере();
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ВидОперации", ВыбранныйВидОперации);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Ключ",                Неопределено);
	СтруктураПараметров.Вставить("ЗначениеКопирования", Неопределено);
	СтруктураПараметров.Вставить("ЗначенияЗаполнения",  ЗначенияЗаполнения);
	СтруктураПараметров.Вставить("Основание",           Неопределено);
	
	ФормаПодчиненного = ПолучитьФорму("Документ.РеализацияТоваровУслуг.Форма.ФормаДокументаТовары", СтруктураПараметров);

	// 1.2
	// Получим объект формы - это Новый - создаваемый объект
	ОбъектФормы = ФормаПодчиненного.Объект;

	// 2. Передадим управление на сервер.
	ЗаполнитьДокументНаСервере(ОбъектФормы);	
	Для каждого Стр Из ОбъектФормы.Товары Цикл
		ТоварыНоменклатураПриИзменении(Стр, ФормаПодчиненного);
	КонецЦикла; 
	
	УчтемДопРасходы();		

	// 3.1
	// В ранее созданной форме нового документа переопределим объект - документ (подменим его на заполненный документ)
	КопироватьДанныеФормы(ОбъектФормы, ФормаПодчиненного.Объект);		

	// 3.2
	ФормаПодчиненного.Модифицированность = Истина; // Чтобы выдавалось сообщение при попытке закрыть документ без сохранения
	ФормаПодчиненного.ПодготовитьФормуНаСервере();
	ФормаПодчиненного.Открыть();	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоступленияДопРасходыПриИзменении(Элемент)
	
	ПоступленияДопРасходыПриИзмененииНаСервере();	
		
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицу(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТаблицу(Команда)
	
	Объект.Поступления.Очистить();
	Объект.Товары.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура НаценкаПриИзменении(Элемент)
	
	НаценкаПриИзмененииНаСервере();	
	ПересчитатьИтоговуюСумму();
	
КонецПроцедуры

&НаКлиенте
Процедура НаценкаСуммойПриИзменении(Элемент)
	
	НаценкаПриИзмененииНаСервере();	
	ПересчитатьИтоговуюСумму();
	
КонецПроцедуры

&НаСервере
Процедура СуммаРеализацииПриИзмененииНаСервере()
	
	ТекСумма = Объект.Товары.Итог("Сумма");
	Отклонение = Объект.СуммаРеализации - ТекСумма;
	
	Товары = Объект.Товары.Выгрузить();
	
	МассивРаспределенныхСтрок = ОбщегоНазначенияБПКлиентСервер.РаспределитьПропорционально(Объект.СуммаРеализации, Товары.ВыгрузитьКолонку("Сумма"));	
	
	Товары.ЗагрузитьКолонку(МассивРаспределенныхСтрок, "Сумма");	
	
	Для Каждого Стр Из Товары Цикл
		           	
		СтавкаНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Стр.СтавкаНДС);
		Если СтавкаНДС = 10 ИЛИ СтавкаНДС = 18 ИЛИ СтавкаНДС = 20 Тогда
			Стр.СуммаБезНДС = Стр.Сумма * 100 / (СтавкаНДС + 100);
			Стр.СуммаНДС = Стр.Сумма - Стр.СуммаБезНДС;
		Иначе
			СуммаНДС = 0;
		КонецЕсли;
		
		Стр.Наценка = Стр.СуммаБезНДС - Стр.Стоимость - Стр.ДопРасходы;
		Стр.ПроцентНаценки = (Стр.СуммаБезНДС / Стр.ПолнаяСебестоимость - 1) * 100;
		//Стр.ПроцентНаценки = Стр.Наценка / Стр.Стоимость * 100;
			
		Стр.Цена = Стр.Сумма / Стр.Количество;
	
	КонецЦикла;
	
	Объект.Товары.Загрузить(Товары);
	
	//Объект.НаценкаСуммой = Товары.Итог("Наценка");
	Если Объект.Товары.Количество() > 0 Тогда 
		Объект.НаценкаДокумента = Товары.Итог("ПроцентНаценки") / Объект.Товары.Количество();
	КонецЕсли;
	
	//НаценкаПриИзмененииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаРеализацииПриИзменении(Элемент)
	Если НЕ Объект.НеПолнаяРеализация Тогда
		СуммаРеализацииПриИзмененииНаСервере();
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПоступленияПередУдалением(Элемент)
	
	ПоступленияПередУдалениемНаСервере(Элементы.Поступления.ТекущиеДанные.Поступление);    
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаРеализацииПриИзменении(Элемент)
	
	ОчиститьИЗаполнитьНаСервере();		
	
КонецПроцедуры

&НаКлиенте
Процедура ПоступленияПослеУдаления(Элемент)
	
	ПоступленияПослеУдаленияНаСервере();	
	
КонецПроцедуры


// ОСНОВНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
