Процедура abc_РассчитатьПрефиксРеализацияТоваровУслуг(Источник, Префикс, ДатаНачала)
	
	Если Источник.Дата >= ДатаНачала Тогда
		День = СокрЛП(День(Источник.Дата));
		Если СтрДлина(День) = 1 Тогда
			День = "" + День;
		КонецЕсли;	
		Месяц = СокрЛП(Месяц(Источник.Дата));
		Если СтрДлина(Месяц) = 1 Тогда
			Месяц = "0" + Месяц;
		КонецЕсли;
		ПрефиксДня = День + "" + Месяц + "";
		Префикс = ПрефиксДня;  
	КонецЕсли;	
	
КонецПроцедуры

Процедура abc_РассчитатьПрефиксСчетФактураВыданный(Источник, Префикс, ДатаНачала)
	
	ПрефиксДня = "";		
	
	Если Источник.Дата >= ДатаНачала Тогда
		День = СокрЛП(День(Источник.Дата));
		Если СтрДлина(День) = 1 Тогда
			День = "" + День;
		КонецЕсли;	
		Месяц = СокрЛП(Месяц(Источник.Дата));
		Если СтрДлина(Месяц) = 1 Тогда
			Месяц = "0" + Месяц;
			//ИначеЕсли СтрДлина(Месяц) = 2 Тогда
			//	Месяц = "00" + Месяц;
		КонецЕсли;
		ПрефиксДня = День + "" + Месяц + "";
		Префикс = ПрефиксДня; 
	КонецЕсли;
	
	
КонецПроцедуры

