&НаКлиенте
Процедура abc_РазделыПриИзмененииВместо(Элемент)
	
	Если Объект.Разделы.Количество() = 0 Тогда
		Объект.Разделы.Добавить();
		//ДК
		НомерРаздела = Объект.Разделы[0].НомерСтроки; 
		ИмяРеквизита = СтруктураИменРеквизитов("ИмяРеквизита.Имя");
		ЗаполнитьПоПоступлению(ЭтотОбъект[ИмяРеквизита], НомерРаздела);
		//ДК
	КонецЕсли;
	
КонецПроцедуры

