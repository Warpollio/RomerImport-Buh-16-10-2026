&НаКлиенте
&После("ДобавитьИзПоступленияЗавершение")
Процедура abc_ДобавитьИзПоступленияЗавершение(РезультатЗакрытия, ДополнительныеПараметры)
	
	ЗаполнитьСписокПоступлений();
	
	ИмяРеквизита = abc_ГТДИмпортКлиентСервер.СтруктураИменРеквизитов("ИмяРеквизита.Имя");	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизита) Тогда
		
		ИмяКолонки = abc_ГТДИмпортКлиентСервер.СтруктураИменРеквизитов("ИмяКолонки.Имя");
		ЭлементРеквизита = Элементы.Найти(ИмяКолонки);
		
		Если ЭлементРеквизита <> Неопределено Тогда 
			
			СписокКодовТНВЭД = ПолучитьСписокВыбора(); 
			ЭлементРеквизита.СписокВыбора.ЗагрузитьЗначения(СписокКодовТНВЭД);
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

