

#Область ПрограммныйИнтерфейс

&После("ПриСозданииНаСервере")
Процедура abc_ПриСозданииНаСервере(Форма, Знач ПараметрыРазмещения)
	
	Если СписокФормДляДополнительнойОбработки().Найти(Форма.ИмяФормы) <> Неопределено Тогда
		
		ИмяПроцедуры = "Вывести%1(Форма)";
		
		Выполнить(СтрШаблон(ИмяПроцедуры, СтрЗаменить(Форма.ИмяФормы, ".", "")));  
		
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

