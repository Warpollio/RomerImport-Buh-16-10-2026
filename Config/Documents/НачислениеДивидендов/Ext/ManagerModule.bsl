#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//  КомандыПечати - см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт

	// Справка о дивидендах
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "СправкаОДивидендах";
	КомандаПечати.Представление = НСтр("ru = 'Справка о дивидендах'");
	КомандаПечати.Обработчик    = "УправлениеПечатьюБПКлиент.ВыполнитьКомандуПечати";
	КомандаПечати.Порядок       = 1;
	
	// Решение единственного участника
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "РешениеЕдинственногоУчастника";
	КомандаПечати.Представление = НСтр("ru = 'Решение единственного участника'");
	КомандаПечати.Обработчик    = "УправлениеПечатьюБПКлиент.ВыполнитьКомандуПечати";
	КомандаПечати.Порядок       = 2;
	
	// Приказ о выплате дивидендов
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ПриказОВыплатеДивидендов";
	КомандаПечати.Представление = НСтр("ru = 'Приказ о выплате дивидендов'");
	КомандаПечати.Обработчик    = "УправлениеПечатьюБПКлиент.ВыполнитьКомандуПечати";
	КомандаПечати.Порядок       = 3;

КонецПроцедуры

// Формирует печатные формы.
//
// Параметры:
//  МассивОбъектов  - Массив из ДокументСсылка.НачислениеДивидендов - ссылки на объекты, которые нужно распечатать;
//  ПараметрыПечати - Структура - дополнительные настройки печати;
//  КоллекцияПечатныхФорм - ТаблицаЗначений - сформированные табличные документы (выходной параметр),
//                                            см. УправлениеПечатью.ПодготовитьКоллекциюПечатныхФорм.
//  ОбъектыПечати   - СписокЗначений из ДокументСсылка.НачислениеДивидендов -
//                      значение - ссылка на объект;
//                      представление - имя области в которой был выведен объект (выходной параметр);
//  ПараметрыВывода - Структура - дополнительные параметры сформированных табличных документов (выходной параметр).
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СправкаОДивидендах") Тогда
		
		ИмяМакета = "СправкаОДивидендах";
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			ИмяМакета, НСтр("ru = 'Справка о дивидендах'"),
			ПечатьНачислениеДивидендов(МассивОбъектов, ОбъектыПечати, ИмяМакета), ,
			"Документ.НачислениеДивидендов.ПФ_MXL_СправкаОДивидендах");
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "РешениеЕдинственногоУчастника") Тогда
		
		ИмяМакета = "РешениеЕдинственногоУчастника";
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			ИмяМакета, НСтр("ru = 'Решение единственного участника'"),
			ПечатьНачислениеДивидендов(МассивОбъектов, ОбъектыПечати, ИмяМакета), ,
			"Документ.НачислениеДивидендов.ПФ_MXL_РешениеЕдинственногоУчастника");
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриказОВыплатеДивидендов") Тогда
		
		ИмяМакета = "ПриказОВыплатеДивидендов";
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			ИмяМакета, НСтр("ru = 'Приказ о выплате дивидендов'"),
			ПечатьНачислениеДивидендов(МассивОбъектов, ОбъектыПечати, ИмяМакета), ,
			"Документ.НачислениеДивидендов.ПФ_MXL_ПриказОВыплатеДивидендов");
		
	КонецЕсли;

	ОбщегоНазначенияБП.ЗаполнитьДополнительныеПараметрыПечати(
		МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
КонецПроцедуры

#КонецОбласти

#Область ПодготовкаПараметровПроведенияДокумента

Функция ПодготовитьПараметрыПроведения(ДокументСсылка, Отказ) Экспорт

	ПараметрыПроведения = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка КАК Регистратор,
	|	Реквизиты.Дата КАК Период,
	|	Реквизиты.Организация КАК Организация,
	|	Реквизиты.ПланируемаяДатаВыплаты КАК ПланируемаяДатаВыплаты
	|ИЗ
	|	Документ.НачислениеДивидендов КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";

	Результат = Запрос.Выполнить();

	Реквизиты = ОбщегоНазначенияБПВызовСервера.ПолучитьСтруктуруИзРезультатаЗапроса(Результат);

	НомераТаблиц = Новый Структура;

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Период", Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);

	Запрос.Текст =
		ТекстЗапросаРеквизитыДокумента(НомераТаблиц)
		+ ТекстЗапросаДивиденды(НомераТаблиц, Реквизиты)
		+ ТекстЗапросаДивидендыНДФЛ(НомераТаблиц, Реквизиты)
	;

	Результат = Запрос.ВыполнитьПакет();

	Для каждого НомерТаблицы Из НомераТаблиц Цикл
		ПараметрыПроведения.Вставить(НомерТаблицы.Ключ, Результат[НомерТаблицы.Значение].Выгрузить());
	КонецЦикла;

	Возврат ПараметрыПроведения;

КонецФункции

Функция ТекстЗапросаРеквизитыДокумента(НомераТаблиц)

	НомераТаблиц.Вставить("Реквизиты", НомераТаблиц.Количество());

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Реквизиты.Ссылка                         КАК Регистратор,
	|	Реквизиты.Дата                           КАК Период,
	|	Реквизиты.Организация                    КАК Организация,
	|	Реквизиты.ПланируемаяДатаВыплаты         КАК ПланируемаяДатаВыплаты
	|ИЗ
	|	Документ.НачислениеДивидендов КАК Реквизиты
	|ГДЕ
	|	Реквизиты.Ссылка = &Ссылка";

	Возврат ТекстЗапроса + ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();

КонецФункции

Функция ТекстЗапросаДивиденды(НомераТаблиц, Реквизиты)

	НомераТаблиц.Вставить("ТаблицаДивиденды", НомераТаблиц.Количество());

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	""ТаблицаДивиденды"" КАК ИмяСписка,
	|	Док.Ссылка КАК Регистратор,
	|	&Период КАК Период,
	|	Док.РасчетныйПериод КАК РасчетныйПериод,
	|	Док.ТипУчредителя КАК ТипУчредителя,
	|	Док.Учредитель КАК Учредитель,
	|	Док.СуммаДохода КАК СуммаДохода,
	|	Док.СуммаНалога КАК СуммаНалога,
	|	Док.СуммаНалогаСПревышения КАК СуммаНалогаСПревышения
	|ИЗ
	|	Документ.НачислениеДивидендов КАК Док
	|ГДЕ
	|	Док.Ссылка = &Ссылка";

	Возврат ТекстЗапроса + ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();

КонецФункции

Функция ТекстЗапросаДивидендыНДФЛ(НомераТаблиц, Реквизиты)

	НомераТаблиц.Вставить("ТаблицаДивидендыНДФЛ", НомераТаблиц.Количество());

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	""ТаблицаДивидендыНДФЛ"" КАК ИмяСписка,
	|	Док.Ссылка КАК Регистратор,
	|	&Период КАК Период,
	|	Док.Учредитель КАК Акционер,
	|	Док.СуммаДохода КАК Начислено,
	|	Док.СуммаНалога КАК НДФЛ,
	|	Док.СуммаНалогаСПревышения КАК НДФЛСПревышения
	|ИЗ
	|	Документ.НачислениеДивидендов КАК Док
	|ГДЕ
	|	Док.Ссылка = &Ссылка
	|	И Док.ТипУчредителя = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)";

	Возврат ТекстЗапроса + ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();

КонецФункции

#КонецОбласти

#Область ПроведениеДокумента

Процедура СформироватьПроводки(ТаблицаРеквизиты, ТаблицаОтраженияВУчете, Движения, Отказ) Экспорт
	
	Если Не ЗначениеЗаполнено(ТаблицаОтраженияВУчете) Тогда
		Возврат;
	КонецЕсли;
	
	Параметры = ПодготовитьПараметрыДвиженийОтраженияДивидендов(ТаблицаОтраженияВУчете, ТаблицаРеквизиты);
	Реквизиты = Параметры.Реквизиты[0];
	
	РегистрацияВНалоговомОргане = Справочники.Организации.РегистрацияВНалоговомОрганеНаДату(Реквизиты.Организация, Реквизиты.Период);
	
	ТаблицаОтраженияВУчете = Параметры.ТаблицаОтраженияВУчете;

	Для Каждого СтрокаТаблицы из ТаблицаОтраженияВУчете Цикл
		
		ПериодНачисленияСтрокой = ПредставлениеПериода(НачалоГода(СтрокаТаблицы.РасчетныйПериод),
									КонецКвартала(СтрокаТаблицы.РасчетныйПериод),
									"ФП = Истина");
		Если ЗначениеЗаполнено(ПериодНачисленияСтрокой) Тогда
			ПериодНачисленияСтрокой = СтрШаблон(НСтр("ru=' за %1'"), ПериодНачисленияСтрокой);
		КонецЕсли;
		
		// Начисление
		Проводка = Движения.Хозрасчетный.Добавить();
		Проводка.Организация = Реквизиты.Организация;
		Проводка.Период      = Реквизиты.Период;
		
		Проводка.Сумма = СтрокаТаблицы.СуммаДохода;
		Проводка.Содержание = СтрШаблон(НСтр("ru='Начислены дивиденды%1'"), ПериодНачисленияСтрокой);
		
		Проводка.СчетДт = ПланыСчетов.Хозрасчетный.ПрибыльПодлежащаяРаспределению;
		Проводка.СчетКт = ПланыСчетов.Хозрасчетный.РасчетыПоВыплатеДоходов;
		БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, "Учредители", СтрокаТаблицы.Учредитель);
			
		// Налог
		Если СтрокаТаблицы.СуммаНалога <> 0 Тогда
			
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Организация = Реквизиты.Организация;
			Проводка.Период      = Реквизиты.Период;
			
			Проводка.Сумма = СтрокаТаблицы.СуммаНалога;
			
			Проводка.СчетДт = ПланыСчетов.Хозрасчетный.РасчетыПоВыплатеДоходов;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Учредители", СтрокаТаблицы.Учредитель);
			Если СтрокаТаблицы.ТипУчредителя = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
				Проводка.Содержание = СтрШаблон(НСтр("ru='НДФЛ с дивидендов%1'"), ПериодНачисленияСтрокой);
				Проводка.СчетКт     = ПланыСчетов.Хозрасчетный.НДФЛ;
			Иначе
				Проводка.Содержание = СтрШаблон(НСтр("ru='Налог на прибыль с дивидендов%1'"), ПериодНачисленияСтрокой);
				Проводка.СчетКт     = ПланыСчетов.Хозрасчетный.НалогНаПрибыльНалоговогоАгента;
			КонецЕсли;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, Перечисления.ВидыПлатежейВГосБюджет.Налог);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, РегистрацияВНалоговомОргане);
			
		КонецЕсли;
		
		Если СтрокаТаблицы.СуммаНалогаСПревышения <> 0
			И СтрокаТаблицы.ТипУчредителя = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
			
			Проводка = Движения.Хозрасчетный.Добавить();
			Проводка.Организация = Реквизиты.Организация;
			Проводка.Период      = Реквизиты.Период;
			
			Проводка.Сумма = СтрокаТаблицы.СуммаНалогаСПревышения;
			
			Проводка.СчетДт = ПланыСчетов.Хозрасчетный.РасчетыПоВыплатеДоходов;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, "Учредители", СтрокаТаблицы.Учредитель);
			Проводка.Содержание = СтрШаблон(НСтр("ru='НДФЛ с дивидендов (доходы свыше предельной величины)%1'"), ПериодНачисленияСтрокой);
			Проводка.СчетКт     = ПланыСчетов.Хозрасчетный.НДФЛ;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, Перечисления.ВидыПлатежейВГосБюджет.Налог);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, РегистрацияВНалоговомОргане);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Движения.Хозрасчетный.Записывать = Истина;
	
КонецПроцедуры

Функция ПодготовитьПараметрыДвиженийОтраженияДивидендов(ТаблицаОтраженияВУчете, ТаблицаРеквизиты)
	
	Параметры = Новый Структура;
	
	// Подготовка таблицы шапки документа
	СписокОбязательныхКолонок = ""
	+ "Регистратор,"	// <ДокументСсылка.НачислениеДивидендов> - Регистратор
	+ "Период,"			// <Дата> - счет по дебету проводки (счет учета денежных средств)
	+ "Организация"		// <СправочникСсылка.Организации> - организация документа
	;
	
	Параметры.Вставить("Реквизиты", ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(ТаблицаРеквизиты, СписокОбязательныхКолонок));
	
	// Подготовка таблицы по дивидендам:
	СписокОбязательныхКолонок = ""
	+ "РасчетныйПериод,"		// <Дата>
	+ "Учредитель,"				// <СправочникСсылка.ФизическиеЛица, СпраочникСсылка.Контрагенты>
	+ "ТипУчредителя,"			// <ПеречислениеСсылка.ЮридическоеФизическоеЛицо>
	+ "СуммаДохода,"			// <Число(15,2)>
	+ "СуммаНалога,"			// <Число(15,2)>
	+ "СуммаНалогаСПревышения"	// <Число(15,2)>
	;
	
	Параметры.Вставить("ТаблицаОтраженияВУчете", ОбщегоНазначенияБПВызовСервера.ПолучитьТаблицуПараметровПроведения(ТаблицаОтраженияВУчете, СписокОбязательныхКолонок));

	Возврат Параметры;

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция РассчитатьНалог(Учредитель, ТипУчредителя, СуммаДохода, Период, Организация, Регистратор) Экспорт
	
	Если ТипУчредителя = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		Возврат РассчитатьНДФЛ(Учредитель, СуммаДохода, Период, Организация, Регистратор);
	Иначе
		Возврат РассчитатьНалогНаПрибыль(СуммаДохода);
	КонецЕсли;
	
КонецФункции

Функция РассчитатьНДФЛ(Учредитель, СуммаДохода, ДатаПолученияДохода, Организация, Регистратор) Экспорт
	
	Возврат УчетЗарплаты.НалогСДивидендовАкционера(ДатаПолученияДохода, Организация, Учредитель, СуммаДохода, Регистратор);
	
КонецФункции

Функция РассчитатьНалогНаПрибыль(СуммаДохода) Экспорт
	
	Возврат Новый Структура("СуммаНалога", Окр(СуммаДохода * 13/ 100, 2));
	
КонецФункции

#КонецОбласти

#Область ОбработчикиОбновления

Процедура ЗаполнитьПланируемуюДатуВыплаты() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачислениеДивидендов.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.НачислениеДивидендов КАК НачислениеДивидендов
	|ГДЕ
	|	НачислениеДивидендов.ПланируемаяДатаВыплаты = ДАТАВРЕМЯ(1, 1, 1)";
	
	Выборка= Запрос.Выполнить().Выбрать();
	
	
	Пока Выборка.Следующий() Цикл
		Попытка
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ДокументОбъект.ПланируемаяДатаВыплаты = ДокументОбъект.Дата;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
		Исключение
			
			ШаблонСообщения = НСтр("ru = 'Не удалось обработать документ: %1
				|%2'");
			ТекстСообщения = СтрШаблон(ШаблонСообщения, Выборка.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка,
				,
				Выборка.Ссылка,
				ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьНачислениеДивидендов(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	ДокументРезультат = Новый ТабличныйДокумент;
	ДокументРезультат.КлючПараметровПечати = СтрШаблон("ПАРАМЕТРЫ_ПЕЧАТИ_НачислениеДивидендов_%1", ИмяМакета);
	
	Макет = УправлениеПечатью.МакетПечатнойФормы(СтрШаблон("Документ.НачислениеДивидендов.ПФ_MXL_%1", ИмяМакета));
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НачислениеДивидендов.Ссылка КАК Ссылка,
	|	НачислениеДивидендов.Дата КАК Дата,
	|	НачислениеДивидендов.Номер КАК Номер,
	|	НачислениеДивидендов.Организация КАК Организация,
	|	НачислениеДивидендов.РасчетныйПериод КАК РасчетныйПериод,
	|	НачислениеДивидендов.ТипУчредителя КАК ТипУчредителя,
	|	НачислениеДивидендов.Учредитель КАК Учредитель,
	|	ПРЕДСТАВЛЕНИЕ(НачислениеДивидендов.Учредитель) КАК УчредительПредставление,
	|	НачислениеДивидендов.СуммаДохода КАК СуммаДохода,
	|	НачислениеДивидендов.СуммаНалога + НачислениеДивидендов.СуммаНалогаСПревышения КАК СуммаНалогаИтог,
	|	НачислениеДивидендов.СуммаДохода - НачислениеДивидендов.СуммаНалога - НачислениеДивидендов.СуммаНалогаСПревышения КАК СуммаКВыплате
	|ИЗ
	|	Документ.НачислениеДивидендов КАК НачислениеДивидендов
	|ГДЕ
	|	НачислениеДивидендов.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ДокументРезультат;
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	РеквизитыВалюты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВалютаРегламентированногоУчета, "НаименованиеПолное, Наименование");
	
	ВыборкаДокумент = РезультатЗапроса.Выбрать();
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		// Запомним номер строки, с которой начали выводить текущий документ - см. УправлениеПечатью.ЗадатьОбластьПечатиДокумента
		НомерСтрокиНачало = ДокументРезультат.ВысотаТаблицы + 1;
		
		// Очистим параметры области от значений предыдущего документа
		ОбластьМакетаШапка = Макет.ПолучитьОбласть("Шапка");
		
		// Получим данные для шапки документа
		СведенияОбОрганизации = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(ВыборкаДокумент.Организация, ВыборкаДокумент.Дата);
		ОрганизацияПолное = ОбщегоНазначенияБПВызовСервера.ОписаниеОрганизации(СведенияОбОрганизации, "НаименованиеДляПечатныхФорм");
		ОрганизацияКратко = ОбщегоНазначенияБПВызовСервера.ОписаниеОрганизации(СведенияОбОрганизации, "СокращенноеНаименование");
		ОрганизацияОписание = ОбщегоНазначенияБПВызовСервера.ОписаниеОрганизации(СведенияОбОрганизации);
		
		УчредительПолное = ВыборкаДокумент.УчредительПредставление;
		УчредительКратко = ВыборкаДокумент.УчредительПредставление;
		
		Если ВыборкаДокумент.ТипУчредителя = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
			
			ПредставленияУчредителя = УчетЗарплаты.ПредставлениеФизическогоЛица(ВыборкаДокумент.Учредитель, ВыборкаДокумент.Дата);
			УчредительПолное = ПредставленияУчредителя.ФИОПолные;
			УчредительКратко = ПредставленияУчредителя.ФамилияИО;
			
		ИначеЕсли ВыборкаДокумент.ТипУчредителя = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
			
			СведенияОбУчредителе = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(ВыборкаДокумент.Учредитель, ВыборкаДокумент.Дата);
			УчредительПолное = ОбщегоНазначенияБПВызовСервера.ОписаниеОрганизации(СведенияОбУчредителе, "НаименованиеДляПечатныхФорм");
			УчредительКратко = ОбщегоНазначенияБПВызовСервера.ОписаниеОрганизации(СведенияОбУчредителе, "СокращенноеНаименование");
			
		КонецЕсли;
		
		ПериодНачисленияСтрокой = ПредставлениеПериода(НачалоГода(ВыборкаДокумент.РасчетныйПериод),
							КонецКвартала(ВыборкаДокумент.РасчетныйПериод),
							"ФП = Истина");
		
		СуммаДоходаПрописью = ОбщегоНазначенияБПВызовСервера.СформироватьСуммуПрописью(ВыборкаДокумент.СуммаДохода, ВалютаРегламентированногоУчета);
		СуммаДоходаДлинаСтроки = 52;
		СуммаДоходаПоСтрокам = РазделитьСтрокуПоДлине(СуммаДоходаПрописью, СуммаДоходаДлинаСтроки);
		ДобавитьСкобкиВСтроки(СуммаДоходаПоСтрокам);
		
		ДанныеШапки = Новый Структура;
		ДанныеШапки.Вставить("ОрганизацияПолное", ОрганизацияПолное);
		ДанныеШапки.Вставить("ОрганизацияКратко", ОрганизацияКратко);
		ДанныеШапки.Вставить("ОрганизацияОписание", ОрганизацияОписание);
		ДанныеШапки.Вставить("ОГРН", СведенияОбОрганизации.ОГРН);
		ДанныеШапки.Вставить("ИНН", СведенияОбОрганизации.ИНН);
		ДанныеШапки.Вставить("ЮридическийАдрес", СведенияОбОрганизации.ЮридическийАдрес);
		ДанныеШапки.Вставить("ЕдиницаИзмерения", РеквизитыВалюты.НаименованиеПолное);
		ДанныеШапки.Вставить("Вал", РеквизитыВалюты.Наименование);
		ДанныеШапки.Вставить("ПериодНачисленияСтрокой", ПериодНачисленияСтрокой);
		ДанныеШапки.Вставить("НомерДокумента", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ВыборкаДокумент.Номер, Истина, Ложь));
		ДанныеШапки.Вставить("ДатаДокумента", Формат(ВыборкаДокумент.Дата, "ДЛФ=D"));
		ДанныеШапки.Вставить("УчредительПолное", УчредительПолное);
		ДанныеШапки.Вставить("УчредительКратко", УчредительКратко);
		ДанныеШапки.Вставить("СуммаКВыплате", ВыборкаДокумент.СуммаКВыплате);
		ДанныеШапки.Вставить("СуммаНалогаИтог", ВыборкаДокумент.СуммаНалогаИтог);
		ДанныеШапки.Вставить("СуммаДохода", ВыборкаДокумент.СуммаДохода);
		ДанныеШапки.Вставить("СуммаДоходаПрописью", СуммаДоходаПоСтрокам.ПерваяСтрока);
		ДанныеШапки.Вставить("СуммаДоходаПрописьюПродолжение", СуммаДоходаПоСтрокам.ВтораяСтрока);
		
		Если ИмяМакета = "РешениеЕдинственногоУчастника" Тогда
			
			ДополнитьДанныеШапкиЧистыеАктивы(ДанныеШапки, ВыборкаДокумент, ВалютаРегламентированногоУчета);
			ДополнитьДанныеШапкиУчредитель(ДанныеШапки, ВыборкаДокумент, УчредительКратко);
			
		ИначеЕсли ИмяМакета = "ПриказОВыплатеДивидендов" Тогда
			
			ДополнитьДанныеШапкиОтветственныеЛица(ДанныеШапки, ВыборкаДокумент);
			
		КонецЕсли;
		
		ОбластьМакетаШапка.Параметры.Заполнить(ДанныеШапки);
		ДокументРезультат.Вывести(ОбластьМакетаШапка);
		
		Если ИмяМакета = "РешениеЕдинственногоУчастника" Тогда
			
			// Для решения единственного участника выведем подвал в зависимости от типа учредителя
			Если ВыборкаДокумент.ТипУчредителя = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
				ОбластьМакетаПодвал = Макет.ПолучитьОбласть("ПодвалФизЛицо");
			Иначе
				ОбластьМакетаПодвал = Макет.ПолучитьОбласть("ПодвалЮрЛицо");
			КонецЕсли;
			
			ОбластьМакетаПодвал.Параметры.Заполнить(ДанныеШапки);
			ДокументРезультат.Вывести(ОбластьМакетаПодвал);
			
		КонецЕсли;
		
		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ДокументРезультат, 
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокумент.Ссылка);
		
	КонецЦикла;
	
	Возврат ДокументРезультат;
	
КонецФункции

Процедура ДополнитьДанныеШапкиЧистыеАктивы(ДанныеШапки, ВыборкаДокумент, ВалютаРегламентированногоУчета)
	
	// Получим стоимость чистых активов по данным учета
	ЧистыеАктивы = "";
	ЧистыеАктивыПрописью = "";
	
	СтоимостьЧистыхАктивов = Отчеты.РасчетСтоимостиЧистыхАктивов.РассчитатьСтоимостьЧистыхАктивов(
														ВыборкаДокумент.Организация, 
														ВыборкаДокумент.РасчетныйПериод);
	
	Если СтоимостьЧистыхАктивов > 0 Тогда
		
		ЧистыеАктивы = СтоимостьЧистыхАктивов;
		ЧистыеАктивыПрописью = ОбщегоНазначенияБПВызовСервера.СформироватьСуммуПрописью(СтоимостьЧистыхАктивов, ВалютаРегламентированногоУчета);
		
	КонецЕсли;
	
	ЧистыеАктивыДлинаСтроки = 52;
	ЧистыеАктивыПоСтрокам = РазделитьСтрокуПоДлине(ЧистыеАктивыПрописью, ЧистыеАктивыДлинаСтроки);
	ДобавитьСкобкиВСтроки(ЧистыеАктивыПоСтрокам);
	
	ДанныеШапки.Вставить("ЧистыеАктивы", ЧистыеАктивы);
	ДанныеШапки.Вставить("ЧистыеАктивыПрописью", ЧистыеАктивыПоСтрокам.ПерваяСтрока);
	ДанныеШапки.Вставить("ЧистыеАктивыПрописьюПродолжение", ЧистыеАктивыПоСтрокам.ВтораяСтрока);
	
КонецПроцедуры

Процедура ДополнитьДанныеШапкиУчредитель(ДанныеШапки, ВыборкаДокумент, УчредительКратко)
	
	// Получим дополнительные данные об учредителе
	УчредительПолноеОписание = "";
	УчредительКраткоВДатПадеже = УчредительКратко;
	УчредительКраткоВРодПадеже = УчредительКратко;
	
	Если ВыборкаДокумент.ТипУчредителя = Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		
		// Для участника-физического лица получим документ, адрес по прописке, и просклоняем 
		ИменаПолей = "ДокументПредставление, АдресПоПропискеПредставление, Пол";
		КадровыеДанныеУчредителя = УчетЗарплаты.КадровыеДанныеФизическогоЛица(ВыборкаДокумент.Учредитель, ИменаПолей, ВыборкаДокумент.Дата);
		
		Если КадровыеДанныеУчредителя <> Неопределено Тогда
			
			ДанныеОписания = Новый Массив;
			Если ЗначениеЗаполнено(КадровыеДанныеУчредителя.ДокументПредставление) Тогда
				ДанныеОписания.Добавить(КадровыеДанныеУчредителя.ДокументПредставление);
			КонецЕсли;
			Если ЗначениеЗаполнено(КадровыеДанныеУчредителя.АдресПоПропискеПредставление) Тогда
				ДанныеОписания.Добавить(СтрШаблон(НСтр("ru = 'адрес регистрации: %1'"), КадровыеДанныеУчредителя.АдресПоПропискеПредставление));
			КонецЕсли;
			
			УчредительПолноеОписание = СтрСоединить(ДанныеОписания, ", ");
			
			ДательныйПадеж = 3;
			УчетЗарплаты.Просклонять(УчредительКратко, ДательныйПадеж, УчредительКраткоВДатПадеже, КадровыеДанныеУчредителя.Пол);
			РодительныйПадеж = 2;
			УчетЗарплаты.Просклонять(УчредительКратко, РодительныйПадеж, УчредительКраткоВРодПадеже, КадровыеДанныеУчредителя.Пол);
			
		КонецЕсли;
		
	ИначеЕсли ВыборкаДокумент.ТипУчредителя = Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо Тогда
		
		// Для участника-юридического лица получим описание, юридический адрес
		СведенияОбУчредителе = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(ВыборкаДокумент.Учредитель, ВыборкаДокумент.Дата);
		
		УчредительПолноеОписание = ОбщегоНазначенияБПВызовСервера.ОписаниеОрганизации(СведенияОбУчредителе, "ОГРН, ИНН, КПП, ЮридическийАдрес");
		
	КонецЕсли;
	
	УчредительПолноеОписаниеДлинаСтроки = 100;
	УчредительПолноеОписаниеПоСтрокам = РазделитьСтрокуПоДлине(УчредительПолноеОписание, УчредительПолноеОписаниеДлинаСтроки);
	
	ДанныеШапки.Вставить("УчредительПолноеОписание", УчредительПолноеОписаниеПоСтрокам.ПерваяСтрока);
	ДанныеШапки.Вставить("УчредительПолноеОписаниеПродолжение", УчредительПолноеОписаниеПоСтрокам.ВтораяСтрока);
	ДанныеШапки.Вставить("УчредительКраткоВДатПадеже", УчредительКраткоВДатПадеже);
	ДанныеШапки.Вставить("УчредительКраткоВРодПадеже", УчредительКраткоВРодПадеже); 
	
КонецПроцедуры

Процедура ДополнитьДанныеШапкиОтветственныеЛица(ДанныеШапки, ВыборкаДокумент)
	
	// Получим ответственных лиц и просклоняем полные ФИО главного бухгалтера
	ОтветственныеЛица = ОтветственныеЛицаБП.ОтветственныеЛица(ВыборкаДокумент.Организация, ВыборкаДокумент.Дата);
	
	ДанныеГлавногоБухгалтера = УчетЗарплаты.ДанныеФизическихЛиц(ВыборкаДокумент.Организация, 
							ОтветственныеЛица.ГлавныйБухгалтер, ВыборкаДокумент.Дата, Ложь);
	
	ГлавномуБухгалтеруФИО = ДанныеГлавногоБухгалтера.Представление;
	ДательныйПадеж = 3;
	УчетЗарплаты.Просклонять(ДанныеГлавногоБухгалтера.Представление, ДательныйПадеж, ГлавномуБухгалтеруФИО, ДанныеГлавногоБухгалтера.Пол);
	
	ДанныеШапки.Вставить("РуководительФамилияИО", ОтветственныеЛица.РуководительПредставление);
	ДанныеШапки.Вставить("ГлавныйБухгалтерФамилияИО", ОтветственныеЛица.ГлавныйБухгалтерПредставление);
	ДанныеШапки.Вставить("ГлавномуБухгалтеруФИО", ГлавномуБухгалтеруФИО);
	
КонецПроцедуры

Функция РазделитьСтрокуПоДлине(ТекстСтроки, ДлинаСтроки)
	
	Результат = Новый Структура;
	Результат.Вставить("ПерваяСтрока", ТекстСтроки);
	Результат.Вставить("ВтораяСтрока", "");
	
	Если СтрДлина(ТекстСтроки) <= ДлинаСтроки Тогда
		Возврат Результат;
	КонецЕсли;
	
	// Найдем ближайший пробел для переноса строки
	Позиция = ДлинаСтроки;
	Пока Позиция > 0 И Сред(ТекстСтроки, Позиция, 1) <> " " Цикл
		Позиция = Позиция - 1;
	КонецЦикла;
	
	Результат.Вставить("ПерваяСтрока", Лев(ТекстСтроки, Позиция));
	Результат.Вставить("ВтораяСтрока", Сред(ТекстСтроки, Позиция + 1));
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьСкобкиВСтроки(ТекстПоСтрокам)
	
	Если НЕ ЗначениеЗаполнено(ТекстПоСтрокам.ПерваяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстПоСтрокам.ПерваяСтрока = СтрШаблон("(%1", ТекстПоСтрокам.ПерваяСтрока);
	Если ЗначениеЗаполнено(ТекстПоСтрокам.ВтораяСтрока) Тогда
		ТекстПоСтрокам.ВтораяСтрока = СтрШаблон("%1)", ТекстПоСтрокам.ВтораяСтрока);
	Иначе
		ТекстПоСтрокам.ПерваяСтрока = СтрШаблон("%1)", ТекстПоСтрокам.ПерваяСтрока);
	КонецЕсли;
	
КонецПроцедуры

