Процедура ЗаполнитьДанныеЗаявки(ДанныеЗаявки, ДанныеОтветаСервера) Экспорт
	
	СтруктураОтветаСервера = ОбщегоНазначения.JSONВЗначение(ДанныеОтветаСервера, , Ложь);
	Если ТипЗнч(СтруктураОтветаСервера) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	СтруктураИменПолейОтветаБанка = СтруктураИменПолейОтветаБанка();
	Для Каждого ЭлементСтруктуры Из ДанныеЗаявки Цикл
		ИмяРеквизита = "";
		Если СтруктураИменПолейОтветаБанка.Свойство(ЭлементСтруктуры.Ключ, ИмяРеквизита) Тогда
			ЗначениеРеквизита = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураОтветаСервера, ИмяРеквизита, "");
			ДанныеЗаявки[ЭлементСтруктуры.Ключ] = ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗаявки.СуммаЗаявки = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ДанныеЗаявки.СуммаЗаявки);
	
