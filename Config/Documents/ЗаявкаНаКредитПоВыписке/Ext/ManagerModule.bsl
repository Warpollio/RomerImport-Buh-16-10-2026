Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы <> "ФормаДокумента"
		И ВидФормы <> "ФормаОбъекта" Тогда
		Возврат;
	КонецЕсли;
	
	Значение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Ключ");
	
	СтандартнаяОбработка = Ложь;
	Если Значение = Неопределено Тогда
		ВыбраннаяФорма = "ФормаДокумента";
	Иначе
		СведенияОСостоянииЗаявки = СведенияОСостоянииЗаявки(Параметры.Ключ);
		Если СведенияОСостоянииЗаявки.Состояние = Перечисления.СостоянияЗаявокНаКредит.Черновик Тогда
			ВыбраннаяФорма = "ФормаДокумента";
		Иначе
			ВыбраннаяФорма = "ФормаОтправленнойЗаявки";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

