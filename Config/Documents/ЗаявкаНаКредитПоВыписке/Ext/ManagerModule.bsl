#Область ПрограммныйИнтерфейс

// Возвращает последнюю по дате заявку на кредит по выписке в статусе "Отправлено"
// для указанной организации.
//
// Параметры:
//   Организация - СправочникСсылка.Организации - организация, для которой выполняется поиск заявки
//
// Возвращаемое значение:
//   ДокументСсылка.ЗаявкаНаКредитПоВыписке - последняя по дате заявка в статусе "Отправлено"
//   - Неопределено - если заявок в указанном статусе для организации не найдено
//
Функция ЗаявкаВСтатусеОтправлено(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СостояниеЗаявокНаКредит.ЗаявкаНаКредит КАК ЗаявкаНаКредит
		|ИЗ
		|	РегистрСведений.СостояниеЗаявокНаКредит КАК СостояниеЗаявокНаКредит
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаявкаНаКредитПоВыписке КАК ЗаявкаНаКредитПоВыписке
		|		ПО СостояниеЗаявокНаКредит.ЗаявкаНаКредит = ЗаявкаНаКредитПоВыписке.Ссылка
		|ГДЕ
		|	СостояниеЗаявокНаКредит.Состояние = &Состояние
		|	И ЗаявкаНаКредитПоВыписке.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаявкаНаКредитПоВыписке.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Состояние", Перечисления.СостоянияЗаявокНаКредит.Отправлено); 
	Запрос.УстановитьПараметр("Организация", Организация);

	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ЗаявкаНаКредит;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает количество месяцев, за которое производится выборка документов Списание на расчетный счет.
//
// Возвращаемое значение:
//   Число - количество месяцев выборки
//
Функция КоличествоМесяцевВыборкиДокументов() Экспорт
	Возврат 3;
КонецФункции

// Возвращает соответствие статусов заявок на кредит.
//
// Возвращаемое значение:
//   Соответствие - соответствие статусов заявок на кредит.
//     * Ключ - Строка - статус заявки на кредит в сервисе.
//     * Значение - ПеречислениеСсылка.СостоянияЗаявокНаКредит - статус заявки на кредит в программе.
//
Функция СоответствиеСтатусовЗаявок() Экспорт
	
	Результат = Новый Соответствие;
	Результат.Вставить("IN_PROGRESS", Перечисления.СостоянияЗаявокНаКредит.ОжидаетРешения);
	Результат.Вставить("APPROVED", Перечисления.СостоянияЗаявокНаКредит.Одобрено);
	Результат.Вставить("REJECTED", Перечисления.СостоянияЗаявокНаКредит.Отказано);
	Результат.Вставить("AUTHORIZATION", Перечисления.СостоянияЗаявокНаКредит.Отправлено);
	Результат.Вставить("CONFIRMATION", Перечисления.СостоянияЗаявокНаКредит.ОжидаетПодтверждения);
	Результат.Вставить("SIGNING", Перечисления.СостоянияЗаявокНаКредит.Подписание);

	Возврат Результат;
	
КонецФункции

