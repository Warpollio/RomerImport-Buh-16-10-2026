	Возврат ДанныеПредложенийВСервисе();
	
КонецФункции

// Подготавливает данные для отправки в сервис .
//
// Параметры:
//   Параметры - Структура - данные заявки
//
Функция ДанныеДляОтправки(Параметры)
	
	ДлительныеОперации.СообщитьПрогресс(25, НСтр("ru = 'Подготовка информации заявки...'"));

	РеквизитыСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.СчетОрганизации, "НомерСчета, Банк"); 
	РеквизитыБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыСчета.Банк, "Код, КоррСчет, Наименование"); 
	
	ЗапрашиваемыеРеквизиты = "НаимЮЛПол,ОГРН,ИННЮЛ,КППЮЛ,ТелОрганизации";
	
	ДанныеОрганизации = РегламентированнаяОтчетностьВызовСервера.ПолучитьСведенияОбОрганизации(
			Параметры.Организация,
			,
			ЗапрашиваемыеРеквизиты);
	ЮридическоеФизическоеЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Организация, "ЮридическоеФизическоеЛицо");
	ПараметрыЗаявки = НовыйПараметрыЗаявки();
	ПараметрыЗаявки.СуммаЗаявки = XMLСтрока(Параметры.СуммаЗаявки);
	ПараметрыЗаявки.БИКБанка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Банк, "Код");
	ПараметрыЗаявки.ТипПродукта = ТипПродуктаКредитПоВыписке();
	ПараметрыЗаявки.БИКБанкаСчета = РеквизитыБанка.Код;
	ПараметрыЗаявки.КоррСчет = РеквизитыБанка.КоррСчет;
	ПараметрыЗаявки.НаименованиеБанка = РеквизитыБанка.Наименование;
	ПараметрыЗаявки.СчетОрганизации = РеквизитыСчета.НомерСчета;
	ПараметрыЗаявки.СчетОрганизацииВДругомБанке = РеквизитыСчета.НомерСчета; 
	ПараметрыЗаявки.ТипЗаемщика = ТипЗаемщика(ЮридическоеФизическоеЛицо);
	ПараметрыЗаявки.ИНН = ДанныеОрганизации.ИННЮЛ;
	ПараметрыЗаявки.КПП = ДанныеОрганизации.КППЮЛ;
	ПараметрыЗаявки.ИННПолучателя = ДанныеОрганизации.ИННЮЛ;
	ПараметрыЗаявки.КПППолучателя = ДанныеОрганизации.КППЮЛ;
	ПараметрыЗаявки.ОГРН = ДанныеОрганизации.ОГРН;
	ПараметрыЗаявки.ТелефонКонтактногоЛица = ДанныеОрганизации.ТелОрганизации; 
	ПараметрыЗаявки.Наименование = ДанныеОрганизации.НаимЮЛПол;
	ПараметрыЗаявки.ТипПеревода = ТипПеревода(Параметры.ИННБанка, РеквизитыСчета.Банк);
	
	Возврат  ПараметрыЗаявки;

КонецФункции

// Возвращает сведения о текущем состоянии заявки на кредит из регистра сведений.
//   Если запись в регистре отсутствует, возвращает структуру со значениями по умолчанию.
//
// Параметры:
//   Ссылка - ДокументСсылка.ЗаявкаНаКредитПоВыписке - ссылка на заявку на кредит
//
// Возвращаемое значение:
//   Структура:
//     * Состояние - ПеречислениеСсылка.СостоянияЗаявокНаКредит - текущее состояние заявки
//     * Новое - Булево - признак нового (непрочитанного) состояния
//     * ПодробностиРешения - ХранилищеЗначения - подробности решения по заявке
//     * СуммаЗаявки - Число - сумма заявки на кредит
//
Функция СведенияОСостоянииЗаявки(Ссылка) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Состояние", Перечисления.СостоянияЗаявокНаКредит.Черновик);
	Результат.Вставить("Новое", Ложь);
	Результат.Вставить("ПодробностиРешения", Неопределено);
	Результат.Вставить("СуммаЗаявки", 0);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СостояниеЗаявокНаКредит.Состояние КАК Состояние,
		|	СостояниеЗаявокНаКредит.ПодробностиРешения КАК ПодробностиРешения,
		|	СостояниеЗаявокНаКредит.Новое КАК Новое,
		|	СостояниеЗаявокНаКредит.СуммаЗаявки КАК СуммаЗаявки
		|ИЗ
		|	РегистрСведений.СостояниеЗаявокНаКредит КАК СостояниеЗаявокНаКредит
		|ГДЕ
		|	СостояниеЗаявокНаКредит.ЗаявкаНаКредит = &ЗаявкаНаКредит";
	
	Запрос.УстановитьПараметр("ЗаявкаНаКредит", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, ВыборкаДетальныеЗаписи);
	КонецЕсли;;
	
	Возврат Результат;
	
КонецФункции

// Возвращает массив банков по ИНН
//
// Параметры:
//  ИННБанка - Строка - ИНН банка
//
// Возвращаемое значение:
//  Массив - массив банков
//
Функция БанкиПоИНН(ИННБанка) Экспорт
	
	Результат = Новый Массив;
	
	Если Не ЗначениеЗаполнено(ИННБанка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Банки.Ссылка КАК Банк
	|ИЗ
	|	Справочник.Банки КАК Банки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторБанков КАК КлассификаторБанков
	|		ПО Банки.Код = КлассификаторБанков.Код
	|			И Банки.КоррСчет = КлассификаторБанков.КоррСчет
	|			И (НЕ КлассификаторБанков.ДеятельностьПрекращена)
	|ГДЕ
	|	КлассификаторБанков.ИНН = &ИННБанка";
	
	Запрос.УстановитьПараметр("ИННБанка", ИННБанка);
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Банк");
	
КонецФункции

// Преобразует имя формы в имя формы по умолчанию
//
// Параметры:
//  ИмяФормы - Строка - имя формы, которое нужно преобразовать
//
// Возвращаемое значение:
//  Строка - имя формы по умолчанию
//
Процедура ПреобразоватьИмяФормы(ИмяФормы) Экспорт
	
	НаименованиеФормы = СтрЗаменить(ИмяФормы, "РегистрСведений.СостояниеЗаявокНаКредит.Форма.", "");
	НаименованиеФормы = СтрЗаменить(НаименованиеФормы, ".Форма.ФормаСписка", "");  
	НаименованиеФормы = СтрЗаменить(НаименованиеФормы, ".Форма.ФормаДокумента", "");
	НаименованиеФормы = СтрЗаменить(НаименованиеФормы, "ЖурналДокументов.Деньги.Форма.", "");
	НаименованиеФормы = СтрЗаменить(НаименованиеФормы, ".Форма", "");
	
	ИмяФормы = НаименованиеФормы;
	
КонецПроцедуры

// Возвращает структуру данных для статистики
//
// Возвращаемое значение:
//  Структура
//
Функция НовыйСтруктураДанныхСтатистики() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИмяКонфигурации", ЗаявкиНаКредитПоВыпискеПереопределяемый.ИмяКонфигурации());
	Результат.Вставить("ИмяФормы", "");
	Результат.Вставить("Банк", ""); 
	Результат.Вставить("Организация", "");
	Результат.Вставить("Создание", 0);
	Результат.Вставить("Отправлено", 0);
	Результат.Вставить("Отказано", 0);
	Результат.Вставить("Одобрено", 0);
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру данных заявки на кредит.
//
// Возвращаемое значение:
//   Структура - структура данных заявки на кредит.
//    
Функция НовыйСтруктураЗаявки() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("БИКБанка", "");
	Результат.Вставить("ИдентификаторЗаявки", "");
	Результат.Вставить("Статус", "");
	Результат.Вставить("ПояснениеКСтатусу", "");
	Результат.Вставить("КодПродукта", "");
	Результат.Вставить("ТипПродуктаЗаявки", "");  
	Результат.Вставить("СсылкаНаЗаявку", "");
	Результат.Вставить("ИНН", "");
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("Лимит", 0);   
	Результат.Вставить("СуммаЗаявки", "");
