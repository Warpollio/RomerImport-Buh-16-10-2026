Функция РезультатВыполненияЗапроса(ВидЗапроса, МетодЗапроса, СтрокаТела = "", ОбязательныеПараметры = Неопределено) Экспорт
	
	// Формируем параметры запроса.
	ПараметрыЗапроса = ПараметрыВыполнитьЗапросКСерверу(ВидЗапроса);
	ПараметрыЗапроса.Заголовки.Вставить("x-api-key", КлючДоступа());
	ПараметрыЗапроса.Заголовки.Вставить("Content-Type", "application/json");
	ПараметрыЗапроса.МетодЗапроса = МетодЗапроса; 
	ПараметрыЗапроса.СтрокаТела = СтрокаТела; 
	Если ЗначениеЗаполнено(ОбязательныеПараметры) Тогда
		ПараметрыЗапроса.ОбязательныеПараметры = ОбязательныеПараметры;
	КонецЕсли;
	ПараметрыПодключения = ПараметрыСервераКредитПоВыписке();

	// Запрос к серверу.
	Возврат ЗаявкиНаКредитПоВыпискеПереопределяемый.ВыполнитьЗапросКСерверу(ПараметрыЗапроса, ПараметрыПодключения);
	
КонецФункции

Процедура ЗаполнитьДанныеПредложений(ДанныеПредложений, ДанныеОтветаСервера) 
	
	СтруктураОтветаСервера = ОбщегоНазначения.JSONВЗначение(ДанныеОтветаСервера, , Ложь);
	Если ТипЗнч(СтруктураОтветаСервера) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	СтруктураИменПолейОтветаБанка = СтруктураИменПолейОтветаБанка();
	МассивПредложений = СтруктураОтветаСервера[СтруктураИменПолейОтветаБанка.ПредложенияБанков];
	
	Для Каждого Предложение Из МассивПредложений Цикл
		
		СтруктураПредложений = НовыйСтруктураПредложений(); 
		Для Каждого ЭлементСтруктуры Из СтруктураПредложений Цикл
			ИмяРеквизита = "";
			Если СтруктураИменПолейОтветаБанка.Свойство(ЭлементСтруктуры.Ключ, ИмяРеквизита) Тогда
				ЗначениеРеквизита = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Предложение, ИмяРеквизита, "");
				СтруктураПредложений[ЭлементСтруктуры.Ключ] = ЗначениеРеквизита;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СтруктураПредложений.БИКБанка) Тогда
			ДанныеПредложений.МассивБанков.Добавить(СтруктураПредложений);
		КонецЕсли;
		
	КонецЦикла;
	
	СоздатьЗаполнитьБанкиПоДаннымПредложений(ДанныеПредложений.МассивБанков);

КонецПроцедуры

Процедура СоздатьЗаполнитьБанкиПоДаннымПредложений(МассивБанковПредложений)
	
	Для Каждого БанкПредложения Из МассивБанковПредложений Цикл
		БанкВКлассификаторе = РаботаСБанкамиБП.СсылкаПоКлассификатору(БанкПредложения.БИКБанка);
		МассивБанки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(БанкВКлассификаторе);
		РаботаСБанкамиБП.ПодобратьБанкИзКлассификатора(МассивБанки);
		БанкПредложения.Банк = Справочники.Банки.СсылкаНаБанк(БанкПредложения.БИКБанка);
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрыВыполнитьЗапросКСерверу(АдресРесурса) Экспорт
		
	Результат = Новый Структура;
	// Токен авторизации.
	Результат.Вставить("Токен", Неопределено);
	// Адрес ресурса для объекта HTTPЗапрос.
	Результат.Вставить("АдресРесурса", АдресРесурса);
	// Суффикс ресурса.
	Результат.Вставить("СуффиксРесурса", "");
	// Обязательные параметры запроса.
	Результат.Вставить("ОбязательныеПараметры", Новый Массив);
	// Необязательные параметры запроса, передаются в URL.
	Результат.Вставить("Параметры", Новый Соответствие);
	// Заголовки запроса.
	Результат.Вставить("Заголовки", Новый Соответствие);
	// Метод выполнения запроса.
	Результат.Вставить("МетодЗапроса", "GET");
	// Имя файла тела запроса.
	Результат.Вставить("ИмяФайлаТела", Неопределено);
	// Двоичные данные тела запроса.
	Результат.Вставить("ДвоичныхДанныеТела", Неопределено);
	// Строка тела запроса.
	Результат.Вставить("СтрокаТела", "");
	// номер страницы для страничных запросов.
	Результат.Вставить("РазбивкаРезультатаНаСтраницы", Ложь);
	// номер страницы для страничных запросов.
	Результат.Вставить("НомерСтраницы", 0);
	// Количество элементов на странице для страничных запросов.
	Результат.Вставить("ЭлементовНаСтранице", 1024);
	// Типы данных.
	Результат.Вставить("ТипПринимаемыхДанных", "");
	Результат.Вставить("ТипОтправляемыхДанных", "");
	// Таймаут для запроса.
	Результат.Вставить("Таймаут", Неопределено);
	Возврат Результат;
	
КонецФункции

