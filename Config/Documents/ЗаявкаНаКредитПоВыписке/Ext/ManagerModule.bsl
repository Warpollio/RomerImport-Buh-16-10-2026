Функция ПроверитьЗаполнение(Форма) Экспорт

	Отказ = Ложь;
	
	Объект               = Форма.Объект;
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Организация,
			"Ссылка, ЮридическоеФизическоеЛицо, ОбособленноеПодразделение, ОГРН, ИНН, КПП");

	// Организация
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСтр("ru = 'Организация'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "Объект.Организация", , Отказ);
		
		// Остальные поля не проверяем, пока не заполнят организацию.
		Возврат Ложь;
	КонецЕсли;
	
	ПроверитьЗаполнениеДанныхОрганизации(Форма, РеквизитыОрганизации, Отказ);
	
	Если Не ЗначениеЗаполнено(Объект.СчетОрганизации) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСтр("ru = 'Счет для зачисления'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "Объект.СчетОрганизации", , Отказ);
	КонецЕсли;
	
	Возврат НЕ Отказ;

КонецФункции

Функция НомерТелефонаТолькоЦифры(ПредставлениеТелефона)
	
	ТелефонТолькоЦифры = СтроковыеФункцииКлиентСервер.ЗаменитьОдниСимволыДругими(" +()-", СокрЛП(ПредставлениеТелефона), "");
	
	Если Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ТелефонТолькоЦифры) Или СтрДлина(ТелефонТолькоЦифры) <> 11 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат ТелефонТолькоЦифры;
	
КонецФункции

Процедура ПроверитьЗаполнениеДанныхОрганизации(Форма, РеквизитыОрганизации, Отказ)
	
	Объект = Форма.Объект;
	КлючДанных   = РеквизитыОрганизации.Ссылка;
		
	ПроверяемыеВидыКонтактнойИнформации = Новый Массив;
	ПроверяемыеВидыКонтактнойИнформации.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
			
	КонтактнаяИнформация = УправлениеКонтактнойИнформациейБП.КонтактнаяИнформацияОбъектовНаДату(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(РеквизитыОрганизации.Ссылка),
		,
		ПроверяемыеВидыКонтактнойИнформации,
		Объект.Дата);

	ЭтоЮрЛицо = РеквизитыОрганизации.ЮридическоеФизическоеЛицо <> Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо;

	// ИНН
	Если ЗначениеЗаполнено(РеквизитыОрганизации.ИНН) Тогда
		РезультатПроверки = ИдентификационныеНомераНалогоплательщиков.ПроверитьСоответствиеТребованиямИНН(
			РеквизитыОрганизации.ИНН, ЭтоЮрЛицо);

		Если НЕ РезультатПроверки.СоответствуетТребованиям Тогда
			ОбщегоНазначения.СообщитьПользователю(
				РезультатПроверки.ОписаниеОшибки,
				КлючДанных,
				"ИНН",
				,
				Отказ);
		КонецЕсли;
	Иначе
		ТекстСообщения =  ТекстОшибкиЗаполненияРеквизита(НСтр("ru = 'ИНН'"));
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения, КлючДанных, "ИНН", , Отказ);
	КонецЕсли;
	
	// КПП 
	Если ЭтоЮрЛицо Тогда
		Если ЗначениеЗаполнено(РеквизитыОрганизации.КПП) Тогда
			РезультатПроверки = ИдентификационныеНомераНалогоплательщиков.ПроверитьСоответствиеТребованиямКПП(
				РеквизитыОрганизации.КПП,
				Истина,
				РеквизитыОрганизации.ОбособленноеПодразделение,
				Ложь);

			Если НЕ РезультатПроверки.СоответствуетТребованиям Тогда
				ОбщегоНазначения.СообщитьПользователю(
					РезультатПроверки.ОписаниеОшибки,
					КлючДанных,
					"КПП",
					,
					Отказ);
			КонецЕсли;
		Иначе
			ТекстСообщения =  ТекстОшибкиЗаполненияРеквизита(НСтр("ru = 'КПП'"));
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения, КлючДанных, "КПП", , Отказ);
		КонецЕсли;
	КонецЕсли;

	// ОГРН
	Если ЗначениеЗаполнено(РеквизитыОрганизации.ОГРН) Тогда
		ТекстСообщения = "";
		Успешно = РегламентированныеДанныеКлиентСервер.ОГРНСоответствуетТребованиям(
			РеквизитыОрганизации.ОГРН, ЭтоЮрЛицо, ТекстСообщения);

		Если НЕ Успешно Тогда
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения, КлючДанных, "ОГРН", , Отказ);
		КонецЕсли;
	Иначе
		Если НЕ ЭтоЮрЛицо Тогда
			ТекстСообщения =  ТекстОшибкиЗаполненияРеквизита(НСтр("ru = 'ОГРНИП'"));
		Иначе
			ТекстСообщения = ТекстОшибкиЗаполненияРеквизита(НСтр("ru = 'ОГРН'"));
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения, КлючДанных, "ОГРН", , Отказ);
	КонецЕсли;
	
	// Телефон
	Телефон = "";
	НайденнаяСтрока = КонтактнаяИнформация.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации, "Вид");
	Если НайденнаяСтрока <> Неопределено Тогда
		Телефон = НайденнаяСтрока.Представление;  
		НомерТелефонаТолькоЦифры = НомерТелефонаТолькоЦифры(Телефон);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Телефон) Тогда
		ТекстСообщения = ТекстОшибкиЗаполненияРеквизита(НСтр("ru = 'Телефон'"));
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения, КлючДанных, "КонтактнаяИнформацияПолеТелефонОрганизации", , Отказ);
	Иначе
		Если СтрДлина(НомерТелефонаТолькоЦифры) <> 11 Тогда
			ТекстСообщения = НСтр("ru = 'Количество цифр номера телефона организации должно быть равно 11'");
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения, КлючДанных, "КонтактнаяИнформацияПолеТелефонОрганизации", , Отказ);
		КонецЕсли;
	КонецЕсли; 
	
	// Сумма
	Если Объект.СуммаДокумента = 0 Тогда
		Если Форма.ТаблицаБанковскихДокументов.Количество() > 0 Тогда
			ТекстСообщения = НСтр("ru = 'Не выбраны платежи из списка'");
		Иначе
			ТекстСообщения = НСтр("ru = 'По организации за последнее время нет оплат поставщикам, которые можно было бы включить в заявку'");
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, "ТаблицаБанковскихДокументов", , Отказ);
   	КонецЕсли;

КонецПроцедуры

Функция ТекстОшибкиЗаполненияРеквизита(ИмяРеквизита)
	
	Шаблон = НСтр("ru = 'Не заполнен реквизит ""%1"" справочника ""Организации""'");
	
	Возврат СтрШаблон(Шаблон, ИмяРеквизита);
	
КонецФункции

#КонецОбласти

#КонецЕсли