// Отправляет заявку на кредит по выписке в банк и сохраняет результаты обработки.
//
// Параметры:
//   Параметры - Структура - параметры отправки заявки:
//     * ПараметрыЗаявки - Структура - структура данных заявки, подготовленная для отправки
//     * Организация - см. Документ.ЗаявкаНаКредитПоВыписке.Организация
//     * Банк - см. Документ.ЗаявкаНаКредитПоВыписке.Банк
//     * Лимит - Число - сумма лимита по заявке
//     * СуммаЗаявки - Число - запрашиваемая сумма кредита
//     * ЗаявкаНаКредитПоВыписке - см. Документ.ЗаявкаНаКредитПоВыписке
//
// Возвращаемое значение:
//   Структура - результат отправки заявки:
//     * Выполнено - Булево - признак успешной отправки заявки
//     * ОписаниеОшибки - Строка - текст ошибки отправки, пустая строка при успешной отправке
//     * СсылкаНаЗаявку - Строка - ссылка на заявку, полученная от банка
//
Функция ОтправитьЗаявку(Параметры) Экспорт
		
	ПараметрыЗаявки = ДанныеДляОтправки(Параметры);

	Результат = Новый Структура;
	Результат.Вставить("Выполнено",      Ложь);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("СсылкаНаЗаявку", "");
	
	ДлительныеОперации.СообщитьПрогресс(50,
		НСтр("ru = 'Отправка заявки...'"));

	ПреобразоватьСтруктуруЗапроса(ПараметрыЗаявки);
	СтрокаТелаЗапроса = ОбщегоНазначения.ЗначениеВJSON(ПараметрыЗаявки);
	РезультатВыполненияЗапроса = РезультатВыполненияЗапроса("applications", "POST", СтрокаТелаЗапроса);
	Если НЕ РезультатВыполненияЗапроса.Выполнено Тогда
		
		// Открывающая фигурная скобка служит маркером для переноса информации в раздел Подробнее
		Результат.Выполнено = Ложь;
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Заявка не отправлена. Попробуйте повторить отправку позднее. {%1'"),
			РезультатВыполненияЗапроса.ОписаниеОшибки);
		Результат.ОписаниеОшибки = ОписаниеОшибки;
		Возврат Результат;

	КонецЕсли;
	
	ДлительныеОперации.СообщитьПрогресс(75,
		НСтр("ru = 'Ожидание ответа от банка...'"));

	ДанныеЗаявки = НовыйСтруктураЗаявки();
	ЗаполнитьДанныеЗаявки(ДанныеЗаявки, РезультатВыполненияЗапроса.ТелоОтвета);
	
	ДлительныеОперации.СообщитьПрогресс(99,
		НСтр("ru = 'Перенаправление на страницу банка...'"));
		
	ЗаполнитьЗначенияСвойств(ДанныеЗаявки, Параметры, "Организация, Банк, Лимит, СуммаЗаявки, ЗаявкаНаКредитПоВыписке");
	РегистрыСведений.СостояниеЗаявокНаКредит.ОбновитьИнформациюЗаявкиНаКредитПоВыписке(ДанныеЗаявки);

	Результат.Выполнено = Истина;
	Результат.СсылкаНаЗаявку = ДанныеЗаявки.СсылкаНаЗаявку;
	
	ОтправитьСтатистикуПоЗаявке(Параметры, 1);

	ЗаявкиНаКредитПоВыписке.ОпределитьНеобходимостьРегЗаданияПолученияСтатусов(Истина);

	Возврат Результат;
	
КонецФункции

