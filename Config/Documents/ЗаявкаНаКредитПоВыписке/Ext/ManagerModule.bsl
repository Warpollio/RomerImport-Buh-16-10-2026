Процедура ОтправитьСтатистикуПоЗаявке(Параметры, Отправлено = 0, Отказано = 0, Одобрено = 0) Экспорт
	
	Если ОбщегоНазначения.РежимОтладки() 
		Или БлокировкаРаботыСВнешнимиРесурсами.РаботаСВнешнимиРесурсамиЗаблокирована() Тогда
		Возврат;
	КонецЕсли;
	
	ПреобразоватьИмяФормы(Параметры.ФормаИсточник);
	ДанныеСтатистики = НовыйСтруктураДанныхСтатистики();
	ДанныеСтатистики.ИмяФормы = Параметры.ФормаИсточник; 
	ДанныеСтатистики.Банк = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Банк, "Наименование"); 
	ДанныеСтатистики.Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Организация, "ИНН");
	ДанныеСтатистики.Отправлено = Отправлено;
	ДанныеСтатистики.Отказано = Отказано;
	ДанныеСтатистики.Одобрено = Одобрено;
	
	СтруктураДанныхСтатистики = Новый Структура;
	СтруктураДанныхСтатистики.Вставить("СтатистикаКредитПоВыписке", 
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДанныеСтатистики));

	СервисОбменаСБанками = Перечисления.СервисыОбменаСБанками.ЗаявкиНаКредитПоВыписке;
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("СервисОбменаСБанками", СервисОбменаСБанками);
	ПараметрыПроцедуры.Вставить("СодержимоеСтатистики", СтруктураДанныхСтатистики);
	ПараметрыПроцедуры.Вставить("ТокенАвторизации", "");

	ЗаявкиНаКредитПоВыпискеПереопределяемый.ОтправитьСтатистикуВСервис(ПараметрыПроцедуры, "");
	
КонецПроцедуры

#КонецОбласти

