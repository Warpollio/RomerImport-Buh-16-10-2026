
#Область СлужебныйПрограммныйИнтерфейс

Процедура ПриСозданииНаСервере(Форма) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьРаспознаваниеДокументов") Тогда
		Возврат;
	КонецЕсли;
		
	Если Не НадоПодключатьРаспознавание(Форма) Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьКомандуРаспознаваниеДокументов(Форма);
	
	Если Форма.Параметры.Свойство("ЗаданияРаспознаванияДокументов") Тогда
		
		ПодключитьРаспознаваниеДокументов(Форма);
		
		Для Каждого Файл Из Форма.Параметры.ЗаданияРаспознаванияДокументов Цикл
			
			НоваяСтрока = Форма.ЗаданияРаспознаванияДокументов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Файл);
			// Переложить адрес хранилища от старой формы в хранилище новой формы
			// (привязано к форме, чтобы очистилось при её закрытии):
			Если Не ЗначениеЗаполнено(Файл.АдресВременногоХранилищаФайла) Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеФайлаИзХранилища = ПолучитьИзВременногоХранилища(Файл.АдресВременногоХранилищаФайла);
			Если ДанныеФайлаИзХранилища = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока.АдресВременногоХранилищаФайла = 
				ПоместитьВоВременноеХранилище(ДанныеФайлаИзХранилища, Форма.УникальныйИдентификатор);
		КонецЦикла;
		
		ОтрисоватьФайлыНаФорме(Форма);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодключитьРаспознаваниеДокументов(Форма) Экспорт
	
	СоздатьРеквизитыРаспознаванияДокументов(Форма);
	СоздатьКомандыРаспознаванияДокументов(Форма);
	СоздатьЭлементыФормыРаспознаванияДокументов(Форма);
	
	РаспознаваниеДокументовСлужебный.ПодключитьГруппуБалансаКФорме(
		Форма,
		Форма.Элементы.ГруппаБиллингБРД);
	
	НастроитьЭлементы(Форма);
	
КонецПроцедуры

Процедура ОтрисоватьФайлыНаФорме(Форма) Экспорт
	
	Для Каждого Файл Из Форма.ЗаданияРаспознаванияДокументов Цикл
		
		Если Файл.ЕстьНаФорме Тогда
			Продолжить;
		КонецЕсли;
		
		ИндексСтроки = Форма.ЗаданияРаспознаванияДокументов.Индекс(Файл);
		
		РаспознаваниеДокументовКомплекты.СкопироватьЭлементыФормыРекурсивно(
			Форма,
			Форма.Элементы.ГруппаИдетРаспознавание,
			Форма.Элементы.ГруппаРаспознанныеФайлыСписок,
			ИндексСтроки
		);
		
		Форма.Элементы["ДекорацияФайлИмяФайла_" + ИндексСтроки].Заголовок = Файл.ИмяФайла;
		Форма.Элементы["ГруппаИдетРаспознавание_" + ИндексСтроки].Видимость = Истина;
		
		Файл.ЕстьНаФорме = Истина;
		
	КонецЦикла;
	
	КоличествоФайлов = Форма.ЗаданияРаспознаванияДокументов.Количество();
	СтрокиЗавершенных = Форма.ЗаданияРаспознаванияДокументов.НайтиСтроки(Новый Структура("ЗагруженоПолностью", Истина));
	КоличествоРаспознанных = СтрокиЗавершенных.Количество();
	
	Форма.Элементы.ДекорацияИдетЗагрузкаГруппаФайлы.Видимость = Ложь;
	Форма.Элементы.КнопкаВсплывающаяРаспознанныеФайлы.Видимость = Истина;
	Форма.Элементы.КнопкаВсплывающаяРаспознанныеФайлы.Заголовок = СтрШаблон(
		НСтр("ru = 'Распознано: %1 / %2'"),
		КоличествоРаспознанных,
		КоличествоФайлов);
		
КонецПроцедуры

Процедура РаспознаваниеДокументовВызовСервера(Форма, ИмяПроцедуры, Параметры) Экспорт
	
	Если ИмяПроцедуры = "ОтрисоватьФайлыНаФорме" Тогда
		ОтрисоватьФайлыНаФорме(Форма);
	ИначеЕсли ИмяПроцедуры = "ПодключитьРаспознаваниеДокументов" Тогда
		ПодключитьРаспознаваниеДокументов(Форма);
	ИначеЕсли ИмяПроцедуры = "ИзменитьВидимостьПодсказок" Тогда
		УправлениеПанельюПодсказки.ИзменитьВидимостьПодсказок(Форма);
	Иначе
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Неизвестная команда распознавания документов: %1'"),
			ИмяПроцедуры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписиНаСервере(Форма, ТекущийОбъект) Экспорт
	
	ЕстьРаспознанныеФайлы = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		Форма, "ЗаданияРаспознаванияДокументов") И Форма.ЗаданияРаспознаванияДокументов.Количество() > 0;
	
	Если Не ЕстьРаспознанныеФайлы Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Файл Из Форма.ЗаданияРаспознаванияДокументов Цикл
		
		Если Файл.Прикреплен Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураИмениФайла = РаспознаваниеДокументовСлужебный.РазложитьИмяФайла(Файл.ИмяФайла);
		Если СтруктураИмениФайла = Неопределено
			Или Не СтруктураИмениФайла.Свойство("Имя")
			Или Не СтруктураИмениФайла.Свойство("Расширение") Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыФайла = Новый Структура;
		ПараметрыФайла.Вставить("ВладелецФайлов",     ТекущийОбъект.Ссылка);
		ПараметрыФайла.Вставить("Автор",              Неопределено);
		ПараметрыФайла.Вставить("ИмяБезРасширения",   СтруктураИмениФайла.Имя);
		ПараметрыФайла.Вставить("РасширениеБезТочки", НРег(СтруктураИмениФайла.Расширение));
		ПараметрыФайла.Вставить("ГруппаФайлов",       Неопределено);
		ПараметрыФайла.Вставить("ВремяИзменения");
		ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное");
		
		Попытка
			РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, Файл.АдресВременногоХранилищаФайла);
			Файл.Прикреплен = Истина;
		Исключение
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'РаспознаваниеДокументов.ОшибкаПрикрепленияФайла'"),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьКомандуРаспознаваниеДокументов(Форма)
	
	Если ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		Возврат;
	КонецЕсли;
	
	КомандаФормы = Форма.Команды.Добавить("ПоказатьПанельРаспознаваниеДокументов");
	КомандаФормы.Заголовок = НСтр("ru = 'Заполнить из распознанного документа'");
	КомандаФормы.Действие = "Подключаемый_РаспознаваниеДокументовВыполнитьКоманду";
	
	ЭлементыФормы = Форма.Элементы;
	
	НовыйЭлемент = ЭлементыФормы.Вставить("Распознать", Тип("КнопкаФормы"), ЭлементыФормы.ГруппаГлобальныеКоманды, ЭлементыФормы.КомандыЭДО);
	НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.Заголовок = НСтр("ru = 'Распознать из файла'");
	НовыйЭлемент.ИмяКоманды = "ПоказатьПанельРаспознаваниеДокументов";
	НовыйЭлемент.Картинка = БиблиотекаКартинок.РаспознаваниеДокументов;
	НовыйЭлемент.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
КонецПроцедуры

Функция НадоПодключатьРаспознавание(Форма)
	
	Если Не ПравоДоступа("Добавление", Метаданные.Документы.РаспознанныйДокумент)
		Или ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МетаданныеОбъекта = Форма.Объект.Ссылка.Метаданные();
	Если Не ПравоДоступа("Редактирование", МетаданныеОбъекта) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Результат = Истина;
	
	ДоступныеВидыОпераций = Новый Массив;
	ДоступныеВидыОпераций.Добавить(Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Товары);
	ДоступныеВидыОпераций.Добавить(Перечисления.ВидыОперацийПоступлениеТоваровУслуг.Услуги);
	ДоступныеВидыОпераций.Добавить(Перечисления.ВидыОперацийПоступлениеТоваровУслуг.ПокупкаКомиссия);
	ДоступныеВидыОпераций.Добавить(Перечисления.ВидыОперацийРеализацияТоваров.Товары);
	ДоступныеВидыОпераций.Добавить(Перечисления.ВидыОперацийРеализацияТоваров.Услуги);
	ДоступныеВидыОпераций.Добавить(Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия);
	ДоступныеВидыОпераций.Добавить(Перечисления.ВидыОперацийСчетаПокупателю.ТоварыИУслуги);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "ВидОперации") Тогда
		
		Если ДоступныеВидыОпераций.Найти(Форма.Объект.ВидОперации) = Неопределено Тогда
			Результат = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура НастроитьЭлементы(Форма)
	
	Элементы = Форма.Элементы;
	
	Форма.ПолеПросмотра = РаспознаваниеДокументовСлужебный.МакетОтображенияКартинкиДокументаHTML(Форма.УникальныйИдентификатор);
	
	ЗаполняемыеРеквизиты = Новый Структура;
	ЗаполняемыеРеквизиты.Вставить("НомерВходящегоДокумента");
	ЗаполняемыеРеквизиты.Вставить("ДатаВходящегоДокумента");	
	ЗаполняемыеРеквизиты.Вставить("Контрагент");
	ЗаполняемыеРеквизиты.Вставить("Организация");
	ЗаполняемыеРеквизиты.Вставить("ДоговорКонтрагента");
	ЗаполняемыеРеквизиты.Вставить("ИтогиВсего");
	ЗаполняемыеРеквизиты.Вставить("ИтогиВсегоНДС");
	
	Для Каждого ЗаполняемыйРеквизит Из ЗаполняемыеРеквизиты Цикл
		Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Элементы, ЗаполняемыйРеквизит.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		ИзменяемыйЭлемент = Элементы[ЗаполняемыйРеквизит.Ключ];
		ИзменяемыйЭлемент.УстановитьДействие("АвтоПодбор", "Подключаемый_АвтоПодборПоля");
		ИзменяемыйЭлемент.УстановитьДействие("ОбработкаВыбора", "Подключаемый_ОбработкаВыбораПоля");
	КонецЦикла;
	
	ИменаТаблицДокумента = Новый Массив;
	ИменаТаблицДокумента.Добавить("Товары");
	ИменаТаблицДокумента.Добавить("Услуги");
	
	Для Каждого ИмяТаблицы Из ИменаТаблицДокумента Цикл
		Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Элементы, ИмяТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		
		НастроитьКолонкиРекурсивно(Элементы[ИмяТаблицы]);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьРеквизитыРаспознаванияДокументов(Форма)
	
	МассивДобавляемыхРеквизитов = Новый Массив;

	НовыйРеквизит = Новый РеквизитФормы("РаспознанныйТекст",Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("ПолеПросмотра",Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("ТекущийРаспознанныйДокумент",Новый ОписаниеТипов("ДокументСсылка.РаспознанныйДокумент"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("СтрокВИзображении",Новый ОписаниеТипов("Число"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("ИмяРаспознанногоРеквизита",Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("ФайлыКОтправкеРаспознаваниеДокументов",Новый ОписаниеТипов("ТаблицаЗначений"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("Наименование",Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.Путь = "ФайлыКОтправкеРаспознаваниеДокументов";
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("ИндексКартинки",Новый ОписаниеТипов("Число"));
	НовыйРеквизит.Путь = "ФайлыКОтправкеРаспознаваниеДокументов";
	НовыйРеквизит.Заголовок = НСтр("ru = 'Индекс картинки'");
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("СостоянияПоБалансу", Новый ОписаниеТипов(""));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("ОжиданиеРаспознавания", Новый ОписаниеТипов("Булево"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("Адрес",Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.Путь = "ФайлыКОтправкеРаспознаваниеДокументов";
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("ИдентификаторВнутренний",Новый ОписаниеТипов(""));
	НовыйРеквизит.Путь = "ФайлыКОтправкеРаспознаваниеДокументов";
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("Расширение",Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.Путь = "ФайлыКОтправкеРаспознаваниеДокументов";
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("ЗаданияРаспознаванияДокументов",Новый ОписаниеТипов("ТаблицаЗначений"));
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);

	НовыйРеквизит = Новый РеквизитФормы("ИдентификаторЗадания",Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.Путь = "ЗаданияРаспознаванияДокументов";
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("ИмяФайла",Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.Путь = "ЗаданияРаспознаванияДокументов";
	НовыйРеквизит.СохраняемыеДанные = Ложь;
	МассивДобавляемыхРеквизитов.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("АдресВременногоХранилищаФайла",Новый ОписаниеТипов("Строка"));
	НовыйРеквизит.Путь = "ЗаданияРаспознаванияДокументов";
