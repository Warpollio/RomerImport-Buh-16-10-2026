		ВызватьИсключение НСтр("ru = 'Размеры массивов данных не совпадают при пакетной обработке'");
	КонецЕсли;
	
	Для Индекс = 0 По КоличествоСтрок - 1 Цикл
		УслугиНоменклатураПриИзмененииНаСервере(МассивДанныхСтрок[Индекс], МассивДанныхОбъекта[Индекс], МассивСчетовУчета[Индекс], ТипДокумента);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьСобытиеЖурналаРегистрации(Событие, Комментарий) Экспорт
	
	ЗаписьЖурналаРегистрации(
		Событие,
		УровеньЖурналаРегистрации.Информация, , ,
		Комментарий
	);
	
КонецПроцедуры

Функция ИспользуетсяНесколькоОрганизаций() Экспорт
	
	Возврат Справочники.Организации.ИспользуетсяНесколькоОрганизаций();
	
КонецФункции

