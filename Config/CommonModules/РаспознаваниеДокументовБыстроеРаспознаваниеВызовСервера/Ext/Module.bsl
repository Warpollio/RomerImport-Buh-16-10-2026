#Область СлужебныеПроцедурыИФункции

Функция ЗапуститьФоновуюОтправкуФайлов(Знач ФайлыКОтправке, УникальныйИдентификатор) Экспорт
	
	ОтправляемыеФайлы = Новый Массив;
	Для Каждого ДанныеФайла Из ФайлыКОтправке Цикл
		
		ОписаниеФайла = Новый Структура;
		ОписаниеФайла.Вставить("ИмяФайла", ДанныеФайла.Наименование);
		ОписаниеФайла.Вставить("ДатаИзменения");
		ОписаниеФайла.Вставить("Каталог");
		ОписаниеФайла.Вставить("ИдентификаторВнутренний", ДанныеФайла.ИдентификаторВнутренний);
		ОписаниеФайла.Вставить("ДвоичныеДанные", ПолучитьИзВременногоХранилища(ДанныеФайла.Адрес));
		ОписаниеФайла.Вставить("Адрес", ДанныеФайла.Адрес);
		
		ОтправляемыеФайлы.Добавить(ОписаниеФайла);
	КонецЦикла;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Отправка файлов в сервис распознавания документов'");
	
	ФоновоеЗадание = ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"Обработки.РаспознаваниеДокументов.ОтправитьФайлыНаБыстроеРаспознавание",
		ОтправляемыеФайлы);
	
	Возврат ФоновоеЗадание;
	
КонецФункции

Функция ЗапуститьПараллельнуюЗагрузку(ИдентификаторыЗаданий, УникальныйИдентификатор) Экспорт
	
	НомерСеанса = ПолучитьТекущийСеансИнформационнойБазы().НомерСеанса;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Параллельная загрузка распознанных документов'");
	
	ФоновоеЗадание = ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"РаспознаваниеДокументов.ЗагрузитьРаспознанныеДокументыПараллельно",
		ИдентификаторыЗаданий,
		НомерСеанса);
	
	Возврат ФоновоеЗадание;
	
КонецФункции

Функция ЗначениеРеквизитаРаспознанногоДокумента(ДокументСсылка, ИмяРеквизита) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РаспознанныйДокументРеквизитыДокумента.Значение КАК Значение
		|ИЗ
		|	Документ.РаспознанныйДокумент.РеквизитыДокумента КАК РаспознанныйДокументРеквизитыДокумента
		|ГДЕ
		|	РаспознанныйДокументРеквизитыДокумента.Ссылка = &Ссылка
		|	И РаспознанныйДокументРеквизитыДокумента.ИмяРеквизита = &ИмяРеквизита";
		
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяРеквизита", ИмяРеквизита);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СвойстваЯчеекТаблицы(ДанныеРеквизита) Экспорт
	
	РеквизитыРаспознанногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		ДанныеРеквизита.Документ,
		"Ссылка, РеквизитыТабличныхЧастей");
	
	РеквизитыРаспознанногоДокумента.РеквизитыТабличныхЧастей = 
		РеквизитыРаспознанногоДокумента.РеквизитыТабличныхЧастей.Выгрузить();
	
	СвойстваЯчеекТаблицы = РаспознаваниеДокументовСлужебный.СвойстваЯчеекТаблицы(РеквизитыРаспознанногоДокумента);
	
	Возврат СвойстваЯчеекТаблицы;
	
КонецФункции

Процедура ТоварыНоменклатураПриИзмененииНаСервере(СтрокаТабличнойЧасти, Знач ДанныеОбъекта, Знач СчетаУчетаКЗаполнению, ТипДокумента) Экспорт
	
	Если ТипДокумента = "ПоступлениеТоваровУслуг" Тогда
		ПоступлениеТоваровУслугФормы.ТоварыНоменклатураПриИзменении(СтрокаТабличнойЧасти, ДанныеОбъекта, СчетаУчетаКЗаполнению);
	ИначеЕсли ТипДокумента = "РеализацияТоваровУслуг" Тогда
		РеализацияТоваровУслугФормы.ТоварыНоменклатураПриИзмененииНаСервере(СтрокаТабличнойЧасти, ДанныеОбъекта, СчетаУчетаКЗаполнению);
	Иначе
		ВызватьИсключение НСтр("ru = 'Неизвестный тип документа'");
	КонецЕсли;
	
		
КонецПроцедуры

Процедура УслугиНоменклатураПриИзмененииНаСервере(СтрокаТабличнойЧасти, Знач ДанныеОбъекта, Знач СчетаУчетаКЗаполнению, ТипДокумента) Экспорт
	
	Если ТипДокумента = "ПоступлениеТоваровУслуг" Тогда
		ПоступлениеТоваровУслугФормы.УслугиНоменклатураПриИзменении(СтрокаТабличнойЧасти, ДанныеОбъекта, СчетаУчетаКЗаполнению);
	ИначеЕсли ТипДокумента = "РеализацияТоваровУслуг" Тогда
		РеализацияТоваровУслугФормы.УслугиНоменклатураПриИзмененииНаСервере(СтрокаТабличнойЧасти, ДанныеОбъекта, СчетаУчетаКЗаполнению);
	Иначе
		ВызватьИсключение НСтр("ru = 'Неизвестный тип документа'");
	КонецЕсли;
	
КонецПроцедуры

Процедура ТоварыНоменклатураПриИзмененииНаСервереПакетно(МассивДанныхСтрок, МассивДанныхОбъекта, МассивСчетовУчета, ТипДокумента) Экспорт
	
	КоличествоСтрок = МассивДанныхСтрок.Количество();
	Если КоличествоСтрок = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если КоличествоСтрок <> МассивДанныхОбъекта.Количество()
		Или КоличествоСтрок <> МассивСчетовУчета.Количество() Тогда
		ВызватьИсключение НСтр("ru = 'Размеры массивов данных не совпадают при пакетной обработке'");
	КонецЕсли;
	
	Для Индекс = 0 По КоличествоСтрок - 1 Цикл
		ТоварыНоменклатураПриИзмененииНаСервере(МассивДанныхСтрок[Индекс], МассивДанныхОбъекта[Индекс], МассивСчетовУчета[Индекс], ТипДокумента);
	КонецЦикла;
	
КонецПроцедуры

