Процедура ПРО_РегистрСведений_ДвоичныеДанныеФайлов_ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства)
	ИспользоватьКэш  = Ложь;
	СсылкаНаФайл = Объект.Файл;
	
	Если ЗначениеЗаполнено(СсылкаНаФайл)
		И ОбщегоНазначения.СсылкаСуществует(СсылкаНаФайл) Тогда
		
		МетаданныеСсылки = СсылкаНаФайл.Метаданные();
		ПланОбменаСодержитОбъект = Метаданные.ПланыОбмена.ПоОрганизации.Состав.Найти(МетаданныеСсылки) <> Неопределено;
		
		Если ПланОбменаСодержитОбъект Тогда
			
			Получатели = ОпределитьПолучателей(СсылкаНаФайл.ПолучитьОбъект(), "ПоОрганизации");
			ПараметрыЗапроса.Вставить("Получатели", ?(ЗначениеЗаполнено(Получатели),Получатели, Новый Массив));
			ТекстЗапроса = "
			|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
			|ИЗ
			|	ПланОбмена.ПоОрганизации КАК ПланОбменаОсновнаяТаблица
			|ГДЕ
			| ПланОбменаОсновнаяТаблица.Ссылка В (&СвойствоОбъекта_Получатели)";	
			
		Иначе
			
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры
