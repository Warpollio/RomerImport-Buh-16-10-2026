#Область Справочник_ВидыДеятельностиЕНВД
Процедура ДобавитьПРО_Справочник_ВидыДеятельностиЕНВД(ПравилаРегистрацииОбъектов, ИмяМенеджераРегистрации)
	НовоеПравило = ПравилаРегистрацииОбъектов.Добавить();
	
	НовоеПравило.ИмяМенеджераРегистрации = ИмяМенеджераРегистрации; 
	НовоеПравило.Идентификатор = "Справочник_ВидыДеятельностиЕНВД";
	
	НовоеПравило.ОбъектМетаданныхИмя = "Справочник.ВидыДеятельностиЕНВД";
	НовоеПравило.ИмяПланаОбмена = "ПоОрганизации";
	НовоеПравило.ИмяРеквизитаФлага = "";	
	НовоеПравило.ПравилоПоСвойствамОбъектаПустое = Ложь; 
	НовоеПравило.ПакетноеВыполнениеОбработчиков = Ложь;
	НовоеПравило.ЕстьОбработчикПередОбработкой = Ложь;
	НовоеПравило.ЕстьОбработчикПриОбработке = Истина;
	НовоеПравило.ЕстьОбработчикПриОбработкеДополнительный = Истина;
	НовоеПравило.ЕстьОбработчикПослеОбработки = Истина;
		
	УстановитьОтборы(НовоеПравило, 
		ПустойОтборПоСвойствамПланаОбмена(),
		ПустойОтборПоСвойствамОбъекта());
КонецПроцедуры

Процедура ПРО_Справочник_ВидыДеятельностиЕНВД_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	СтарыйВладелец = ПроцедурыОбменаДаннымиПоОрганизации.ПолучитьРеквизитОбъектаИзБазы(Объект.Ссылка,"Справочник.ВидыДеятельностиЕНВД","Владелец");
	
	Если СтарыйВладелец <> Объект.Владелец Тогда
		Организации = ПроцедурыОбменаДаннымиПоОрганизации.ПолучитьСписокОрганизацийАссоциированныйСДанной(СтарыйВладелец);
		ПараметрыЗапроса.Вставить("ОрганизацииБС", Организации);
	
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|ПланОбмена.ПоОрганизации КАК ПланОбменаОсновнаяТаблица
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|ПланОбмена.ПоОрганизации.Организации КАК ПланОбменаОрганизации
		|ПО
		|ПланОбменаОрганизации.Ссылка = ПланОбменаОсновнаяТаблица.Ссылка
		|ГДЕ
		|ПланОбменаОрганизации.Организация В (&СвойствоОбъекта_ОрганизацииБС) 
		|И НЕ ПланОбменаОсновнаяТаблица.Ссылка = &ПоОрганизацииЭтотУзел
		|И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
		|[УсловиеОтбораПоРеквизитуФлагу]";
	КонецЕсли;
КонецПроцедуры

