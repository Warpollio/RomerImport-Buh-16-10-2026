Процедура ПРО_Документ_АвизоОСВходящее_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	ГлавныйУзел = ПланыОбмена.ГлавныйУзел();
	
	Если ГлавныйУзел <> Неопределено И
		Объект.ОбменДанными.Отправитель <> ГлавныйУзел Тогда
		Получатели.Добавить(ГлавныйУзел);
	КонецЕсли;
	
	Если Не Выгрузка Тогда
		ТаблицаЗначений = Объект.ОС.Выгрузить();
		ТаблицаЗначений.Свернуть("ОсновноеСредство");
		РазличныеОС = ТаблицаЗначений.ВыгрузитьКолонку("ОсновноеСредство");
		
		Для Каждого Элемент Из РазличныеОС Цикл
			
			Если Элемент = Справочники.ОсновныеСредства.ПустаяСсылка() Тогда
				Продолжить;
			КонецЕсли;
			
			ОС = Элемент.ПолучитьОбъект();
			ВыполнитьПравилаРегистрацииДляОбъекта(ОС,"ПоОрганизации",Объект.ОбменДанными.Отправитель);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры
