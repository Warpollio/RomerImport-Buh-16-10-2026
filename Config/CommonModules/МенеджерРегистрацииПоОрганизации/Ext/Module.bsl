#Область РегистрСведений_СчетаУчетаРасчетовСКонтрагентами
Процедура ДобавитьПРО_РегистрСведений_СчетаУчетаРасчетовСКонтрагентами(ПравилаРегистрацииОбъектов, ИмяМенеджераРегистрации)
	НовоеПравило = ПравилаРегистрацииОбъектов.Добавить();
	
	НовоеПравило.ИмяМенеджераРегистрации = ИмяМенеджераРегистрации; 
	НовоеПравило.Идентификатор = "РегистрСведений_СчетаУчетаРасчетовСКонтрагентами";
	
	НовоеПравило.ОбъектМетаданныхИмя = "РегистрСведений.СчетаУчетаРасчетовСКонтрагентами";
	НовоеПравило.ИмяПланаОбмена = "ПоОрганизации";
	НовоеПравило.ИмяРеквизитаФлага = "";	
	НовоеПравило.ПравилоПоСвойствамОбъектаПустое = Ложь; 
	НовоеПравило.ПакетноеВыполнениеОбработчиков = Ложь;
	НовоеПравило.ЕстьОбработчикПередОбработкой = Ложь;
	НовоеПравило.ЕстьОбработчикПриОбработке = Истина;
	НовоеПравило.ЕстьОбработчикПриОбработкеДополнительный = Ложь;
	НовоеПравило.ЕстьОбработчикПослеОбработки = Истина;
		
	УстановитьОтборы(НовоеПравило, 
		ОтборПоСвойствамПланаОбмена_13(),
		ПустойОтборПоСвойствамОбъекта());
КонецПроцедуры

Процедура ПРО_РегистрСведений_СчетаУчетаРасчетовСКонтрагентами_ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства)
	ИспользоватьКэш = Ложь;
	Организация = Объект.Организация;
	
	Если Организация = Справочники.Организации.ПустаяСсылка() Тогда
		
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|ПланОбмена.ПоОрганизации КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		|НЕ ПланОбменаОсновнаяТаблица.Ссылка = &ПоОрганизацииЭтотУзел
		|И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
		|[УсловиеОтбораПоРеквизитуФлагу]
		|";
		
	Иначе
		
		ПараметрыЗапроса.Вставить("ОрганизацииБС", Организация);
	
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|ПланОбмена.ПоОрганизации КАК ПланОбменаОсновнаяТаблица
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|ПланОбмена.ПоОрганизации.Организации КАК ПланОбменаОрганизации
		|ПО
		|ПланОбменаОрганизации.Ссылка = ПланОбменаОсновнаяТаблица.Ссылка
		|ГДЕ
		|ПланОбменаОрганизации.Организация = &СвойствоОбъекта_ОрганизацииБС 
		|И НЕ ПланОбменаОсновнаяТаблица.Ссылка = &ПоОрганизацииЭтотУзел
		|И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления
		|[УсловиеОтбораПоРеквизитуФлагу]
		|";
		
	КонецЕсли;
КонецПроцедуры

Процедура ПРО_РегистрСведений_СчетаУчетаРасчетовСКонтрагентами_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	ГлавныйУзел = ПланыОбмена.ГлавныйУзел();
	
	Если ГлавныйУзел <> Неопределено И
		Объект.ОбменДанными.Отправитель <> ГлавныйУзел Тогда
		Получатели.Добавить(ГлавныйУзел);
	КонецЕсли;
