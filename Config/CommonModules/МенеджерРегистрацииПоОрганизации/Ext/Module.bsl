Процедура ПРО_Справочник_ПравилаРучныхЗадачБухгалтера_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	ГлавныйУзел = ПланыОбмена.ГлавныйУзел();
	
	Если ГлавныйУзел <> Неопределено Тогда
		Индекс = Получатели.Найти(ГлавныйУзел);
		
		Если Индекс <> Неопределено Тогда
			Получатели.Удалить(Индекс);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
