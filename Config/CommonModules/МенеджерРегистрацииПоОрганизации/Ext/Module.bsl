			Если Элемент = Справочники.ОсновныеСредства.ПустаяСсылка() Тогда
				Продолжить;
			КонецЕсли;
			
			ОС = Элемент.ПолучитьОбъект();
			ВыполнитьПравилаРегистрацииДляОбъекта(ОС,"ПоОрганизации",Объект.ОбменДанными.Отправитель);
		КонецЦикла;
