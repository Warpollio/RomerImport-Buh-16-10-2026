КонецПроцедуры

Процедура ЗаполнитьПараметрыОбъектаДляЗаполненияДобавленныхКолонок(Знач Форма, ПараметрыОбъекта)

	Объект = Форма.Объект;
	
	Если ТипЗнч(ПараметрыОбъекта) <> Тип("Структура") Тогда
		ПараметрыОбъекта = Новый Структура;
	КонецЕсли;
	
	ОписаниеПараметров = Новый Массив;
	
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"СуммаВключаетНДС", Объект, "СуммаВключаетНДС"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"НДСВключенВСтоимость", Объект, "НДСВключенВСтоимость"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ПлательщикНалогаНаПрибыль", Форма, "ПлательщикНалогаНаПрибыль"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ПрименениеУСН", Форма, "ПрименениеУСН"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ПрименениеУСНДоходы", Форма, "ПрименениеУСНДоходы"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ПрименяетсяАУСН", Форма, "ПрименяетсяАУСН"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"СчетУчетаРасчетовСКонтрагентом", Объект, "СчетУчетаРасчетовСКонтрагентом"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"УчетАгентскогоНДС", Форма, "УчетАгентскогоНДС"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ЕстьРасхождения", Объект, "ЕстьРасхождения"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"РаздельныйУчетНДСНаСчете19", Форма, "РаздельныйУчетНДСНаСчете19"));
	
	// Параметры для РеализацииТоваровУслуг
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ДокументБезНДС", Объект, "ДокументБезНДС"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ПлательщикНДФЛ", Форма, "ПлательщикНДФЛ"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ВалютаДокумента", Объект, "ВалютаДокумента"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ВестиУчетПоПодразделениям", Форма, "ВестиУчетПоПодразделениям"));
	ОписаниеПараметров.Добавить(Новый Структура("ИмяПараметра, Источник, ИмяСвойства", 
		"ТребуетсяСчетРасходовПоОказаниюУслуг", Форма, "ТребуетсяСчетРасходовПоОказаниюУслуг"));
	
	Для Каждого ОписаниеПараметра Из ОписаниеПараметров Цикл
		
		Источник = ОписаниеПараметра.Источник;
		ИмяСвойства = ОписаниеПараметра.ИмяСвойства;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, ИмяСвойства) Тогда
			ПараметрыОбъекта.Вставить(
				ОписаниеПараметра.ИмяПараметра, 
				Источник[ИмяСвойства]);
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область УправлениеПанелью

Процедура ПоказатьПанельРаспознаваниеДокументов(Форма)
	
	Элементы = Форма.Элементы;
	
	Если Элементы.Найти("ПанельРаспознаваниеДокументов") = Неопределено Тогда
		Форма.Подключаемый_РаспознаваниеДокументовВызовСервера("ПодключитьРаспознаваниеДокументов");
		РаспознаваниеДокументовКлиент.ПриОткрытииФормыСБалансом(Форма, Форма.СостоянияПоБалансу);
	КонецЕсли;
	
	Элементы.ПанельРаспознаваниеДокументов.Видимость = Истина;
	
	Если Элементы.ИзменитьВидимостьПодсказок.Пометка Тогда
		Форма.Подключаемый_РаспознаваниеДокументовВызовСервера("ИзменитьВидимостьПодсказок");
	КонецЕсли;
	
	Форма.ПодключитьОбработчикОжидания("Подключаемый_ОбновитьСостояниеБаланса", 0.1, Истина);
	
КонецПроцедуры

Процедура ЗакрытьПанельРаспознаваниеДокументов(Форма)
	
	Форма.Элементы.ПанельРаспознаваниеДокументов.Видимость = Ложь;
	
КонецПроцедуры

Процедура СвернутьРазвернутьРаспознанныеФайлы(Форма)
	
	ГруппаРаспознанныеФайлыСписок = Форма.Элементы.ГруппаРаспознанныеФайлыСписок;
	
	ГруппаРаспознанныеФайлыСписок.Видимость = Не ГруппаРаспознанныеФайлыСписок.Видимость;
	
	Если ГруппаРаспознанныеФайлыСписок.Видимость Тогда
		Форма.Элементы.КнопкаВсплывающаяРаспознанныеФайлы.Картинка = БиблиотекаКартинок.СтрелкаВниз;
	Иначе
		Форма.Элементы.КнопкаВсплывающаяРаспознанныеФайлы.Картинка = БиблиотекаКартинок.СтрелкаВправо;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ФайлыКОтправкеРаспознаваниеДокументов

Процедура ВыполнитьЗагрузкуФайлов(Форма, СсылкиНаФайлыИлиПараметрыДиалога)
	
	НачатьПомещениеФайловНаСервер(
		Новый ОписаниеОповещения("ПриЗавершенииПомещенияФайлов", ЭтотОбъект, Новый Структура("Форма", Форма)),
		,
		,
		СсылкиНаФайлыИлиПараметрыДиалога,
		Форма.УникальныйИдентификатор
	);
	
КонецПроцедуры

Процедура ФайлыКОтправкеРаспознаваниеДокументовУдалить(Форма)
	
	ЭлементТаблицы = Форма.Элементы.Найти("ФайлыКОтправкеРаспознаваниеДокументов");
	
	Если ЭлементТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ЭлементТаблицы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма.ФайлыКОтправкеРаспознаваниеДокументов.Удалить(ТекущиеДанные);
	
КонецПроцедуры

Процедура ФайлыКОтправкеРаспознаваниеДокументовПереместитьВниз(Форма)
	
	Таблица = Форма.ФайлыКОтправкеРаспознаваниеДокументов;
	
	Если Таблица.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементТаблицы = Форма.Элементы.Найти("ФайлыКОтправкеРаспознаваниеДокументов");
	Если ЭлементТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ЭлементТаблицы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийИндекс = Таблица.Индекс(ТекущиеДанные);
	НовыйИндекс = ТекущийИндекс + 1;
	
	Если НовыйИндекс >= Таблица.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Таблица.Сдвинуть(ТекущийИндекс, 1);
	
КонецПроцедуры

Процедура ФайлыКОтправкеРаспознаваниеДокументовПереместитьВверх(Форма)
	
	Таблица = Форма.ФайлыКОтправкеРаспознаваниеДокументов;
	
	Если Таблица.Количество() <= 1 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементТаблицы = Форма.Элементы.Найти("ФайлыКОтправкеРаспознаваниеДокументов");
	Если ЭлементТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ЭлементТаблицы.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийИндекс = Таблица.Индекс(ТекущиеДанные);
	НовыйИндекс = ТекущийИндекс - 1;
	
	Если НовыйИндекс < 0 Тогда
		Возврат;
	КонецЕсли;
	
	Таблица.Сдвинуть(ТекущийИндекс, -1);
	
КонецПроцедуры

Процедура ФайлыКОтправкеРаспознаваниеДокументовДобавить(Форма)
	
	ИмяТаблицы = "ФайлыКОтправкеРаспознаваниеДокументов";
	ЭлементТаблицы = Форма.Элементы.Найти(ИмяТаблицы);
	Если ЭлементТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементТаблицы.ДобавитьСтроку();

КонецПроцедуры

#КонецОбласти

#КонецОбласти
