#Область ПрограммныйИнтерфейс

// Показать добавление файлов.
// 
// Параметры:
//  УникальныйИдентификатор - Строка - Уникальный идентификатор
//  ОповещениеЗавершения - Неопределено - Оповещение завершения
//  ФайлыДокумента - Неопределено - Файлы документа
//
Процедура ПоказатьДобавлениеФайлов(УникальныйИдентификатор, ОповещениеЗавершения = Неопределено, ФайлыДокумента = Неопределено) Экспорт
	
	ПараметрыОткрытия = Новый Структура;
	
	Если ФайлыДокумента <> Неопределено Тогда
		ПараметрыОткрытия.Вставить("ФайлыДокумента", ФайлыДокумента);
	КонецЕсли;
	
	ОткрытьФорму("Обработка.РаспознаваниеДокументовОтправкаФайлов.Форма.ОтправитьФайлы", ПараметрыОткрытия, , , , , ОповещениеЗавершения);
	
КонецПроцедуры

// Показать авторизацию.
// 
// Параметры:
//  ОповещениеОЗавершении - ОписаниеОповещения, Неопределено - Оповещение о завершении
//  ВладелецФормы - Форма, Неопределено - Владелец формы
//
Процедура ПоказатьАвторизацию(ОповещениеОЗавершении = Неопределено, ВладелецФормы = Неопределено) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("ТипАвторизации", "ПоЛогинуПаролю");
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("ВладелецФормы", ВладелецФормы);
	
	Обработчик = Новый ОписаниеОповещения("ПослеАвторизации", РаспознаваниеДокументовСлужебныйКлиент, Контекст);
	ОткрытьФорму("Обработка.РаспознаваниеДокументов.Форма.АвторизациюПоЛогинуПаролю", , ВладелецФормы, , , , Обработчик);
	
КонецПроцедуры

// Показать авторизацию ИТС.
// 
// Параметры:
//  ОповещениеОЗавершении - ОписаниеОповещения, Неопределено - Оповещение о завершении
//  ВладелецФормы - Форма, Неопределено - Владелец формы
//  ПроверятьДанныеАутентификацииИТС - Булево, Неопределено - Проверять данные аутентификации ИТС
//
Процедура ПоказатьАвторизациюИТС(ОповещениеОЗавершении = Неопределено, ВладелецФормы = Неопределено, ПроверятьДанныеАутентификацииИТС = Неопределено) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("ТипАвторизации", "ПоТикетуИТС");
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("ВладелецФормы", ВладелецФормы);
	
	Если СтандартныеПодсистемыКлиент.ПараметрыРаботыКлиента().РазделениеВключено Тогда
		
		// Если фреш - параметры ИТС хранятся в менеджере сервиса
		// всегда сразу переходим к циклу авторизации тикета
		
		РаспознаваниеДокументовСлужебныйКлиент.ПослеАвторизации("РазделениеВключено", Контекст);
		
	Иначе
		
		// Если коробка - то параметры ИТС хранятся в БИП
		// При этом заранее не возможно знать сохраненные данные в базе актуальны или устарели
		// Например, если пользователь портала сменил пароль и не обновил его в базе
		
		Если РаспознаваниеДокументовСлужебныйВызовСервера.КорректныДанныеАутентификацииПользователяИнтернетПоддержки() Тогда
			
			// Если параметры ИТС корректны - сразу переходим к циклу авторизации по тикету
			// Если попытка получения тикета не удалась из-за ошибки пароля - предложим ввести логин и пароль.
			
			РаспознаваниеДокументовСлужебныйКлиент.ПослеАвторизации("АвторизацияКорректна", Контекст);
			
		Иначе
			
			// Если не заполнены - просим заполнить и авторизоваться, а после переходим к циклу с тикетом
			// После авторизации гарантированно данные авторизации заполнены и верны, потому перепроверять из не требуется.
			
			Обработчик = Новый ОписаниеОповещения("ПослеАвторизации", РаспознаваниеДокументовСлужебныйКлиент, Контекст);
			ИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей(Обработчик, ВладелецФормы);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Показать ввод промокода.
// 
// Параметры:
//  ОповещениеОЗавершении - ОписаниеОповещения, Неопределено - Оповещение о завершении
//  ВладелецФормы - Форма, Неопределено - Владелец формы
//
Процедура ПоказатьВводПромокода(ОповещениеОЗавершении = Неопределено, ВладелецФормы = Неопределено) Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	Контекст.Вставить("ВладелецФормы", ВладелецФормы);
	
	Обработчик = Новый ОписаниеОповещения("ПослеВводаПромокода", РаспознаваниеДокументовСлужебныйКлиент, Контекст);
	ОткрытьФорму("Обработка.РаспознаваниеДокументов.Форма.ФормаПромокода", , ВладелецФормы, , , , Обработчик);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПослеДобавленияФайлов(Результат, Контекст) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму("Документ.РаспознанныйДокумент.ФормаСписка", , ,
		"Документ.РаспознанныйДокумент.Форма.ФормаСписка");
	
КонецПроцедуры

// Проверяет, относится ли команда формы к универсальным действиям баланса сервиса распознавания.
//
// Параметры:
//  Команда - КомандаФормы - проверяемая команда формы.
//
// Возвращаемое значение:
//  Булево - Истина, если команда относится к действиям баланса.
//
Функция ЭтоКомандаБаланса(Команда) Экспорт

	Если Команда = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат Команда.Имя = "ПодключитьТестовыйПериод"
		Или Команда.Имя = "ПерейтиЛичныйКабинет";

КонецФункции

// Выполняет универсальную команду баланса сервиса распознавания.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, из которой вызвана команда.
//  Команда - КомандаФормы - выполняемая команда формы.
//  ОповещениеОЗавершении - ОписаниеОповещения, Неопределено - обработчик завершения действия баланса.
//
Процедура ВыполнитьКомандуБаланса(Форма, Команда, ОповещениеОЗавершении = Неопределено) Экспорт
	
	Если Не ЭтоКомандаБаланса(Команда) Тогда
		Возврат;
	КонецЕсли;
	
	Если Команда.Имя = "ПодключитьТестовыйПериод" Тогда
		
		Если ОповещениеОЗавершении = Неопределено Тогда
			ОповещениеОЗавершении = ОповещениеОбновленияБалансаФормы(Форма);
		КонецЕсли;
		
		ИдентификаторСервиса = РаспознаваниеДокументовСлужебныйКлиентСервер.ИдентификаторСервиса();
		ПодключениеСервисовСопровожденияКлиент.ПодключитьТестовыйПериод(ИдентификаторСервиса, Форма,
		ОповещениеОЗавершении);
		
	ИначеЕсли Команда.Имя = "ПерейтиЛичныйКабинет" Тогда
		
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(
		РаспознаваниеДокументовСлужебныйКлиентСервер.АдресЛичногоКабинета());
		
	КонецЕсли;
	
КонецПроцедуры

// Обрабатывает навигационную ссылку из представления баланса сервиса распознавания.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, из которой вызвана навигационная ссылка.
//  НавигационнаяСсылкаФорматированнойСтроки - Строка - навигационная ссылка форматированной строки.
//  СтандартнаяОбработка - Булево - признак стандартной обработки навигационной ссылки.
//  ОповещениеОЗавершении - ОписаниеОповещения, Неопределено - обработчик завершения действия баланса.
//
Процедура ОбработатьНавигационнуюСсылкуБаланса(Форма, НавигационнаяСсылкаФорматированнойСтроки,
	СтандартнаяОбработка, ОповещениеОЗавершении = Неопределено) Экспорт
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "#Перейти" Тогда
		СтандартнаяОбработка = Ложь;
		Если ОповещениеОЗавершении = Неопределено Тогда
			ОповещениеОЗавершении = ОповещениеОбновленияБалансаФормы(Форма);
		КонецЕсли;
		ПоказатьАвторизациюИТС(ОповещениеОЗавершении, Форма);
	КонецЕсли;
	
КонецПроцедуры

// Выполняет обработку при открытии формы с группой баланса сервиса распознавания.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой отображается баланс.
//  СостоянияПоБалансу - Структура, Неопределено - предварительно полученное состояние баланса.
//
Процедура ПриОткрытииФормыСБалансом(Форма, СостоянияПоБалансу = Неопределено) Экспорт
	
	Если СостоянияПоБалансу = Неопределено Тогда
		ОбновитьСостояниеБалансаФормы(Форма);
	Иначе
		ОтрисоватьСостояниеБалансаФормы(Форма, СостоянияПоБалансу);
		ПодключитьОбновлениеСостоянияБалансаФормы(Форма);
	КонецЕсли;
	
КонецПроцедуры

// Обновляет состояние баланса сервиса распознавания на форме.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой отображается баланс.
//
Процедура ОбновитьСостояниеБалансаФормы(Форма) Экспорт
	
	Если Форма.Элементы.Найти("ГруппаБалансВсплывающая") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстОбновления = Новый Структура;
	КонтекстОбновления.Вставить("Форма", Форма);
	
	Оповещение = Новый ОписаниеОповещения("ПослеПолученияСостоянияБалансаФормы", РаспознаваниеДокументовКлиент, КонтекстОбновления);
	ПолучитьСостояниеБалансаСервисаРаспознавания(Форма, Оповещение);
	
КонецПроцедуры

// Отрисовывает состояние баланса сервиса распознавания на форме.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой отображается баланс.
//  СостоянияПоБалансу - Структура - состояние баланса сервиса.
//
Процедура ОтрисоватьСостояниеБалансаФормы(Форма, СостоянияПоБалансу) Экспорт
	
	РаспознаваниеДокументовСлужебныйКлиент.ОтрисоватьПредставлениеБаланса(Форма, СостоянияПоБалансу);
	ВыполнитьОбработчикПослеОтрисовкиБаланса(Форма, СостоянияПоБалансу);
	
КонецПроцедуры

// Получение баланса неиспользованных страниц сервиса распознавания
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, для которой ожидается получение состояния баланса.
//  ОповещениеОПолученииСостоянияБаланса - ОписаниеОповещения - обработчик получения состояния баланса.
//
Процедура ПолучитьСостояниеБалансаСервисаРаспознавания(Форма, ОповещениеОПолученииСостоянияБаланса) Экспорт
	
	ДлительнаяОперация = РаспознаваниеДокументовСлужебныйВызовСервера.ДлительнаяОперацияПолучениеСостояниеБаланса(
	Форма.УникальныйИдентификатор);
	
	Если ДлительнаяОперация = Неопределено
		Или ДлительнаяОперация.Статус = "Ошибка"
		Или ДлительнаяОперация.Статус = "Отменено" Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОПолученииСостоянияБаланса, СостоянияПоБалансуОшибка());
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	КонтекстОбновления = Новый Структура;
	КонтекстОбновления.Вставить("ОповещениеОПолученииСостоянияБаланса", ОповещениеОПолученииСостоянияБаланса);
	
	Обработчик = Новый ОписаниеОповещения("ПослеПолученияСостоянияБаланса", РаспознаваниеДокументовКлиент,
	КонтекстОбновления);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Обработчик, ПараметрыОжидания);
	
КонецПроцедуры

// Обрабатывает завершение получения состояния баланса
//
// Параметры:
//  ДлительнаяОперация - См. ДлительныеОперации.ВыполнитьФункцию.
//  КонтекстОбновления - Структура - контекст обновления баланса:
//   * ОповещениеОПолученииСостоянияБаланса - ОписаниеОповещения - обработчик получения состояния баланса.
//
Процедура ПослеПолученияСостоянияБаланса(
	ДлительнаяОперация,
	КонтекстОбновления
	) Экспорт
	
	СостоянияПоБалансу = Неопределено;
	Если ДлительнаяОперация <> Неопределено И ДлительнаяОперация.Статус = "Выполнено" Тогда
		СостоянияПоБалансу = ПолучитьИзВременногоХранилища(ДлительнаяОперация.АдресРезультата);
	КонецЕсли;
	
	Если СостоянияПоБалансу = Неопределено Тогда
		СостоянияПоБалансу = СостоянияПоБалансуОшибка();
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(КонтекстОбновления.ОповещениеОПолученииСостоянияБаланса, СостоянияПоБалансу);
	
КонецПроцедуры

// Обрабатывает получение состояния баланса сервиса распознавания для формы.
//
// Параметры:
//  СостоянияПоБалансу - Структура - состояние баланса сервиса.
//  КонтекстОбновления - Структура - контекст обновления баланса:
//   * Форма - ФормаКлиентскогоПриложения - форма, на которой отображается баланс.
//
Процедура ПослеПолученияСостоянияБалансаФормы(СостоянияПоБалансу, КонтекстОбновления) Экспорт
	
	ОтрисоватьСостояниеБалансаФормы(КонтекстОбновления.Форма, СостоянияПоБалансу);
	ПодключитьОбновлениеСостоянияБалансаФормы(КонтекстОбновления.Форма);
	
КонецПроцедуры

// Обрабатывает завершение действия баланса сервиса распознавания.
//
// Параметры:
//  Результат - Произвольный - результат выполнения действия.
//  КонтекстОбновления - Структура - контекст обновления баланса:
//   * Форма - ФормаКлиентскогоПриложения - форма, на которой отображается баланс.
//
Процедура ПослеВыполненияДействияБаланса(Результат, КонтекстОбновления) Экспорт
	
	ПодключеноКСервисуРаспознавания = РаспознаваниеДокументовСлужебныйВызовСервера.ПодключеноКСервисуРаспознавания();
	
	Если ПодключеноКСервисуРаспознавания Тогда
		ПоказатьОжиданиеПолученияСостоянияБаланса(КонтекстОбновления.Форма);
		ПодключитьОбновлениеСостоянияБалансаФормы(КонтекстОбновления.Форма, 0.1);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПоказатьОжиданиеПолученияСостоянияБаланса(Форма)
	
	Если Форма.Элементы.Найти("ГруппаБалансВсплывающая") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из Форма.Элементы.ГруппаБалансЛево.ПодчиненныеЭлементы Цикл
		Элемент.Видимость = Ложь;
	КонецЦикла;
	
	Для Каждого Элемент Из Форма.Элементы.ГруппаБалансПраво.ПодчиненныеЭлементы Цикл
		Элемент.Видимость = Ложь;
	КонецЦикла;
	
	Форма.Элементы.ДекорацияОформлениеКартинка.Картинка = БиблиотекаКартинок.ДлительнаяОперация48;
	Форма.Элементы.ДекорацияОформлениеКартинка.Видимость = Истина;
	Форма.Элементы.ТекстПолучениеСостоянияБаланса.Видимость = Истина;
	
	КартинкаЗаголовкаБаланса = Форма.Элементы.Найти("КартинкаЗаголовкаБаланса");
	Если КартинкаЗаголовкаБаланса = Неопределено Тогда
		Форма.Элементы.ГруппаБалансВсплывающая.Заголовок = НСтр("ru='Проверка статуса подключения'");
	Иначе
		КартинкаЗаголовкаБаланса.Картинка = БиблиотекаКартинок.ДлительнаяОперация16;
		КартинкаЗаголовкаБаланса.Видимость = Истина;
		Форма.Элементы.ГруппаБалансВсплывающая.Заголовок = "";
	КонецЕсли;
	
	Форма.Элементы.ГруппаБалансВсплывающая.ЦветТекстаЗаголовка = WebЦвета.Зеленый;
	Форма.Элементы.ГруппаБалансВсплывающая.Видимость = Истина;
	
	ГруппаЗаголовкаБаланса = Форма.Элементы.Найти("ГруппаЗаголовкаБаланса");
	Если ГруппаЗаголовкаБаланса <> Неопределено Тогда
		ГруппаЗаголовкаБаланса.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодключитьОбновлениеСостоянияБалансаФормы(Форма, ИнтервалОбновления = Неопределено)
	
	Если Форма.Элементы.Найти("ГруппаБалансВсплывающая") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИнтервалОбновления = Неопределено Тогда
		ИнтервалОбновления = ПараметрГруппыБалансаФормы(Форма, "ИнтервалОбновления", 30);
	КонецЕсли;
	
	ИмяОбработчикаОбновления = ПараметрГруппыБалансаФормы(Форма, "ИмяОбработчикаОбновления",
		"Подключаемый_ОбновитьСостояниеБаланса");
	Форма.ПодключитьОбработчикОжидания(ИмяОбработчикаОбновления, ИнтервалОбновления, Истина);
	
КонецПроцедуры

Процедура ВыполнитьОбработчикПослеОтрисовкиБаланса(Форма, СостоянияПоБалансу)
	
	ИмяОбработчикаПослеОтрисовки = ПараметрГруппыБалансаФормы(Форма, "ИмяОбработчикаПослеОтрисовки", "");
	Если Не ЗначениеЗаполнено(ИмяОбработчикаПослеОтрисовки) Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения(ИмяОбработчикаПослеОтрисовки, Форма);
	ВыполнитьОбработкуОповещения(Оповещение, СостоянияПоБалансу);
	
КонецПроцедуры

Функция ОповещениеОбновленияБалансаФормы(Форма)
	
	КонтекстОбновления = Новый Структура;
	КонтекстОбновления.Вставить("Форма", Форма);
	
	Возврат Новый ОписаниеОповещения("ПослеВыполненияДействияБаланса", РаспознаваниеДокументовКлиент, КонтекстОбновления);
	
КонецФункции

Функция ПараметрГруппыБалансаФормы(Форма, ИмяПараметра, ЗначениеПоУмолчанию)
	
	ПараметрыГруппыБаланса = Неопределено;
	
	Попытка
		ПараметрыГруппыБаланса = Форма.ПараметрыГруппыБаланса;
	Исключение
		ПараметрыГруппыБаланса = Неопределено;
	КонецПопытки;
	
	Если ПараметрыГруппыБаланса = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ЗначениеПараметра = ЗначениеПоУмолчанию;
	ПараметрыГруппыБаланса.Свойство(ИмяПараметра, ЗначениеПараметра);
	
	Возврат ЗначениеПараметра;
	
КонецФункции

Функция СостоянияПоБалансуОшибка()
	
	СостоянияПоБалансу = Новый Структура;
	СостоянияПоБалансу.Вставить("СостояниеБаланса", "Ошибка");
	СостоянияПоБалансу.Вставить("АдресЭлПочты", "");
	СостоянияПоБалансу.Вставить("ДатаОкончания", Дата("00010101"));
	СостоянияПоБалансу.Вставить("Баланс", 0);
	СостоянияПоБалансу.Вставить("Кредит", 0);
	СостоянияПоБалансу.Вставить("Использовано", 0);
	СостоянияПоБалансу.Вставить("ПоказатьТребованиеВключитьИТС", Ложь);
	
	Возврат СостоянияПоБалансу;
	
КонецФункции

#КонецОбласти
