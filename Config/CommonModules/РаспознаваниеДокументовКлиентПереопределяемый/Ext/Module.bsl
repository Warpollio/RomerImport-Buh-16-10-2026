#Область ПрограммныйИнтерфейс

// Открытие формы создаваемого документа.
// 
// Параметры:
//  ТипДокумента - ПеречислениеСсылка.ТипыДокументовРаспознаваниеДокументов
//  ПараметрыЗаполнения - Структура:
//  *Контрагент - СправочникСсылка.Контрагенты
//  *Организация - СправочникСсылка.Организации
//  *ИмяРеквизитаНомерДокумента - Строка
//  *ИмяРеквизитаДатаДокумента  - Строка 
//  Владелец - Форма
//
Процедура ОткрытиеФормыСоздаваемогоДокумента(ТипДокумента, ПараметрыЗаполнения, Владелец) Экспорт
	
	// БП
	
	РаспознаваниеДокументовБПКлиент.ОткрытиеФормыСоздаваемогоДокумента(ТипДокумента, ПараметрыЗаполнения, Владелец);
	
	// Конец БП
	
КонецПроцедуры

// Открытие формы редактирования строки.
// 
// Параметры:
//  ЭтотОбъект - Форма 
//  ДанныеСтроки - СтрокаТабличнойЧасти
//
Процедура ОткрытиеФормыРедактированияСтроки(ЭтотОбъект, ДанныеСтроки) Экспорт
	
	// БП
	
	РаспознаваниеДокументовБПКлиент.ОткрытиеФормыРедактированияСтроки(ЭтотОбъект, ДанныеСтроки);
	
	// Конец БП
	
КонецПроцедуры

// Список возможных форм открытия аналитику учета
// 
// Параметры:
//  ФормыВыборкаАналитикиУчета - Массив Из Строка
//
Процедура ПриОпределенииФормВыборкаАналитикиУчета(ФормыВыборкаАналитикиУчета) Экспорт
	
	ФормыВыборкаАналитикиУчета.Добавить("ОбщаяФорма.РедактированиеСчетаЗатрат");
	ФормыВыборкаАналитикиУчета.Добавить("Документ.РеализацияТоваровУслуг.Форма.ФормаРедактированияСтрокиТоварыУслуги");
	ФормыВыборкаАналитикиУчета.Добавить("Обработка.РаспознаваниеДокументовБП.Форма.ФормаРедактированиеСчетаУчета");
	
КонецПроцедуры

Процедура ИмяФормыСозданияЭлемента(ИмяЭлемента, ИмяФормы) Экспорт
	
	Если ИмяЭлемента = "Продавец" Или ИмяЭлемента = "Покупатель" Тогда
		ИмяФормы = "Обработка.РаспознаваниеДокументовБП.Форма.СозданиеКонтрагента";
	КонецЕсли;
	
КонецПроцедуры

//Обработчик события нажатия навигационной ссылки в форме Документы.РаспознанныйДокумент.СписокМК
Процедура ОбработкаНавигационнойСсылки(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;
	Если НавигационнаяСсылкаФорматированнойСтроки = "#РапознаваниеПолный" Тогда
		ПутьВИнтерефейсе = НСтр("ru = 'В приложении на компьютере откройте раздел Покупки и выберите Распознавание документов'");
		ПоказатьПредупреждение(, ПутьВИнтерефейсе);
	ИначеЕсли НавигационнаяСсылкаФорматированнойСтроки = "#РапознаваниеПростой" Тогда
		ПутьВИнтерефейсе = НСтр("ru = 'В приложении на компьютере откройте раздел Документы и в меню Загрузить выберите Из скана(фото)'");
		ПоказатьПредупреждение(, ПутьВИнтерефейсе);
	КонецЕсли;
КонецПроцедуры

#Область БыстроеРаспознаваниеДокументов

// Возвращает соответствие распознанных реквизитов формы документа.
// Контракт: форма, использующая быстрое распознавание, должна объявлять
// экспортируемую переменную `СоответствиеРаспознанныхРеквизитов`.
// Безопасна для форм, не имеющих такой переменной (возвращает Неопределено).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//  Соответствие - Соответствие - выходной параметр, соответствие распознанных
//    реквизитов, или Неопределено.
//
Процедура СоответствиеРаспознанныхРеквизитов(Форма, Соответствие) Экспорт
	
	Соответствие = Форма.СоответствиеРаспознанныхРеквизитов;
	
КонецПроцедуры

// Устанавливает соответствие распознанных реквизитов формы документа.
// Безопасна для форм, не имеющих такой переменной (игнорирует вызов).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//  Значение - Соответствие - соответствие распознанных реквизитов.
//
Процедура УстановитьСоответствиеРаспознанныхРеквизитов(Форма, Значение) Экспорт
	
	Форма.СоответствиеРаспознанныхРеквизитов = Значение;
	
КонецПроцедуры

// Возвращает координаты распознанной области для отображения на картинке.
// Безопасна для форм, не имеющих переменной `Координаты` (возвращает Неопределено).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//  Координаты - Произвольный - выходной параметр, координаты распознанной
//    области, или Неопределено.
//
Процедура КоординатыРаспознаннойОбласти(Форма, Координаты) Экспорт
	
	Координаты = Форма.Координаты;
	
КонецПроцедуры

// Устанавливает координаты распознанной области.
// Безопасна для форм, не имеющих переменной `Координаты` (игнорирует вызов).
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//  Значение - Произвольный - координаты распознанной области.
//
Процедура УстановитьКоординатыРаспознаннойОбласти(Форма, Значение) Экспорт
	
	Форма.Координаты = Значение;
	
КонецПроцедуры

// Обновляет итоги документа после заполнения табличных частей и шапки
// распознанными данными. Ветвление по типу документа инкапсулировано здесь,
// вызывающий код не должен знать о формах счёта на оплату.
//
// Контракт (обязательный):
//  - для документов СчетНаОплатуПокупателю / СчетНаОплатуПоставщика форма должна
//    реализовать экспортную процедуру `Подключаемый_ОбновитьИтоги(Форма)`;
//  - для остальных документов (ПоступлениеТоваровУслуг, РеализацияТоваровУслуг)
//    форма должна реализовать экспортные процедуры `ЗаполнитьДобавленныеКолонкиТаблиц()`
//    и `ОбновитьИтогиНаСервере()`.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//  ТипДокумента - Строка - имя документа (ПоступлениеТоваровУслуг, РеализацияТоваровУслуг,
//    СчетНаОплатуПокупателю, СчетНаОплатуПоставщика).
//
Процедура ОбновитьИтогиДокументаПослеБыстрогоРаспознавания(Форма, ТипДокумента) Экспорт
	
	Если ТипДокумента = "СчетНаОплатуПокупателю" Или ТипДокумента = "СчетНаОплатуПоставщика" Тогда
		Форма.Подключаемый_ОбновитьИтоги(Форма);
	Иначе
		Форма.ЗаполнитьДобавленныеКолонкиТаблиц();
		Форма.ОбновитьИтогиНаСервере();
		ПоступлениеТоваровУслугФормыКлиентСервер.УстановитьТребуетсяСчетФактура(Форма);
	КонецЕсли;
	
	Форма.УправлениеФормойНаСервере();
	
КонецПроцедуры

// Обрабатывает изменение номенклатуры в строке табличной части после
// заполнения распознанными данными. Используется для документов СчетНаОплату,
// не поддерживающих пакетную серверную обработку.
//
// Контракт (обязательный для документов СчетНаОплату*): форма должна реализовать
// экспортную процедуру `Подключаемый_ТоварыНоменклатураПриИзмененииНаКлиенте(СтрокаТаблицы)`.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа.
//  НоваяСтрока - ДанныеФормыЭлементКоллекции - строка табличной части.
//
Процедура НоменклатураПриИзмененииНаКлиентеПослеБыстрогоРаспознавания(Форма, НоваяСтрока) Экспорт
	
	Форма.Подключаемый_ТоварыНоменклатураПриИзмененииНаКлиенте(НоваяСтрока);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
