Процедура ПРО_РегистрСведений_ОтветственныеЛица_ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства)
	ИспользоватьКэш  = Ложь;
	СтруктурнаяЕдиница = Объект.СтруктурнаяЕдиница;
	
	Если ЗначениеЗаполнено(СтруктурнаяЕдиница)
		И ОбщегоНазначения.СсылкаСуществует(СтруктурнаяЕдиница) Тогда
		Получатели = ОпределитьПолучателей(СтруктурнаяЕдиница.ПолучитьОбъект(), "АвтономнаяРабота");
		ПараметрыЗапроса.Вставить("Получатели", ?(ЗначениеЗаполнено(Получатели),Получатели, Новый Массив));
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.АвтономнаяРабота КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		| ПланОбменаОсновнаяТаблица.Ссылка В (&СвойствоОбъекта_Получатели)";	
	КонецЕсли;
КонецПроцедуры
