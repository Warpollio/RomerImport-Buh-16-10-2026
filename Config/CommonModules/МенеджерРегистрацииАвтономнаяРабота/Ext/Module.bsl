// Обработчик события ПередОбработкой правила регистрации 
// Параметры:
//  ПРО - СтрокаТаблицыЗначений - Правило регистрации объекта
//  Отказ - Булево - Отказ от выполнения правила регистрации.
//  Объект - КонстантаМенеджерЗначения
//         - СправочникОбъект
//         - ДокументОбъект
//         - ПланВидовХарактеристикОбъект
//         - ПланСчетовОбъект
//         - ПланВидовРасчетаОбъект
//         - БизнесПроцессОбъект
//         - ЗадачаОбъект
//         - РегистрСведенийНаборЗаписей
//         - РегистрНакопленияНаборЗаписей
//         - РегистрБухгалтерииНаборЗаписей
//         - РегистрРасчетаНаборЗаписей - объект для которого выполняется правило регистрации.
//  ОбъектМетаданных - ОбъектМетаданных - Объект метаданных, соответствующий объекту.
//  Выгрузка - Булево - контекст выполнения правила регистрации, если Истина то происходит выгрузка объекта.
Процедура ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка) Экспорт
	Если ПРО.Идентификатор = "Документ_Встреча" Тогда 
		ПРО_Документ_Встреча_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ПрочееВзаимодействие" Тогда 
		ПРО_Документ_ПрочееВзаимодействие_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_ПрочееВзаимодействие2" Тогда 
		ПРО_Документ_ПрочееВзаимодействие2_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Документ_Встреча2" Тогда 
		ПРО_Документ_Встреча2_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ХранилищеДанных" Тогда 
		ПРО_РегистрСведений_ХранилищеДанных_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ЗадачиБухгалтера" Тогда 
		ПРО_РегистрСведений_ЗадачиБухгалтера_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "РегистрСведений_ХранилищеДанных2" Тогда 
		ПРО_РегистрСведений_ХранилищеДанных2_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_НематериальныеАктивы" Тогда 
		ПРО_Справочник_НематериальныеАктивы_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_ОсновныеСредства" Тогда 
		ПРО_Справочник_ОсновныеСредства_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_Склады" Тогда 
		ПРО_Справочник_Склады_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_БанковскиеСчета" Тогда 
		ПРО_Справочник_БанковскиеСчета_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_ВидыОплатОрганизаций" Тогда 
		ПРО_Справочник_ВидыОплатОрганизаций_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_ДоговорыКонтрагентов" Тогда 
		ПРО_Справочник_ДоговорыКонтрагентов_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_НематериальныеАктивы2" Тогда 
		ПРО_Справочник_НематериальныеАктивы2_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_ОсновныеСредства2" Тогда 
		ПРО_Справочник_ОсновныеСредства2_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_БанковскиеСчета2" Тогда 
		ПРО_Справочник_БанковскиеСчета2_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка);
	ИначеЕсли ПРО.Идентификатор = "Справочник_СпособыОтраженияРасходовПоАмортизации" Тогда 
