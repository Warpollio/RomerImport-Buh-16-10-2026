Процедура ПРО_РегистрСведений_РегистрацииСведенийДляОплатыОтпускаСФР_ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства)
	ИспользоватьКэш  = Ложь;
	ИсходящийДокумент = Объект.ИсходящийДокумент;
	
	Если ЗначениеЗаполнено(ИсходящийДокумент)
		И ОбщегоНазначения.СсылкаСуществует(ИсходящийДокумент) Тогда
		Получатели = ОпределитьПолучателей(ИсходящийДокумент.ПолучитьОбъект(), "АвтономнаяРабота");
		ПараметрыЗапроса.Вставить("Получатели", ?(ЗначениеЗаполнено(Получатели),Получатели, Новый Массив));
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.АвтономнаяРабота КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		| ПланОбменаОсновнаяТаблица.Ссылка В (&СвойствоОбъекта_Получатели)";	
	КонецЕсли;
КонецПроцедуры
