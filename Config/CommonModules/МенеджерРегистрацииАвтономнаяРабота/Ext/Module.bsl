Процедура ПРО_Справочник_НастройкиПодключенияКОблачнымКассам_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	ОблачнаяКасса = Объект.ОблачнаяКасса;
	Если ЗначениеЗаполнено(ОблачнаяКасса)
		И ОбщегоНазначения.СсылкаСуществует(ОблачнаяКасса) Тогда
		Получатели = ОпределитьПолучателей(ОблачнаяКасса.ПолучитьОбъект(), "АвтономнаяРабота");
	
		Если Не Выгрузка Тогда
			ПредыдущаяОблачнаяКасса = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ОблачнаяКасса");
			Если (ОблачнаяКасса <> ПредыдущаяОблачнаяКасса) И ЗначениеЗаполнено(ПредыдущаяОблачнаяКасса) И ОбщегоНазначения.СсылкаСуществует(ПредыдущаяОблачнаяКасса) Тогда
				ПредыдущиеПолучатели = ОпределитьПолучателей(ПредыдущаяОблачнаяКасса.ПолучитьОбъект(), "АвтономнаяРабота");
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Получатели, ПредыдущиеПолучатели, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
