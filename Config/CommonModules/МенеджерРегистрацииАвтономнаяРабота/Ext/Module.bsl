Процедура ПРО_Справочник_Склады2_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	ПодразделениеОрганизации           = Объект.ПодразделениеОрганизации;
	ПредыдущееПодразделениеОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ПодразделениеОрганизации");
	Организация           = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПодразделениеОрганизации, "Владелец");
	
	Если ЗначениеЗаполнено(Организация)
		 И ОбщегоНазначения.СсылкаСуществует(Организация) Тогда
		Получатели = ОпределитьПолучателей(Организация.ПолучитьОбъект(), "АвтономнаяРабота");
		
		Если Не Выгрузка Тогда
			ПредыдущаяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПредыдущееПодразделениеОрганизации, "Владелец");
			Если (Организация <> ПредыдущаяОрганизация) И ЗначениеЗаполнено(ПредыдущаяОрганизация) И ОбщегоНазначения.СсылкаСуществует(ПредыдущаяОрганизация) Тогда
				ПредыдущиеПолучатели = ОпределитьПолучателей(ПредыдущаяОрганизация.ПолучитьОбъект(), "АвтономнаяРабота");
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Получатели, ПредыдущиеПолучатели, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
