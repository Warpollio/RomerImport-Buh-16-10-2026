Процедура ПРО_Справочник_РеквизитыКодаДляОплаты_ПослеОбработки(ПРО, Отказ, Объект, ОбъектМетаданных, Получатели, Выгрузка)
	Владелец = Объект.Владелец;
	Если ЗначениеЗаполнено(Владелец)
		И ОбщегоНазначения.СсылкаСуществует(Владелец) Тогда
		
		Получатели = ОпределитьПолучателей(Владелец.ПолучитьОбъект(), "АвтономнаяРабота");
		
		Если Не Выгрузка Тогда
			ПредыдущийВладелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "Владелец");
			Если (Владелец <> ПредыдущийВладелец) И ЗначениеЗаполнено(ПредыдущийВладелец) И ОбщегоНазначения.СсылкаСуществует(ПредыдущийВладелец)  Тогда
				ПредыдущиеПолучатели = ОпределитьПолучателей(ПредыдущийВладелец.ПолучитьОбъект(), "АвтономнаяРабота");
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Получатели, ПредыдущиеПолучатели, Истина);
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;
КонецПроцедуры
