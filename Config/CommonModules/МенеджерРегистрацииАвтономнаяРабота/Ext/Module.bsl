	ИспользоватьКэш  = Ложь;
	ЗначениеДоступа = Объект.ЗначениеДоступа;
	ПолучателиЗначенияДоступа = Новый Массив;
	
	ТипЗначениеДоступа = ТипЗнч(ЗначениеДоступа);
	
	Если ЗначениеЗаполнено(ЗначениеДоступа)
		И ОбщегоНазначения.ЭтоСсылка(ТипЗначениеДоступа)
		И Не Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначениеДоступа)
		И ОбщегоНазначения.СсылкаСуществует(ЗначениеДоступа) Тогда
		ПолучателиЗначенияДоступа = ОпределитьПолучателей(ЗначениеДоступа.ПолучитьОбъект(), "АвтономнаяРабота");
	КонецЕсли;
	
	ЗначениеОбъект = Объект.Объект;
	ПолучателиЗначенияОбъекта = Новый Массив;
	ТипЗначениеОбъекта = ТипЗнч(ЗначениеОбъект);
	Если ЗначениеЗаполнено(ЗначениеОбъект)
		И ОбщегоНазначения.ЭтоСсылка(ТипЗначениеОбъекта)
		И Не Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначениеОбъекта)
		И ОбщегоНазначения.СсылкаСуществует(ЗначениеОбъект) Тогда
		ПолучателиЗначенияОбъекта = ОпределитьПолучателей(ЗначениеОбъект.ПолучитьОбъект(), "АвтономнаяРабота");
	КонецЕсли;
	
	Получатели = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Получатели, ПолучателиЗначенияДоступа, Истина);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Получатели, ПолучателиЗначенияОбъекта, Истина);
	
	Если Получатели.Количество()>0 Тогда
		ПараметрыЗапроса.Вставить("Получатели", ?(ЗначениеЗаполнено(Получатели),Получатели, Новый Массив));
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.АвтономнаяРабота КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		| ПланОбменаОсновнаяТаблица.Ссылка В (&СвойствоОбъекта_Получатели)";	
	КонецЕсли;
КонецПроцедуры
