	ИспользоватьКэш  = Ложь;
	СсылкаНаДокументОснование = Объект.ДокументОснование;
	
	Если ЗначениеЗаполнено(СсылкаНаДокументОснование)
		И ОбщегоНазначения.СсылкаСуществует(СсылкаНаДокументОснование) Тогда
		
		МетаданныеСсылки = СсылкаНаДокументОснование.Метаданные();
		ПланОбменаСодержитОбъект = Метаданные.ПланыОбмена.АвтономнаяРабота.Состав.Найти(МетаданныеСсылки) <> Неопределено;
		
		Если ПланОбменаСодержитОбъект Тогда
			
			Получатели = ОпределитьПолучателей(СсылкаНаДокументОснование.ПолучитьОбъект(), "АвтономнаяРабота");
			ПараметрыЗапроса.Вставить("Получатели", ?(ЗначениеЗаполнено(Получатели),Получатели, Новый Массив));
			ТекстЗапроса = "
			|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
			|ИЗ
			|	ПланОбмена.АвтономнаяРабота КАК ПланОбменаОсновнаяТаблица
			|ГДЕ
			| ПланОбменаОсновнаяТаблица.Ссылка В (&СвойствоОбъекта_Получатели)";	
			
		Иначе
			
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры
