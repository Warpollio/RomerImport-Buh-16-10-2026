Процедура ПРО_РегистрСведений_ЭлектронныеПодписиМЧД_ПриОбработке(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, Выгрузка, ДополнительныеСвойства)
	ИспользоватьКэш  = Ложь;
	ПодписанныйОбъект = Объект.ПодписанныйОбъект;
	
	Если ЗначениеЗаполнено(ПодписанныйОбъект)
		И ОбщегоНазначения.СсылкаСуществует(ПодписанныйОбъект) Тогда
		Получатели = ОпределитьПолучателей(ПодписанныйОбъект.ПолучитьОбъект(), "АвтономнаяРабота");
		ПараметрыЗапроса.Вставить("Получатели", ?(ЗначениеЗаполнено(Получатели),Получатели, Новый Массив));
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.АвтономнаяРабота КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		| ПланОбменаОсновнаяТаблица.Ссылка В (&СвойствоОбъекта_Получатели)";	
	КонецЕсли;
КонецПроцедуры
