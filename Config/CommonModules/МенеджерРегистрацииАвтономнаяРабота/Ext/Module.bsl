	ОбъектСклонения = Объект.Объект;
	
	ТипОбъектСклонения = ТипЗнч(ОбъектСклонения);
	
	Если ЗначениеЗаполнено(ОбъектСклонения)
		И ОбщегоНазначения.ЭтоСсылка(ТипОбъектСклонения)
		И Не Перечисления.ТипВсеСсылки().СодержитТип(ТипОбъектСклонения)
		И ОбщегоНазначения.СсылкаСуществует(ОбъектСклонения) Тогда
		Получатели = ОпределитьПолучателей(ОбъектСклонения.ПолучитьОбъект(), "АвтономнаяРабота");
		ПараметрыЗапроса.Вставить("Получатели", ?(ЗначениеЗаполнено(Получатели),Получатели, Новый Массив));
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|	ПланОбмена.АвтономнаяРабота КАК ПланОбменаОсновнаяТаблица
		|ГДЕ
		| ПланОбменаОсновнаяТаблица.Ссылка В (&СвойствоОбъекта_Получатели)";	
	КонецЕсли;
КонецПроцедуры
