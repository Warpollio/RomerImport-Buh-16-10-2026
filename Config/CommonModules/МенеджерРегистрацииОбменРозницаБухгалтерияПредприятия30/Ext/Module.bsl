Процедура ПРО_Документ_ПоступлениеНаРасчетныйСчет_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка)
	Если Объект.РасшифровкаПлатежа.Количество() > 0 Тогда
		ПерваяСтрокаРасшифровкиПлатежа = Объект.РасшифровкаПлатежа[0];
		ДокументСделка = ПерваяСтрокаРасшифровкиПлатежа.Сделка;
	
		Если НЕ ЗначениеЗаполнено(ДокументСделка) ИЛИ
			 (ТипЗнч(ДокументСделка) <> Тип("ДокументСсылка.СписаниеСРасчетногоСчета")) ИЛИ
			 (ТипЗнч(Объект.Контрагент) <> Тип("СправочникСсылка.Контрагенты")) Тогда
			Отказ = Истина;
		Иначе
			ПерваяСтрокаРасшифровкиПлатежаОснования = ДокументСделка.РасшифровкаПлатежа[0];
			Если Не ЗначениеЗаполнено(ПерваяСтрокаРасшифровкиПлатежаОснования.Сделка) ИЛИ
			 	ТипЗнч(ПерваяСтрокаРасшифровкиПлатежаОснования.Сделка) <> Тип("ДокументСсылка.ПоступлениеТоваровУслуг") Тогда
				Отказ = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры
