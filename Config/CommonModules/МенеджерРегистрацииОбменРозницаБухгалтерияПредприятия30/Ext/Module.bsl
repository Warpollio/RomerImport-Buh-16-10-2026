Процедура ДобавитьПРО_Документ_ПоступлениеНаРасчетныйСчет(ПравилаРегистрацииОбъектов, ИмяМенеджераРегистрации)
	НовоеПравило = ПравилаРегистрацииОбъектов.Добавить();
	
	НовоеПравило.ИмяМенеджераРегистрации = ИмяМенеджераРегистрации; 
	НовоеПравило.Идентификатор = "Документ_ПоступлениеНаРасчетныйСчет";
	
	НовоеПравило.ОбъектМетаданныхИмя = "Документ.ПоступлениеНаРасчетныйСчет";
	НовоеПравило.ИмяПланаОбмена = "ОбменРозницаБухгалтерияПредприятия30";
	НовоеПравило.ИмяРеквизитаФлага = "";	
	НовоеПравило.ПравилоПоСвойствамОбъектаПустое = Ложь; 
	НовоеПравило.ПакетноеВыполнениеОбработчиков = Ложь;
	НовоеПравило.ЕстьОбработчикПередОбработкой = Истина;
	НовоеПравило.ЕстьОбработчикПриОбработке = Ложь;
	НовоеПравило.ЕстьОбработчикПриОбработкеДополнительный = Ложь;
	НовоеПравило.ЕстьОбработчикПослеОбработки = Ложь;
		
	УстановитьОтборы(НовоеПравило, 
		Документ_ПоступлениеНаРасчетныйСчет_ОтборПоСвойствамПланаОбмена(),
		Документ_ПоступлениеНаРасчетныйСчет_ОтборПоСвойствамОбъекта());
