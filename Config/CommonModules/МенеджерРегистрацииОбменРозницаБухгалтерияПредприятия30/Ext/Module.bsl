Процедура ПРО_Справочник_Контрагенты_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка)
	Если Объект.ЭтоГруппа Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|  ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|  ПО Контрагенты.Ссылка = ДоговорыКонтрагентов.Владелец
		|  И Контрагенты.Родитель = &Ссылка
		|ГДЕ
		|	ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)");
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда 
			Отказ = Истина;
		КонецЕсли;	                     
	Иначе	
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДоговорыКонтрагентов.Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)");
		Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда 
			Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Процедура ПРО_Справочник_Контрагенты_ПриОбработкеДополнительный(Отказ, ПРО, Объект, ТекстЗапроса, ПараметрыЗапроса, ИспользоватьКэш, ДополнительныеСвойства)
	Если НЕ Объект.ЭтоГруппа Тогда
		
		ИспользоватьКэш = Ложь;
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДоговорыКонтрагентов.Организация КАК Организация
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.Владелец = &Владелец
		|	И ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)");
		Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
		РезультатЗапросаПоДоговорам = Запрос.Выполнить();
		ПараметрыЗапроса.Вставить("ЕстьДоговораСПоставщиком", НЕ РезультатЗапросаПоДоговорам.Пустой());
		ПараметрыЗапроса.Вставить("Организации", РезультатЗапросаПоДоговорам.Выгрузить().ВыгрузитьКолонку("Организация"));
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ 
		|ПланОбменаОсновнаяТаблица.Ссылка КАК Ссылка
		|ИЗ
		|ПланОбмена.ОбменРозницаБухгалтерияПредприятия30 КАК ПланОбменаОсновнаяТаблица
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|ПланОбмена.ОбменРозницаБухгалтерияПредприятия30.Организации КАК ОрганизацииТЧ
		|ПО ПланОбменаОсновнаяТаблица.Ссылка = ОрганизацииТЧ.Ссылка
		|ГДЕ
		|ПланОбменаОсновнаяТаблица.ПередаватьНСИ
		|И (Организации.Организация В(&СвойствоОбъекта_Организации)
		|ИЛИ НЕ ПланОбменаОсновнаяТаблица.ИспользоватьОтборПоОрганизациям)
		|И &СвойствоОбъекта_ЕстьДоговораСПоставщиком
		|И НЕ ПланОбменаОсновнаяТаблица.Ссылка = &ОбменРозницаБухгалтерияПредприятия30ЭтотУзел
		|И НЕ ПланОбменаОсновнаяТаблица.ПометкаУдаления";
		
	КонецЕсли;
КонецПроцедуры

