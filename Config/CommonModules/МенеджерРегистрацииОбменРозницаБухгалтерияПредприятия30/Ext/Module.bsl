Процедура ПРО_Документ_СписаниеСРасчетногоСчета_ПередОбработкой(ПРО, Отказ, Объект, ОбъектМетаданных, Выгрузка)
	Если (Объект.РасшифровкаПлатежа.Количество() = 0) ИЛИ 
		(Не ЗначениеЗаполнено(Объект.РасшифровкаПлатежа[0].Сделка)) ИЛИ
		(ТипЗнч(Объект.РасшифровкаПлатежа[0].Сделка) <> Тип("ДокументСсылка.ПоступлениеТоваровУслуг")) ИЛИ
		(ТипЗнч(Объект.Контрагент) <> Тип("СправочникСсылка.Контрагенты")) Тогда
		Отказ = Истина;
	КонецЕсли;
