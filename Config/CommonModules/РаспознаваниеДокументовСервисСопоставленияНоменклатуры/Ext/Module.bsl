Процедура ЗапуститьАвтоматическуюСинхронизациюССервисом()

	Попытка
		ДлительнаяОперация = ДлительнаяОперацияСинхронизацииССервисом(Новый УникальныйИдентификатор, Истина);
	Исключение
		ИнформацияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбработатьОшибкуАвтоматическогоПодключения();
		ЗаписатьОшибкуАвтоматическогоПодключения(ИнформацияОбОшибке);
		Возврат;
	КонецПопытки;

	Если ДлительнаяОперация.Статус = "Выполняется" Или ФоновоеЗаданиеСинхронизацииВыполняется() Тогда
		Возврат;
	КонецЕсли;

	ИнформацияОбОшибке = "";
	ДлительнаяОперация.Свойство("ИнформацияОбОшибке", ИнформацияОбОшибке);
	Если Не ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда
		ИнформацияОбОшибке = НСтр("ru = 'Не удалось запустить фоновую синхронизацию с сервисом сопоставления.'");
	КонецЕсли;

	ОбработатьОшибкуАвтоматическогоПодключения();
	ЗаписатьОшибкуАвтоматическогоПодключения(ИнформацияОбОшибке);

КонецПроцедуры

Процедура ОбработатьОшибкуАвтоматическогоПодключения()

	Попытка
		ЗафиксироватьОшибкуПодключения();
	Исключение
		ИнформацияОбОшибкеСостояния = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписатьОшибкуАвтоматическогоПодключения(ИнформацияОбОшибкеСостояния);
	КонецПопытки;

КонецПроцедуры

Функция АвтоматическоеПодключениеРазрешено()

	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояниеПовторногоПодключения();
		СостояниеПовтора = СостояниеПовторногоПодключения();
		ТекущаяДата = ТекущаяДатаСеанса();

		Если СостояниеПовтора.ДатаСледующейАвтоматическойПопытки > ТекущаяДата Тогда
			ЗафиксироватьТранзакцию();
			Если Не ПривилегированныйРежимБылУстановлен Тогда
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;

		// Резервируем окно до запуска задания. Это защищает от нескольких форм и от аварийного
		// завершения сеанса между проверкой состояния и созданием фонового задания.
		НомерПопытки = СостояниеПовтора.КоличествоОшибок + 1;
		СостояниеПовтора.ДатаПоследнейПопытки = ТекущаяДата;
		СостояниеПовтора.ДатаСледующейАвтоматическойПопытки =
			ТекущаяДата + ИнтервалПовтораПодключения(НомерПопытки);
		ЗаписатьСостояниеПовторногоПодключения(СостояниеПовтора);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Возврат Истина;

КонецФункции

Процедура ЗафиксироватьОшибкуПодключения()

	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояниеПовторногоПодключения();

		// Политику перечитываем после блокировки: параллельное отключение автоподключения
		// должно победить запись ошибки уже запущенного фонового задания.
		НастройкиСервиса = ТекущиеНастройкиСервиса();
		Если Не СервисДоступен(НастройкиСервиса)
			Или Не ТребуетсяАвтоматическоеПодключение(НастройкиСервиса) Тогда
			ОбщегоНазначенияБП.УдалитьДанныеИзХранилища(ВладелецСостоянияПовторногоПодключения());
			ЗафиксироватьТранзакцию();
			Если Не ПривилегированныйРежимБылУстановлен Тогда
				УстановитьПривилегированныйРежим(Ложь);
			КонецЕсли;
			Возврат;
		КонецЕсли;

		СостояниеПовтора = СостояниеПовторногоПодключения();
		СостояниеПовтора.КоличествоОшибок = СостояниеПовтора.КоличествоОшибок + 1;
		СостояниеПовтора.ДатаПоследнейПопытки = ТекущаяДатаСеанса();
		СостояниеПовтора.ДатаСледующейАвтоматическойПопытки =
			СостояниеПовтора.ДатаПоследнейПопытки
			+ ИнтервалПовтораПодключения(СостояниеПовтора.КоличествоОшибок);
		ЗаписатьСостояниеПовторногоПодключения(СостояниеПовтора);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

Процедура СброситьСостояниеПовторногоПодключения()

	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСостояниеПовторногоПодключения();
		ОбщегоНазначенияБП.УдалитьДанныеИзХранилища(ВладелецСостоянияПовторногоПодключения());
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

Функция СостояниеПовторногоПодключения()

	СостояниеПовтора = НовоеСостояниеПовторногоПодключения();
	СохраненноеСостояние = ОбщегоНазначенияБП.ПрочитатьДанныеИзХранилища(
		ВладелецСостоянияПовторногоПодключения(), КлючСостоянияПовторногоПодключения());
	Если ТипЗнч(СохраненноеСостояние) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(СостояниеПовтора, СохраненноеСостояние);
	КонецЕсли;

	Возврат СостояниеПовтора;

КонецФункции

Процедура ЗаписатьСостояниеПовторногоПодключения(СостояниеПовтора)

	ОбщегоНазначенияБП.ЗаписатьДанныеВХранилище(ВладелецСостоянияПовторногоПодключения(), СостояниеПовтора,
		КлючСостоянияПовторногоПодключения());

КонецПроцедуры

Процедура ЗаблокироватьСостояниеПовторногоПодключения()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ХранилищеДанных");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Владелец", ВладелецСостоянияПовторногоПодключения());
	Попытка
		Блокировка.Заблокировать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

Процедура ЗаблокироватьНастройкиСервиса()

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ХранилищеДанных");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Владелец", ВладелецХранилищаДанных());
