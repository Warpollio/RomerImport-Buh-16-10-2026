
#Область СлужебныйПрограммныйИнтерфейс

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт

	Методы.Вставить("СинхронизацияССервисом", Истина);
	Методы.Вставить("СинхронизацияССервисомАвтоматически", Истина);
	Методы.Вставить("ПередатьПодготовленнуюОбратнуюСвязь", Истина);

КонецПроцедуры

// Проверяет использование сервиса
//
// Возвращаемое значение:
//  Булево - признак использования сервиса
//
Функция СервисИспользуется() Экспорт

	НастройкиСервиса = ТекущиеНастройкиСервиса();
	Возврат СервисДоступен(НастройкиСервиса) И НастройкиСервиса.СервисИспользуется;

КонецФункции

// Возвращает состояние настройки использования сервиса сопоставления номенклатуры.
//
// Возвращаемое значение:
//  Структура:
//   * ИспользоватьСервис - Неопределено, Булево - значение настройки для отображения пользователю;
//   * СервисДоступен - Булево - признак получения допустимого режима NSM;
//   * ПользовательМожетИзменять - Булево - возможность самостоятельно изменить настройку.
//
Функция СостояниеНастройкиИспользованияСервиса() Экспорт

	НастройкиСервиса = ТекущиеНастройкиСервиса();
	Доступен = СервисДоступен(НастройкиСервиса);
	Если Доступен Тогда
		ИспользоватьСервис = ТребуетсяИспользоватьСервис(НастройкиСервиса);
	Иначе
		ИспользоватьСервис = НастройкиСервиса.СервисИспользуется;
	КонецЕсли;
	ПользовательМожетИзменять = Доступен
		И Не ПринудительныйРежимСервиса(НастройкиСервиса.РежимСервиса);

	Возврат Новый Структура("ИспользоватьСервис, СервисДоступен, ПользовательМожетИзменять",
		ИспользоватьСервис, Доступен, ПользовательМожетИзменять);

КонецФункции

// Применяет режим использования NSM, полученный от сервиса.
//
// Параметры:
//  РежимСервиса - Строка - одно из значений ALLOW, DISALLOW, FORCEENABLE, FORCEDISABLE.
//
Процедура ОбработатьРежимСервиса(РежимСервиса) Экспорт

	РежимСервиса = НормализованныйРежимСервиса(РежимСервиса);
	Если РежимСервиса = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНастройкиСервиса();
		НастройкиСервиса = ТекущиеНастройкиСервиса();
		РезультатИзменения = РассчитатьНастройкиПоРежиму(НастройкиСервиса, РежимСервиса);
		Если РезультатИзменения.НастройкиИзменены Тогда
			ОбновитьНастройкиСервиса(НастройкиСервиса);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если РезультатИзменения.НастройкиИзменены Тогда
		СброситьСостояниеПовторногоПодключения();
	КонецЕсли;

	Если Не ТребуетсяИспользоватьСервис(НастройкиСервиса) Тогда
		ОтменитьСинхронизациюССервисомВнутр();
	ИначеЕсли РезультатИзменения.ТребуетсяСинхронизация И Не ВыполняетсяПодключениеКСервису()
		И АвтоматическоеПодключениеРазрешено() Тогда
		ЗапуститьАвтоматическуюСинхронизациюССервисом();
	КонецЕсли;

КонецПроцедуры

// Рассчитывает состояние настроек после получения режима NSM.
//
// Параметры:
//  НастройкиСервиса - см. НовыеНастройкиСервиса.
//  РежимСервиса - Строка - одно из значений ALLOW, DISALLOW, FORCEENABLE, FORCEDISABLE.
//
// Возвращаемое значение:
//  Структура:
//   * НастройкиИзменены - Булево - признак изменения настроек.
//   * ТребуетсяСинхронизация - Булево - признак необходимости включить NSM после полной синхронизации.
//
Функция РассчитатьНастройкиПоРежиму(НастройкиСервиса, РежимСервиса) Экспорт

	РежимСервиса = НормализованныйРежимСервиса(РежимСервиса);
	Если РежимСервиса = Неопределено Тогда
		Возврат Новый Структура("НастройкиИзменены, ТребуетсяСинхронизация", Ложь, Ложь);
	КонецЕсли;

	НастройкиДоИзменения = ЗначениеВСтрокуВнутр(НастройкиСервиса);

	// Правила переходов между режимами NSM:
	// - FORCEENABLE и FORCEDISABLE задают обязательное состояние и не изменяют ПользовательскийВыбор;
	// - при ALLOW и DISALLOW применяется ПользовательскийВыбор, а если его нет, используются значения
	//   по умолчанию: ALLOW - включено, DISALLOW - выключено;
	// - после выхода из принудительного режима восстанавливается сохраненный выбор пользователя;
	// - переход к выключенному состоянию немедленно выключает NSM и отменяет текущую синхронизацию;
	// - переход к включенному состоянию оставляет NSM выключенным до полной регистрации и синхронизации
	//   номенклатуры; фактическое включение выполняется только после успешного завершения;
	// - повторное получение включающего режима не запускает полную синхронизацию, если NSM уже включен.
	НастройкиСервиса.РежимСервиса = РежимСервиса;

	ИспользоватьСервис = ТребуетсяИспользоватьСервис(НастройкиСервиса);
	Если Не ИспользоватьСервис Тогда
		НастройкиСервиса.СервисИспользуется = Ложь;
	КонецЕсли;
	ТребуетсяСинхронизация = ИспользоватьСервис И Не НастройкиСервиса.СервисИспользуется;
	НастройкиИзменены = НастройкиДоИзменения <> ЗначениеВСтрокуВнутр(НастройкиСервиса);

	Возврат Новый Структура("НастройкиИзменены, ТребуетсяСинхронизация",
		НастройкиИзменены, ТребуетсяСинхронизация);

КонецФункции

// Рассчитывает состояние настроек после самостоятельного действия пользователя.
//
// Параметры:
//  НастройкиСервиса - см. НовыеНастройкиСервиса.
//  ИспользоватьСервис - Булево - выбранное пользователем состояние NSM.
//
// Возвращаемое значение:
//  Структура:
//   * НастройкиИзменены - Булево - признак изменения настроек.
//   * ТребуетсяСинхронизация - Булево - признак необходимости включить NSM после полной синхронизации.
//
Функция РассчитатьНастройкиПоВыбору(НастройкиСервиса, ИспользоватьСервис) Экспорт

	Если ПринудительныйРежимСервиса(НастройкиСервиса.РежимСервиса) Тогда
		Возврат Новый Структура("НастройкиИзменены, ТребуетсяСинхронизация", Ложь, Ложь);
	КонецЕсли;

	НастройкиДоИзменения = ЗначениеВСтрокуВнутр(НастройкиСервиса);
	НастройкиСервиса.ПользовательскийВыбор = ИспользоватьСервис;

	Если Не ИспользоватьСервис Тогда
		НастройкиСервиса.СервисИспользуется = Ложь;
	КонецЕсли;
	ТребуетсяСинхронизация = ИспользоватьСервис И Не НастройкиСервиса.СервисИспользуется;

	НастройкиИзменены = НастройкиДоИзменения <> ЗначениеВСтрокуВнутр(НастройкиСервиса);

	Возврат Новый Структура("НастройкиИзменены, ТребуетсяСинхронизация",
		НастройкиИзменены, ТребуетсяСинхронизация);

КонецФункции

// Сохраняет самостоятельный выбор пользователя.
//
// Параметры:
//  ИспользоватьСервис - Булево - выбранное пользователем состояние NSM.
//
Процедура УстановитьПользовательскийВыбор(ИспользоватьСервис) Экспорт

	ПроверитьПравоИзмененияНастроекСервиса();
	Если ТипЗнч(ИспользоватьСервис) <> Тип("Булево") Тогда
		ВызватьИсключение(НСтр("ru = 'Некорректное значение настройки использования сервиса.'"),
			КатегорияОшибки.ОшибкаКонфигурации);
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНастройкиСервиса();
		НастройкиСервиса = ТекущиеНастройкиСервиса();
		Если ПринудительныйРежимСервиса(НастройкиСервиса.РежимСервиса) Тогда
			ВызватьИсключение(НСтр(
				"ru = 'В принудительном режиме изменить использование сервиса сопоставления нельзя.'"),
				КатегорияОшибки.ОшибкаКонфигурации);
		КонецЕсли;
		РассчитатьНастройкиПоВыбору(НастройкиСервиса, ИспользоватьСервис);
		ОбновитьНастройкиСервиса(НастройкиСервиса);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если Не ИспользоватьСервис Тогда
		СброситьСостояниеПовторногоПодключения();
		ОтменитьСинхронизациюССервисомВнутр();
	КонецЕсли;

КонецПроцедуры

// Сбрасывает сохраненный выбор пользователя при неудачной ручной попытке включения сервиса.
//
// В принудительном режиме выбор пользователя не сохраняется и не сбрасывается — метод бездействует.
// Вызывается после завершения фоновой синхронизации со сбоем, чтобы согласовать отображаемое
// состояние галочки с фактическим (СервисИспользуется = Ложь).
Процедура СброситьВыборПользователяПриСбоеПодключения() Экспорт

	ПроверитьПравоИзмененияНастроекСервиса();

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНастройкиСервиса();
		НастройкиСервиса = ТекущиеНастройкиСервиса();
		Если Не ПринудительныйРежимСервиса(НастройкиСервиса.РежимСервиса)
			И НастройкиСервиса.ПользовательскийВыбор = Истина Тогда
			НастройкиСервиса.ПользовательскийВыбор = Ложь;
			ОбновитьНастройкиСервиса(НастройкиСервиса);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

// Отключает сервис сопоставления номенклатуры при смене или удалении токена авторизации OCR.
//
// Вызывается из точек изменения авторизации (УдалитьДанныеАвторизации, ВыполнитьАвторизацию*)
// до восстановления привилегированного режима. Сбрасывает только фактическое состояние
// СервисИспользуется, сохраняя ПользовательскийВыбор и РежимСервиса: при следующем успешном
// расчете состояний по балансу режим переприменится, а при наличии выбора пользователя
// запустится автоматическая синхронизация уже под новым токеном.
Процедура ОтключитьСервисПриСменеАвторизации() Экспорт

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНастройкиСервиса();
		НастройкиСервиса = ТекущиеНастройкиСервиса();
		НастройкиИзменены = Ложь;
		Если НастройкиСервиса.СервисИспользуется Тогда
			НастройкиСервиса.СервисИспользуется = Ложь;
			НастройкиИзменены = Истина;
		КонецЕсли;
		Если Не ПринудительныйРежимСервиса(НастройкиСервиса.РежимСервиса)
			И НастройкиСервиса.ПользовательскийВыбор <> Ложь Тогда
			НастройкиСервиса.ПользовательскийВыбор = Ложь;
			НастройкиИзменены = Истина;
		КонецЕсли;
		Если НастройкиИзменены Тогда
			ОбновитьНастройкиСервиса(НастройкиСервиса);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ОтменитьСинхронизациюССервисомВнутр();
	СброситьСостояниеПовторногоПодключения();

КонецПроцедуры

// Возвращает описание причины, по которой синхронизацию с сервисом нельзя запускать.
//
// Возвращаемое значение:
//  Строка - описание причины; пустая строка, если синхронизацию можно запускать.
//
Функция ОписаниеОшибкиУсловийСинхронизацииССервисом() Экспорт

	Если Не Константы.ИспользоватьРаспознаваниеДокументов.Получить() Тогда
		Возврат НСтр("ru = 'Распознавание документов отключено.'");
	КонецЕсли;

	НастройкиСервиса = ТекущиеНастройкиСервиса();
	Если Не СервисДоступен(НастройкиСервиса) Тогда
		Возврат НСтр("ru = 'Сервис сопоставления номенклатуры недоступен.'");
	ИначеЕсли НастройкиСервиса.РежимСервиса = "FORCEDISABLE" Тогда
		Возврат НСтр("ru = 'Сервис сопоставления номенклатуры принудительно отключен.'");
	ИначеЕсли Не ТребуетсяИспользоватьСервис(НастройкиСервиса) Тогда
		Возврат НСтр("ru = 'Использование сервиса сопоставления номенклатуры отключено.'");
	КонецЕсли;

	Возврат "";

КонецФункции

// Синхронизация с сервисом сопоставления
//
// Возвращаемое значение:
//  Булево - синхронизация прошла успешно
//
Функция СинхронизацияССервисом() Экспорт

	Возврат ВыполнитьСинхронизациюССервисом(Ложь);

КонецФункции

// Выполняет автоматическую синхронизацию с сервисом сопоставления.
// Служебная точка входа для фонового задания автоматического подключения.
//
// Возвращаемое значение:
//  Булево - синхронизация прошла успешно.
//
Функция СинхронизацияССервисомАвтоматически() Экспорт

	Возврат ВыполнитьСинхронизациюССервисом(Истина);

КонецФункции

// Запускает синхронизацию с сервисом сопоставления в фоновом задании.
//
// Параметры:
//  УникальныйИдентификатор - УникальныйИдентификатор - идентификатор формы длительной операции.
//  АвтоматическийЗапуск - Булево - Истина для автоматического подключения с учетом retry-state.
//
// Возвращаемое значение:
//  см. ДлительныеОперацииКлиент.НовыйРезультатДлительнойОперации.
//
Функция ДлительнаяОперацияСинхронизацииССервисом(УникальныйИдентификатор, АвтоматическийЗапуск = Ложь) Экспорт

	ПроверитьВходныеПараметрыДлительнойОперации(УникальныйИдентификатор);

	// Backoff применяется только к автоматическому запуску из обновления баланса.
	// Прямой вызов остается принудительной ручной попыткой подключения.
	ПроверитьВозможностьФоновогоЗапуска();

	НаименованиеЗадания = НСтр("ru = 'Синхронизация с сервисом сопоставления'");
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполнения.КлючФоновогоЗадания = КлючФоновогоЗаданияСинхронизации();
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	Если АвтоматическийЗапуск Тогда
		ДлительнаяОперация = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"РаспознаваниеДокументовСервисСопоставленияНоменклатуры.СинхронизацияССервисомАвтоматически");
	Иначе
		ДлительнаяОперация = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"РаспознаваниеДокументовСервисСопоставленияНоменклатуры.СинхронизацияССервисом");
	КонецЕсли;

	Если ДлительнаяОперация.Статус = "Ошибка" И ФоновоеЗаданиеСинхронизацииВыполняется() Тогда
		ДлительнаяОперация.ИнформацияОбОшибке = НСтр("ru = 'Синхронизация с сервисом уже запущена в другом сеансе.'");
		Возврат ДлительнаяОперация;
	КонецЕсли;

	Если ДлительнаяОперация.Статус <> "Выполняется"
		Или Не ЗначениеЗаполнено(ДлительнаяОперация.ИдентификаторЗадания) Тогда
		Возврат ДлительнаяОперация;
	КонецЕсли;

	ПараметрыДлительнойОперации = ОбщегоНазначения.СкопироватьРекурсивно(ДлительнаяОперация);
	ПараметрыДлительнойОперации.ИдентификаторЗадания = XMLСтрока(ПараметрыДлительнойОперации.ИдентификаторЗадания);
	ОбщегоНазначенияБП.ЗаписатьДанныеВХранилище(ВладелецХранилищаДанных(), ПараметрыДлительнойОперации,
		КлючПодключенияХранилищаДанных());

	Возврат ДлительнаяОперация;

КонецФункции

// Читает прогресс активной синхронизации с сервисом сопоставления.
//
// Параметры:
//  ИдентификаторФоновогоЗадания - УникальныйИдентификатор - идентификатор фонового задания.
//
// Возвращаемое значение:
//  Неопределено - задание не относится к активной синхронизации или прогресс еще не зарегистрирован;
//  Структура - информация о ходе выполнения, см. ДлительныеОперации.ПрочитатьПрогресс.
//
Функция ПрочитатьПрогрессСинхронизацииССервисом(Знач ИдентификаторФоновогоЗадания) Экспорт

	ПроверитьПравоИзмененияНастроекСервиса();
	ПроверитьВходныеПараметрыДлительнойОперации(ИдентификаторФоновогоЗадания);

	Для Каждого ФоновоеЗадание Из АктивныеФоновыеЗаданияСинхронизации() Цикл
		Если ФоновоеЗадание.УникальныйИдентификатор = ИдентификаторФоновогоЗадания Тогда
			Возврат ДлительныеОперации.ПрочитатьПрогресс(ИдентификаторФоновогоЗадания);
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Отменяет активную синхронизацию с сервисом сопоставления.
//
Процедура ОтменитьСинхронизациюССервисом() Экспорт

	ПроверитьПравоИзмененияНастроекСервиса();
	ОтменитьСинхронизациюССервисомВнутр();

КонецПроцедуры

Процедура ДлительнаяОперацияДеактивироватьБазуДанныхСервиса() Экспорт

	ПроверитьВозможностьФоновогоЗапуска();

	НаименованиеЗадания = НСтр("ru = 'Очистить базу данных номенклатуры сервиса сопоставления'");
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполнения.КлючФоновогоЗадания = "NSM.ДеактивацияБазыНоменклатуры";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения,
		"РаспознаваниеДокументовSDK.ДеактивироватьБазуДанныхНоменклатурыСервисаСопоставления");

КонецПроцедуры

// Создает записи регистра сведений "Сопоставление номенклатуры (NSM)"
//
// Параметры:
//  ВыводПрогресса - Структура:
//   *ВсегоЭлементов - Число - Количество обрабатываемых элементов
//   *ИмяШага - Строка
//
Процедура ЗарегистрироватьНоменклатуруКВыгрузке(ВыводПрогресса = Неопределено) Экспорт

	Если ЗначениеЗаполнено(ВыводПрогресса) Тогда
		ВыводПрогресса.ВсегоЭлементов = ВсегоЭлементовНоменклатуры();
		Если Не ЗначениеЗаполнено(ВыводПрогресса.ВсегоЭлементов) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПродолжатьВыгрузку = Истина;
	Номенклатура = Неопределено;

	Если ЗначениеЗаполнено(ВыводПрогресса) Тогда
		Зарегистрировано = 0;
		ДлительныеОперации.СообщитьПрогресс(0, ВыводПрогресса.ИмяШага);
	КонецЕсли;

	// Читаем из БД порционно по 100 000 записей
	Пока ПродолжатьВыгрузку Цикл

		// Запрос получает данные номенклатуры порциями для последующей
		// регистрации к выгрузке в сервис сопоставления
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100000
		|	Номенклатура.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	НЕ Номенклатура.ПометкаУдаления
		|	И НЕ Номенклатура.ЭтоГруппа
		|	И Номенклатура.Ссылка > &Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка";

		//@skip-check query-in-loop
		// Порционная выгрузка по 100000 записей для контроля памяти при больших объёмах номенклатуры
		РезультатЗапроса = Запрос.Выполнить();

		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли;

		НаборЗаписей = РегистрыСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов.СоздатьНаборЗаписей();

		Выборка = РезультатЗапроса.Выбрать();
		ЭлементовВПорции = Выборка.Количество();

		Если ЭлементовВПорции < 100000 Тогда
			ПродолжатьВыгрузку = Ложь;
		КонецЕсли;

		ДатаРегистрации = ТекущаяДатаСеанса();

		НачатьТранзакцию();

		Попытка

			Пока Выборка.Следующий() Цикл

				Запись = НаборЗаписей.Добавить();
				Запись.Номенклатура = Выборка.Ссылка;
				Запись.Период = ДатаРегистрации;
				Запись.ИдентификаторИзменения = Новый УникальныйИдентификатор;
				Номенклатура = Выборка.Ссылка;

			КонецЦикла;

			НаборЗаписей.Записать(РежимЗамещения.Слияние);

			ЗафиксироватьТранзакцию();

			Если ЗначениеЗаполнено(ВыводПрогресса) Тогда
				Зарегистрировано = Зарегистрировано + ЭлементовВПорции;
				ПроцентВыполнения = Зарегистрировано / ВыводПрогресса.ВсегоЭлементов * 100;
				ПроцентВыполнения = Окр(ПроцентВыполнения, 0);
				ДлительныеОперации.СообщитьПрогресс(Мин(99, ПроцентВыполнения), ВыводПрогресса.ИмяШага);
			КонецЕсли;

		Исключение

			ОтменитьТранзакцию();
			ИнформацияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());

			ВызватьИсключение ИнформацияОбОшибке;

		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

// Выгружает данные из р.с. "Сопоставление номенклатуры (сервис NSM)"
//
// Параметры:
//  ВыводПрогресса - Структура:
//   *ВсегоЭлементов - Число - Количество обрабатываемых элементов
//   *ИмяШага - Строка
//
Процедура ВыгрузитьНоменклатуруВСервис(ВыводПрогресса = Неопределено) Экспорт

	Если ЗначениеЗаполнено(ВыводПрогресса) Тогда
		ДлительныеОперации.СообщитьПрогресс(0, ВыводПрогресса.ИмяШага);
		Выгружено = 0;
	КонецЕсли;

	ПродолжатьВыгрузку = Истина;
	Период = '00010101';
	Номенклатура = Справочники.Номенклатура.ПустаяСсылка();

	// Читаем из БД порционно по 100 000 записей
	Пока ПродолжатьВыгрузку Цикл

		// Запрос получает данные зарегистрированной номенклатуры порциями
		// для последующей выгрузки в сервис сопоставления
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Запрос.УстановитьПараметр("ТекущаяДата", КонецДня(ТекущаяДатаСеанса()));
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100000
		|	СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура КАК Номенклатура,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура) КАК ГУИД,
		|	СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура.Наименование КАК Наименование,
		|	ПРЕДСТАВЛЕНИЕ(СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура.Родитель) КАК Категория,
		|	СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
		|	СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура.Артикул КАК Артикул,
		|	ВЫБОР
		|		КОГДА СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура.Услуга
		|			ТОГДА ""услуга""
		|		ИНАЧЕ ""товар""
		|	КОНЕЦ КАК ТипНоменклатуры,
		|	ЕСТЬNULL(СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура.ЕдиницаИзмерения.Код, """") КАК ЕдиницаИзмерения,
		|	СопоставлениеНоменклатурыРаспознаваниеДокументов.Период КАК Период,
		|	СопоставлениеНоменклатурыРаспознаваниеДокументов.ИдентификаторИзменения КАК ИдентификаторИзменения,
		|	СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	РегистрСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов КАК СопоставлениеНоменклатурыРаспознаваниеДокументов
		|ГДЕ
		|	(СопоставлениеНоменклатурыРаспознаваниеДокументов.Период > &Период
		|		ИЛИ (СопоставлениеНоменклатурыРаспознаваниеДокументов.Период = &Период
		|			И СопоставлениеНоменклатурыРаспознаваниеДокументов.Номенклатура > &Номенклатура))
		|	И СопоставлениеНоменклатурыРаспознаваниеДокументов.Период <= &ТекущаяДата
		|
		|УПОРЯДОЧИТЬ ПО
		|	СопоставлениеНоменклатурыРаспознаваниеДокументов.Период,
		|	Номенклатура";

		//@skip-check query-in-loop
		// Порционная выгрузка по 100000 записей для контроля памяти при больших объёмах номенклатуры
		РезультатЗапроса = Запрос.Выполнить();

		Если РезультатЗапроса.Пустой() Тогда
			Возврат;
		КонецЕсли;

		ВыборкаНоменклатура = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ЭлементовВПорции = ВыборкаНоменклатура.Количество();
		// Если последняя порция данных
		Если ЭлементовВПорции < 100000 Тогда
			ПродолжатьВыгрузку = Ложь;
		КонецЕсли;

		ТаблицаНоменклатуры = Новый ТаблицаЗначений;
		ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТаблицаНоменклатуры.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата", , , , ,
			Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		ТаблицаНоменклатуры.Колонки.Добавить("ИдентификаторИзменения",
			Новый ОписаниеТипов("УникальныйИдентификатор"));

		ДанныеДляОбновления = Новый Массив;
		ДанныеДляУдаления = Новый Массив;

		Пока ВыборкаНоменклатура.Следующий() Цикл

			Штрихкоды = Новый Массив;
			РаспознаваниеДокументовSDK.ПодготовитьДанныеДляСервисаСопоставления(ДанныеДляОбновления, ДанныеДляУдаления,
				ВыборкаНоменклатура, Штрихкоды);

			СтрокаТаблицы = ТаблицаНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ВыборкаНоменклатура);

			Период = ВыборкаНоменклатура.Период;
			Номенклатура = ВыборкаНоменклатура.Номенклатура;

		КонецЦикла;

		Если ЗначениеЗаполнено(ДанныеДляОбновления) Тогда
			Попытка
				РаспознаваниеДокументовSDK.ОбновитьНоменклатуруВСервисеСопоставления(ДанныеДляОбновления);
			Исключение
				ИнформацияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИмяСобытия = НСтр("ru = 'Ошибка обновления'");
				ВызватьИсключение ИмяСобытия + " " + ИнформацияОбОшибке;
			КонецПопытки;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДанныеДляУдаления) Тогда
			Попытка
				РаспознаваниеДокументовSDK.УдалитьНоменклатуруИзСервисаСопоставления(ДанныеДляУдаления);
			Исключение
				ИнформацияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ИмяСобытия = НСтр("ru = 'Ошибка удаления'");
				ВызватьИсключение ИмяСобытия + " " + ИнформацияОбОшибке;
			КонецПопытки;
		КонецЕсли;

		Если ЗначениеЗаполнено(ВыводПрогресса) Тогда
			Выгружено = Выгружено + ЭлементовВПорции;
			ПроцентВыполнения = Выгружено / ВыводПрогресса.ВсегоЭлементов * 100;
			ПроцентВыполнения = Окр(ПроцентВыполнения, 0);
			ДлительныеОперации.СообщитьПрогресс(Мин(99, ПроцентВыполнения), ВыводПрогресса.ИмяШага);
		КонецЕсли;

		Попытка
			РегистрыСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов.ОчиститьОчередьРегистрации(ТаблицаНоменклатуры);
		Исключение
			ИнформацияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ИмяСобытия = НСтр("ru = 'Ошибка очистки очереди'");
			ВызватьИсключение ИмяСобытия + " " + ИнформацияОбОшибке;
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры

//Поиск номенклатуры в сервисе NSM
//
// Параметры:
//  ДокументОбъект - ДокументОбъект.РаспознанныйДокумент
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - таблица кандидатов или Неопределено, если нет данных для поиска:
//   * Ссылка - СправочникСсылка.Номенклатура
//   * ДополнительнаяСсылка - СправочникСсылка.Номенклатура
//   * Коэффициент - Число
//
Функция КандидатыНоменклатурыДокумента(ДокументОбъект) Экспорт

	ДанныеДляПоиска = ДанныеДляПоискаВСервисе(ДокументОбъект);
	Если ДанныеДляПоиска.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат РезультатПоискаВСервисе(ДанныеДляПоиска, ДокументОбъект.ИдентификаторРезультата);

КонецФункции

//Поиск номенклатуры в сервисе NSM
//
// Параметры:
//  ПараметрыПоиска - Структура:
//  * Наименование - Строка
//  * Артикул - Строка
//
// Возвращаемое значение:
//  ТаблицаЗначений, Неопределено - таблица кандидатов или Неопределено при ошибке получения данных:
//   * Ссылка - СправочникСсылка.Номенклатура
//   * ДополнительнаяСсылка - СправочникСсылка.Номенклатура
//   * Коэффициент - Число
//
Функция ПохожиеПозицииНоменклатуры(ПараметрыПоиска) Экспорт

	Если Не ПроверитьПараметрыПоискаНоменклатуры(ПараметрыПоиска) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Идентификатор = "00000000-0000-0000-0000-000000000000";
	ДанныеДляПоиска = НоваяТаблицаДляПоиска();
	НоваяСтрока = ДанныеДляПоиска.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыПоиска);

	Возврат РезультатПоискаВСервисе(ДанныеДляПоиска, Идентификатор);

КонецФункции

// Передает обратную связь о сопоставленной номенклатуре на сервис
//
// Параметры:
//  РаспознанныйДокумент - ДокументСсылка.РаспознанныйДокумент
//
Процедура ПередатьОбратнуюСвязьВФоне(РаспознанныйДокумент) Экспорт

	Если ФоновыйЗапускНедоступен() Тогда
		ИмяСобытия = НСтр("ru = 'Синхронизация номенклатуры NSM.Обратная связь не отправлена'");
		Комментарий = НСтр("ru = 'В файловой информационной базе через внешнее соединение фоновый запуск недоступен.'");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение,
			РаспознанныйДокумент.Метаданные(), РаспознанныйДокумент, Комментарий);
		Возврат;
	КонецЕсли;

	СнимокОбратнойСвязи = СформироватьСнимокОбратнойСвязи(РаспознанныйДокумент);
	Если СнимокОбратнойСвязи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	НаименованиеЗадания = НСтр("ru = 'Передать обратную связь в сервис сопоставления'");
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполнения.КлючФоновогоЗадания = "NSM.ОбратнаяСвязь." + Строка(Новый УникальныйИдентификатор);
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;

	ДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения,
		"РаспознаваниеДокументовСервисСопоставленияНоменклатуры.ПередатьПодготовленнуюОбратнуюСвязь", СнимокОбратнойСвязи);

КонецПроцедуры

// Формирует снимок обратной связи о сопоставленной номенклатуре.
//
// Параметры:
//  РаспознанныйДокумент - ДокументСсылка.РаспознанныйДокумент
//
// Возвращаемое значение:
//  Неопределено - данные обратной связи отсутствуют.
//  Структура - снимок обратной связи:
//   * РаспознанныйДокумент - ДокументСсылка.РаспознанныйДокумент
//   * ДанныеНоменклатуры - Массив из Структура:
//      ** РаспознанныйТекст - Строка
//      ** НоменклатураДляВыбора - Массив из Строка
//      ** ВыбранныйЭлемент - Строка
//   * ИдентификаторРезультата - Строка
//
Функция СформироватьСнимокОбратнойСвязи(РаспознанныйДокумент) Экспорт

	Если ТипЗнч(РаспознанныйДокумент) = Тип("ДокументСсылка.РаспознанныйДокумент") Тогда
		СсылкаНаДокумент = РаспознанныйДокумент;
	Иначе
		СсылкаНаДокумент = РаспознанныйДокумент.Ссылка;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РаспознанныйДокументРеквизитыТабличныхЧастей.Ссылка.ИдентификаторРезультата КАК ИдентификаторРезультата,
	|	РаспознанныйДокументРеквизитыТабличныхЧастей.ТабличнаяЧасть КАК ТабличнаяЧасть,
	|	РаспознанныйДокументРеквизитыТабличныхЧастей.НомерСтрокиТЧ КАК НомерСтроки,
	|	РаспознанныйДокументРеквизитыТабличныхЧастей.РаспознанныйТекст КАК РаспознанныйТекст,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВЫРАЗИТЬ(РаспознанныйДокументРеквизитыТабличныхЧастей.Значение КАК Справочник.Номенклатура)) КАК ВыбранныйЭлемент,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ВЫРАЗИТЬ(СписокВыбораТабличныхЧастейРаспознаваниеДокументов.Значение КАК Справочник.Номенклатура)) КАК ЭлементИзСписка
	|ИЗ
	|	Документ.РаспознанныйДокумент.РеквизитыТабличныхЧастей КАК РаспознанныйДокументРеквизитыТабличныхЧастей
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СписокВыбораТабличныхЧастейРаспознаваниеДокументов КАК СписокВыбораТабличныхЧастейРаспознаваниеДокументов
	|		ПО РаспознанныйДокументРеквизитыТабличныхЧастей.Ссылка = СписокВыбораТабличныхЧастейРаспознаваниеДокументов.РаспознанныйДокумент
	|			И РаспознанныйДокументРеквизитыТабличныхЧастей.ТабличнаяЧасть = СписокВыбораТабличныхЧастейРаспознаваниеДокументов.ТабличнаяЧасть
	|			И РаспознанныйДокументРеквизитыТабличныхЧастей.НомерСтрокиТЧ = СписокВыбораТабличныхЧастейРаспознаваниеДокументов.НомерСтрокиТЧ
	|			И (СписокВыбораТабличныхЧастейРаспознаваниеДокументов.ИмяРеквизита = ""Номенклатура"")
	|ГДЕ
	|	РаспознанныйДокументРеквизитыТабличныхЧастей.Ссылка = &РаспознанныйДокумент
	|	И РаспознанныйДокументРеквизитыТабличныхЧастей.ИмяРеквизита = ""Номенклатура""
	|
	|УПОРЯДОЧИТЬ ПО
	|	РаспознанныйДокументРеквизитыТабличныхЧастей.ТабличнаяЧасть,
	|	РаспознанныйДокументРеквизитыТабличныхЧастей.НомерСтрокиТЧ";

	Запрос.УстановитьПараметр("РаспознанныйДокумент", СсылкаНаДокумент);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИдентификаторРезультата = "";
	ДанныеНоменклатуры = Новый Массив;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.СледующийПоЗначениюПоля("ТабличнаяЧасть") Цикл
		Пока Выборка.СледующийПоЗначениюПоля("НомерСтроки") Цикл

			НоменклатураДляВыбора = Новый Массив;
			Пока Выборка.Следующий() Цикл
				Если ЗначениеЗаполнено(Выборка.ЭлементИзСписка) Тогда
					НоменклатураДляВыбора.Добавить(XMLСтрока(Выборка.ЭлементИзСписка));
				КонецЕсли;
			КонецЦикла;

			СтрокаНоменклатуры = Новый Структура;
			СтрокаНоменклатуры.Вставить("РаспознанныйТекст", Выборка.РаспознанныйТекст);
			СтрокаНоменклатуры.Вставить("НоменклатураДляВыбора", НоменклатураДляВыбора);
			СтрокаНоменклатуры.Вставить("ВыбранныйЭлемент", XMLСтрока(Выборка.ВыбранныйЭлемент));

			ДанныеНоменклатуры.Добавить(СтрокаНоменклатуры);
			ИдентификаторРезультата = Выборка.ИдентификаторРезультата;

		КонецЦикла;
	КонецЦикла;

	СнимокОбратнойСвязи = Новый Структура;
	СнимокОбратнойСвязи.Вставить("РаспознанныйДокумент", СсылкаНаДокумент);
	СнимокОбратнойСвязи.Вставить("ДанныеНоменклатуры", ДанныеНоменклатуры);
	СнимокОбратнойСвязи.Вставить("ИдентификаторРезультата", ИдентификаторРезультата);
	Возврат СнимокОбратнойСвязи;

КонецФункции

// Передает подготовленный снимок обратной связи на сервис.
//
// Параметры:
//  СнимокОбратнойСвязи - Структура:
//   * РаспознанныйДокумент - ДокументСсылка.РаспознанныйДокумент
//   * ДанныеНоменклатуры - Массив из Структура:
//      ** РаспознанныйТекст - Строка
//      ** НоменклатураДляВыбора - Массив из Строка
//      ** ВыбранныйЭлемент - Строка
//   * ИдентификаторРезультата - Строка
//
Процедура ПередатьПодготовленнуюОбратнуюСвязь(СнимокОбратнойСвязи) Экспорт

	Попытка
		РаспознаваниеДокументовSDK.ПередатьОбратнуюСвязьВСервисСопоставления(СнимокОбратнойСвязи.ДанныеНоменклатуры,
			СнимокОбратнойСвязи.ИдентификаторРезультата);
	Исключение
		ИнформацияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИмяСобытия = НСтр("ru = 'Синхронизация номенклатуры NSM.Ошибка передачи обратной связи'");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,
			СнимокОбратнойСвязи.РаспознанныйДокумент.Метаданные(), СнимокОбратнойСвязи.РаспознанныйДокумент,
			ИнформацияОбОшибке);
	КонецПопытки;

КонецПроцедуры

// Передает обратную связь о сопоставленной номенклатуре на сервис.
//
// Параметры:
//  РаспознанныйДокумент - ДокументСсылка.РаспознанныйДокумент
//
Процедура ПередатьОбратнуюСвязь(РаспознанныйДокумент) Экспорт

	СнимокОбратнойСвязи = СформироватьСнимокОбратнойСвязи(РаспознанныйДокумент);
	Если СнимокОбратнойСвязи = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПередатьПодготовленнуюОбратнуюСвязь(СнимокОбратнойСвязи);

КонецПроцедуры

// Функция - Выполняется подключение к сервису сопоставления
//
// Возвращаемое значение:
//  Булево - выполняется подключение с сервису
//
Функция ВыполняетсяПодключениеКСервису() Экспорт

	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		Если ФоновоеЗаданиеСинхронизацииВыполняется() Тогда
			ЗаданиеВыполняется = Истина;
		Иначе
			ЗаданиеВыполняется = Ложь;
			ДанныеХранилища = ОбщегоНазначенияБП.ПрочитатьДанныеИзХранилища(ВладелецХранилищаДанных(),
				КлючПодключенияХранилищаДанных());
			Если Не ДанныеХранилища = Неопределено Тогда
				ДанныеЗадания = ДлительныеОперации.ЗаданиеВыполнено(
					Новый УникальныйИдентификатор(ДанныеХранилища.ИдентификаторЗадания), Истина);
				Если ДанныеЗадания.Статус = "Выполняется" Тогда
					ЗаданиеВыполняется = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Возврат ЗаданиеВыполняется;

КонецФункции

// Сохраняет новые настройки сопоставления номенклатуры
//
// Параметры:
//  НастройкиСервиса - см. НовыеНастройкиСервиса
//
Процедура ОбновитьНастройкиСервиса(НастройкиСервиса) Экспорт

	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	Попытка
		ОбщегоНазначенияБП.ЗаписатьДанныеВХранилище(ВладелецХранилищаДанных(), НастройкиСервиса,
			КлючНастроекХранилищаДанных());
	Исключение
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

// Возвращает текущие настройки сервиса
//
// Возвращаемое значение:
//  Структура:
//   * СервисИспользуется - Булево - фактическое состояние NSM.
//   * РежимСервиса - Строка, Неопределено - последний режим, полученный от сервиса.
//   * ПользовательскийВыбор - Булево, Неопределено - сохраненный выбор пользователя.
//
Функция ТекущиеНастройкиСервиса() Экспорт

	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;

	Попытка
		ТекущиеНастройки = ОбщегоНазначенияБП.ПрочитатьДанныеИзХранилища(ВладелецХранилищаДанных(),
			КлючНастроекХранилищаДанных());
	Исключение
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;

	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

	НастройкиСервиса = НовыеНастройкиСервиса();
	Если ТипЗнч(ТекущиеНастройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(НастройкиСервиса, ТекущиеНастройки);
	КонецЕсли;

	Возврат НастройкиСервиса;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОтменитьСинхронизациюССервисомВнутр()

	Для Каждого ФоновоеЗадание Из АктивныеФоновыеЗаданияСинхронизации() Цикл
		ДлительныеОперации.ОтменитьВыполнениеЗадания(ФоновоеЗадание.УникальныйИдентификатор);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьПравоИзмененияНастроекСервиса()

	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ВызватьИсключение(НСтр("ru = 'Недостаточно прав для изменения настроек сервиса сопоставления номенклатуры.'"),
			КатегорияОшибки.НарушениеПравДоступа);
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьВходныеПараметрыДлительнойОперации(УникальныйИдентификатор)

	Если ТипЗнч(УникальныйИдентификатор) <> Тип("УникальныйИдентификатор")
		Или Не ЗначениеЗаполнено(УникальныйИдентификатор) Тогда
		ВызватьИсключение(НСтр("ru = 'Некорректный идентификатор длительной операции.'"),
			КатегорияОшибки.ОшибкаКонфигурации);
	КонецЕсли;

КонецПроцедуры

Функция ВыполнитьСинхронизациюССервисом(АвтоматическийЗапуск)

	Если ЗначениеЗаполнено(ОписаниеОшибкиУсловийСинхронизацииССервисом()) Тогда
		Возврат Ложь;
	КонецЕсли;

	Синхронизировано = Ложь;
	ИмяСобытия = НСтр("ru = 'Подготовка данных'");

	Попытка

		ИмяШага = НСтр("ru = 'Шаг 1 из 3. Подготовка данных...'");
		ДлительныеОперации.СообщитьПрогресс(0, ИмяШага);

		ИмяСобытия = НСтр("ru = 'Удаление номенклатуры сервиса'");
		// Деактивация удаленной базы под текущим токеном интернет-поддержки. Сбой tolerated:
		// при смене аккаунта интернет-поддержки деактивировать нечего (база привязана к другому
		// токену), а полная повторная выгрузка ниже восстановит состояние через upsert по ГУИДу
		// номенклатуры. Полный HTTP-ответ уже сохранен в ЖР модулем РаспознаваниеДокументовHTTP
		// под событием "РаспознаваниеДокументов.HTTP".
		Попытка
			РаспознаваниеДокументовSDK.ДеактивироватьБазуДанныхНоменклатурыСервисаСопоставления();
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Синхронизация номенклатуры NSM.Удаление номенклатуры сервиса'"),
				УровеньЖурналаРегистрации.Предупреждение, , ,
				НСтр("ru = 'Сбой деактивации базы номенклатуры сервиса. Синхронизация продолжена.'"));
		КонецПопытки;
		ДлительныеОперации.СообщитьПрогресс(50, ИмяШага);

		ИмяСобытия = НСтр("ru = 'Очистка очереди регистрации'");
		РегистрыСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов.ОчиститьОчередьРегистрации();
		ДлительныеОперации.СообщитьПрогресс(99, ИмяШага);

		ИмяСобытия = НСтр("ru = 'Регистрация номенклатуры'");
		ИмяШага = НСтр("ru = 'Шаг 2 из 3. Регистрация номенклатуры...'");
		ВыводПрогресса = Новый Структура("ВсегоЭлементов, ИмяШага", 0, ИмяШага);
		ЗарегистрироватьНоменклатуруКВыгрузке(ВыводПрогресса);

		ИмяСобытия = НСтр("ru = 'Выгрузка номенклатуры'");
		ИмяШага = НСтр("ru = 'Шаг 3 из 3. Синхронизация с сервисом...'");
		ВыводПрогресса.Вставить("ИмяШага", ИмяШага);
		ВыгрузитьНоменклатуруВСервис(ВыводПрогресса);

		Если Не ЗначениеЗаполнено(ОписаниеОшибкиУсловийСинхронизацииССервисом()) Тогда
			Синхронизировано = ЗавершитьУспешнуюСинхронизацию();
			Если Синхронизировано Тогда
				СброситьСостояниеПовторногоПодключения();
			КонецЕсли;
		КонецЕсли;

	Исключение

		Синхронизировано = Ложь;
		ИнформацияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Если АвтоматическийЗапуск Тогда
			ОбработатьОшибкуАвтоматическогоПодключения();
		КонецЕсли;
		ИмяСобытия = НСтр("ru = 'Синхронизация номенклатуры NSM.'") + ИмяСобытия;
		ЗаписьЖурналаРегистрации(ИмяСобытия , УровеньЖурналаРегистрации.Ошибка, , , ИнформацияОбОшибке);

	КонецПопытки;

	Возврат Синхронизировано;

КонецФункции

