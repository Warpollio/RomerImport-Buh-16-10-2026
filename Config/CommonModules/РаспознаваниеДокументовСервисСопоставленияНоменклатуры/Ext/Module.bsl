#Область ОбработчикиПодписокНаСобытия

// Обработчик подписки ПередЗаписьюНоменклатурыСервисNSM, проверяет
// изменение ключевых реквизитов справочника "Номенклатура",
// если изменения найдены, тогда фиксируется необходимость регистрации изменений
// в регистре сведений "Сопоставление номенклатуры (сервис NSM)".
//
// Параметры:
//  Источник - СправочникОбъект.Номенклатура.
//
//  Отказ - Булево - параметр, передаваемый в подписку на событие ПередЗаписью.
//
Процедура ПередЗаписьюНоменклатурыПередЗаписью(Источник, Отказ) Экспорт

	Если Не СервисИспользуется()
		И Не ВыполняетсяПодключениеКСервису() Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ЭтоГруппа Тогда
		Если Не Источник.ЭтоНовый()
			И ИзмененоЗначениеРеквизита(Источник, "Наименование") Тогда
			Источник.ДополнительныеСвойства.Вставить("РегистрироватьЭлементыНоменклатурыГруппы", Истина);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Источник.Наименование) Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ЭтоНовый() Или ИзмененыКлючевыеРеквизитыНомеклатуры(Источник) Тогда
		Источник.ДополнительныеСвойства.Вставить("РегистрироватьИзменениеНоменклатуры", Истина);
	КонецЕсли;

КонецПроцедуры

// Обработчик подписки ПриЗаписиНоменклатурыСервисNSM создает записи
// в регистре сведений "Сопоставление номенклатуры (сервис NSM)"
//
// Параметры:
//  Источник - СправочникОбъект.Номенклатура.
//
//  Отказ - Булево - параметр, передаваемый в подписку на событие ПередЗаписью.
//
Процедура ПриЗаписиНоменклатурыПриЗаписи(Источник, Отказ) Экспорт

	Если Источник.ДополнительныеСвойства.Свойство("РегистрироватьИзменениеНоменклатуры") Тогда
		УстановитьПривилегированныйРежим(Истина);
		РегистрыСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов.ЗарегистрироватьИзменениеНоменклатуры(
			Источник.Ссылка, Отказ);
	ИначеЕсли Источник.ДополнительныеСвойства.Свойство("РегистрироватьЭлементыНоменклатурыГруппы") Тогда
		УстановитьПривилегированныйРежим(Истина);
		ЗарегистрироватьЭлементыНоменклатурыГруппы(Источник.Ссылка, Отказ);
	КонецЕсли;

КонецПроцедуры

// Обработчик подписки ПередЗаписьюЕдиницыИзмеренияСервисNSM проверяет изменение кода единицы измерения.
//
// Параметры:
//  Источник - СправочникОбъект.КлассификаторЕдиницИзмерения - записываемая единица измерения.
//  Отказ - Булево - параметр, передаваемый в подписку на событие ПередЗаписью.
//
Процедура ПередЗаписьюЕдиницыИзмеренияПередЗаписью(Источник, Отказ) Экспорт

	Если Источник.ЭтоНовый()
		Или (Не СервисИспользуется()
		И Не ВыполняетсяПодключениеКСервису()) Тогда
		Возврат;
	КонецЕсли;

	Если ИзмененоЗначениеРеквизита(Источник, "Код") Тогда
		Источник.ДополнительныеСвойства.Вставить("РегистрироватьИзменениеЕдиницыИзмерения", Истина);
	КонецЕсли;

КонецПроцедуры

// Обработчик подписки ПриЗаписиЕдиницыИзмеренияСервисNSM регистрирует связанную номенклатуру.
//
// Параметры:
//  Источник - СправочникОбъект.КлассификаторЕдиницИзмерения - записанная единица измерения.
//  Отказ - Булево - параметр, передаваемый в подписку на событие ПриЗаписи.
//
Процедура ПриЗаписиЕдиницыИзмеренияПриЗаписи(Источник, Отказ) Экспорт

	Если Источник.ДополнительныеСвойства.Свойство("РегистрироватьИзменениеЕдиницыИзмерения") Тогда
		УстановитьПривилегированныйРежим(Истина);
		ЗарегистрироватьНоменклатуруЕдиницыИзмерения(Источник.Ссылка, Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область РегистрацияНоменклатурыДляВыгрузкиВСервисNSM

Функция ВсегоЭлементовНоменклатуры()

	ВсегоЭлементов = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(Номенклатура.Ссылка) КАК ВсегоЭлементов
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	НЕ Номенклатура.ПометкаУдаления
	|	И НЕ Номенклатура.ЭтоГруппа";

	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	Если Выборка.Следующий() Тогда
		ВсегоЭлементов  = Выборка.ВсегоЭлементов;
	КонецЕсли;

	Возврат ВсегоЭлементов;

КонецФункции

Функция ИзмененыКлючевыеРеквизитыНомеклатуры(Номенклатура)

	РеквизитыМенялись = Ложь;

	КлючевыеРеквизиты =
		"Наименование, НаименованиеПолное, Артикул, Услуга, ЕдиницаИзмерения, Родитель, ПометкаУдаления";
	ЗначенияКлючевыхРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура.Ссылка, КлючевыеРеквизиты,
		Истина);

	// Если до и после изменения элемент остается помеченным на удаление, то делаем ранний возврат
	ПометкаУдаления = Неопределено;
	ЗначенияКлючевыхРеквизитов.Свойство("ПометкаУдаления", ПометкаУдаления);
	Если Не ПометкаУдаления = Неопределено И ПометкаУдаления И Номенклатура.ПометкаУдаления Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Каждого Реквизит Из ЗначенияКлючевыхРеквизитов Цикл
		Если Не Реквизит.Значение = Номенклатура[Реквизит.Ключ] Тогда
			РеквизитыМенялись = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат РеквизитыМенялись;

КонецФункции

Функция ИзмененоЗначениеРеквизита(Объект, ИмяРеквизита)

	СтароеЗначение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, ИмяРеквизита);

	Возврат СтароеЗначение <> Объект[ИмяРеквизита];

КонецФункции

Процедура ЗарегистрироватьЭлементыНоменклатурыГруппы(ГруппаНоменклатуры, Отказ)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ГруппаНоменклатуры", ГруппаНоменклатуры);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Родитель = &ГруппаНоменклатуры
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";

	ЗарегистрироватьРезультатЗапросаНоменклатуры(Запрос.Выполнить(), Отказ);

КонецПроцедуры

Процедура ЗарегистрироватьНоменклатуруЕдиницыИзмерения(ЕдиницаИзмерения, Отказ)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЕдиницаИзмерения", ЕдиницаИзмерения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.ЕдиницаИзмерения = &ЕдиницаИзмерения
	|	И НЕ Номенклатура.ЭтоГруппа
	|	И НЕ Номенклатура.ПометкаУдаления";

	ЗарегистрироватьРезультатЗапросаНоменклатуры(Запрос.Выполнить(), Отказ);

КонецПроцедуры

Процедура ЗарегистрироватьРезультатЗапросаНоменклатуры(РезультатЗапроса, Отказ)

	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ТаблицаНоменклатуры.Добавить().Номенклатура = Выборка.Номенклатура;

		Если ТаблицаНоменклатуры.Количество() = 100000 Тогда
			РегистрыСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов.ЗарегистрироватьИзмененияНоменклатуры(
				ТаблицаНоменклатуры, Отказ);
			ТаблицаНоменклатуры.Очистить();
		КонецЕсли;
	КонецЦикла;

	Если ТаблицаНоменклатуры.Количество() > 0 Тогда
		РегистрыСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов.ЗарегистрироватьИзмененияНоменклатуры(
			ТаблицаНоменклатуры, Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ВыгрузкаНоменклатурыВСервисNSM

Процедура ЗаполнитьТаблицуКандидатов(ДанныеДляПоиска, РезультатПоиска, КандидатыНоменклатуры)

	Для Индекс = 0 По (ДанныеДляПоиска.Количество() - 1) Цикл

		ИскомаяСтрока = ДанныеДляПоиска[Индекс];

		НайденныеКандидаты = РезультатПоиска[Индекс];
		Для Каждого НайденныйКандидат Из НайденныеКандидаты Цикл
			НоваяСтрока = КандидатыНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИскомаяСтрока, "Наименование, Артикул");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныйКандидат, "Ссылка, Коэффициент");
		КонецЦикла;

	КонецЦикла;

	КандидатыНоменклатуры.Сортировать("Коэффициент УБЫВ");

	Если КандидатыНоменклатуры.Количество() > 1000 Тогда
		КандидатыНоменклатуры.Индексы.Добавить("Наименование, Артикул");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПоискНоменклатурыВСервисеNSM

Функция ПроверитьПараметрыПоискаНоменклатуры(ПараметрыПоиска)

	Если ТипЗнч(ПараметрыПоиска) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректные параметры поиска номенклатуры.'");
	КонецЕсли;

	Наименование = Неопределено;
	Артикул = Неопределено;
	Если ПараметрыПоиска.Количество() <> 2
		Или Не ПараметрыПоиска.Свойство("Наименование", Наименование)
		Или Не ПараметрыПоиска.Свойство("Артикул", Артикул) Тогда
		ВызватьИсключение НСтр("ru = 'Некорректные параметры поиска номенклатуры.'");
	КонецЕсли;

	ПроверитьСтроковыйПараметрПоиска(Наименование, 100);
	ПроверитьСтроковыйПараметрПоиска(Артикул, 50);

	Возврат Не ПустаяСтрока(СокрЛП(Наименование)) Или Не ПустаяСтрока(СокрЛП(Артикул));

КонецФункции

Процедура ПроверитьСтроковыйПараметрПоиска(Значение, МаксимальнаяДлина)

	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		ВызватьИсключение НСтр("ru = 'Некорректные параметры поиска номенклатуры.'");
	КонецЕсли;

	Если СтрДлина(Значение) > МаксимальнаяДлина Или СодержитУправляющиеСимволы(Значение) Тогда
		ВызватьИсключение НСтр("ru = 'Некорректные параметры поиска номенклатуры.'");
	КонецЕсли;

КонецПроцедуры

Функция СодержитУправляющиеСимволы(Значение)

	Для НомерСимвола = 1 По СтрДлина(Значение) Цикл
		КодТекущегоСимвола = КодСимвола(Значение, НомерСимвола);
		Если КодТекущегоСимвола < 32
			Или (КодТекущегоСимвола >= 127 И КодТекущегоСимвола <= 159) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НоваяТаблицаКандидатов()

	ТаблицаКандидатов = Новый ТаблицаЗначений;
	ТаблицаКандидатов.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	ТаблицаКандидатов.Колонки.Добавить("Артикул", Новый ОписаниеТипов("Строка"));
	ТаблицаКандидатов.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКандидатов.Колонки.Добавить("ДополнительнаяСсылка", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаКандидатов.Колонки.Добавить("Коэффициент", Новый ОписаниеТипов("Число"));

	Возврат ТаблицаКандидатов;

КонецФункции

Функция ДанныеДляПоискаВСервисе(ДокументОбъект)

	ДанныеДляПоиска = НоваяТаблицаДляПоиска();

	НайденныеСтроки = ДокументОбъект.РеквизитыТабличныхЧастей.НайтиСтроки(Новый Структура("ИмяРеквизита", "Номенклатура"));
	Для Каждого Строка Из НайденныеСтроки Цикл

		Артикул = "";
		Отбор = Новый Структура("ИмяРеквизита, НомерСтрокиТЧ", "Артикул", Строка.НомерСтрокиТЧ);
		НайденныеСтрокиСАртикулом = ДокументОбъект.РеквизитыТабличныхЧастей.НайтиСтроки(Отбор);
		Для Каждого СтрокаАртикул Из НайденныеСтрокиСАртикулом Цикл
			Артикул = РаспознаваниеДокументовСлужебный.ИзвлечьАртикулИзСтроки(СтрокаАртикул.РаспознанныйТекст);
		КонецЦикла;

		НоваяСтрока = ДанныеДляПоиска.Добавить();
		НоваяСтрока.Наименование = Строка.РаспознанныйТекст;
		НоваяСтрока.Артикул = Артикул;

	КонецЦикла;

	ДанныеДляПоиска.Свернуть("Наименование, Артикул");

	Возврат ДанныеДляПоиска;

КонецФункции

Функция РезультатПоискаВСервисе(ДанныеДляПоиска, Идентификатор)

	Попытка
		РезультатПоиска = РаспознаваниеДокументовSDK.РезультатПоискаНоменклатурыВСервисеСопоставления(ДанныеДляПоиска,
			Идентификатор);
	Исключение
		ИнформацияОбОшибке = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИмяСобытия = НСтр("ru = 'Поиск номенклатуры NSM.Ошибка получения данных'");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, , , ИнформацияОбОшибке);
		Возврат Неопределено;
	КонецПопытки;

	КандидатыНоменклатуры = НоваяТаблицаКандидатов();
	ЗаполнитьТаблицуКандидатов(ДанныеДляПоиска, РезультатПоиска, КандидатыНоменклатуры);

	Возврат КандидатыНоменклатуры;

КонецФункции

Функция НоваяТаблицаДляПоиска()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Наименование");
	Таблица.Колонки.Добавить("Артикул");

	Возврат Таблица;

КонецФункции

#КонецОбласти

#Область НастройкиСервиса

Функция НормализованныйРежимСервиса(РежимСервиса)

	Если ТипЗнч(РежимСервиса) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;

	РежимСервиса = ВРег(СокрЛП(РежимСервиса));
	Если РежимСервиса = "ALLOW" Или РежимСервиса = "DISALLOW"
		Или РежимСервиса = "FORCEENABLE" Или РежимСервиса = "FORCEDISABLE" Тогда
		Возврат РежимСервиса;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ТребуетсяАвтоматическоеПодключение(НастройкиСервиса)

	Возврат ТребуетсяИспользоватьСервис(НастройкиСервиса)
		И Не НастройкиСервиса.СервисИспользуется;

КонецФункции

Функция ИспользоватьСервисВОбычномРежиме(НастройкиСервиса)

	Если НастройкиСервиса.РежимСервиса <> "ALLOW" И НастройкиСервиса.РежимСервиса <> "DISALLOW" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НастройкиСервиса.ПользовательскийВыбор = Неопределено Тогда
		Возврат НастройкиСервиса.РежимСервиса = "ALLOW";
	КонецЕсли;

	Возврат НастройкиСервиса.ПользовательскийВыбор;

КонецФункции

Функция ТребуетсяИспользоватьСервис(НастройкиСервиса)

	Если НастройкиСервиса.РежимСервиса = "FORCEENABLE" Тогда
		Возврат Истина;
	ИначеЕсли НастройкиСервиса.РежимСервиса = "FORCEDISABLE" Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ИспользоватьСервисВОбычномРежиме(НастройкиСервиса);

КонецФункции

Функция ПринудительныйРежимСервиса(РежимСервиса)

	Возврат РежимСервиса = "FORCEENABLE" Или РежимСервиса = "FORCEDISABLE";

КонецФункции

Функция СервисДоступен(НастройкиСервиса)

	Возврат НормализованныйРежимСервиса(НастройкиСервиса.РежимСервиса) <> Неопределено;

КонецФункции

Функция ЗавершитьУспешнуюСинхронизацию()

	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНастройкиСервиса();
		НастройкиСервиса = ТекущиеНастройкиСервиса();
		НастройкиСервиса.СервисИспользуется = ТребуетсяИспользоватьСервис(НастройкиСервиса);
		ОбновитьНастройкиСервиса(НастройкиСервиса);
		СервисИспользуется = НастройкиСервиса.СервисИспользуется;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат СервисИспользуется;

КонецФункции

// Возвращает начальные настройки сервиса сопоставления номенклатуры.
//
// Возвращаемое значение:
//  Структура:
//   * СервисИспользуется - Булево - фактическое состояние NSM.
//   * РежимСервиса - Строка, Неопределено - последний режим, полученный от сервиса.
//   * ПользовательскийВыбор - Булево, Неопределено - сохраненный выбор пользователя.
//
Функция НовыеНастройкиСервиса() Экспорт

	НастройкиСервиса = Новый Структура;
	НастройкиСервиса.Вставить("СервисИспользуется", Ложь);
	НастройкиСервиса.Вставить("РежимСервиса", Неопределено);
	НастройкиСервиса.Вставить("ПользовательскийВыбор", Неопределено);

	Возврат НастройкиСервиса;

КонецФункции

Функция НовоеСостояниеПовторногоПодключения()

	СостояниеПовтора = Новый Структура;
	СостояниеПовтора.Вставить("КоличествоОшибок", 0);
	СостояниеПовтора.Вставить("ДатаПоследнейПопытки", Дата(1, 1, 1));
	СостояниеПовтора.Вставить("ДатаСледующейАвтоматическойПопытки", Дата(1, 1, 1));

	Возврат СостояниеПовтора;

КонецФункции

#КонецОбласти

#КонецОбласти
