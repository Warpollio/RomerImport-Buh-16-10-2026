// Удаляет запрос из очереди.
// 
// Параметры:
//  Идентификатор - Строка
Процедура УдалитьЗапросИзОчереди(Идентификатор) 

	МенеджерЗаписи = РегистрыСведений.Отчетность24БРОЗапросы.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Идентификатор = Идентификатор;
	МенеджерЗаписи.Удалить();
	
КонецПроцедуры

// Удаляет версию из наименования конфигурации.
// 
// Параметры:
//  Наименование - Строка - Наименование
// 
// Возвращаемое значение:
//  Строка
Функция УдалитьВерсиюИзНаименованияКонфигурации(Наименование)
	
	МассивЧастей = СтрРазделить(Наименование, " ");  
	
	Если МассивЧастей.Количество() = 1 Тогда
		Возврат Наименование;
	КонецЕсли;
	
	ПоследнееСлово = МассивЧастей[МассивЧастей.ВГраница()];
	ВключаетНомерРедакции = Истина;
	Для НомерСимвола = 1 По СтрДлина(ПоследнееСлово) Цикл    
		ТекущийСимвол = Сред(ПоследнееСлово, НомерСимвола, 1);
		Если СтрНайти("0123456789.", ТекущийСимвол) = 0 Тогда 
			ВключаетНомерРедакции = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;  
	
	Если ВключаетНомерРедакции = Ложь Тогда
		Возврат Наименование;
	КонецЕсли;               
	
	МассивЧастей.Удалить(МассивЧастей.ВГраница()); 
	
	Если НРег(МассивЧастей[МассивЧастей.ВГраница()]) = "редакция" Тогда
		МассивЧастей.Удалить(МассивЧастей.ВГраница());
	КонецЕсли;   
	
	Результат = СтрСоединить(МассивЧастей, " ");
	
	Если Прав(Результат, 1) = "," Тогда
		Результат = Лев(Результат, СтрДлина(Результат) - 1);	
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Реализовано заполнение на форме.
// 
// Параметры:
//  ИДОтчета                      - Строка 
//  ИДРедакцииОтчетаДляЗаполнения - Строка 
//  ПараметрыФормированияОтчета   - Структура
// 
// Возвращаемое значение:
//  Булево
Функция РеализованоЗаполнениеНаФорме(Знач ИДОтчета, Знач ИДРедакцииОтчетаДляЗаполнения, ПараметрыФормированияОтчета)

	Показатели = Неопределено;

	ИмяФормыОтчета = ИДРедакцииОтчетаДляЗаполнения;
	ПараметрыОтчета = ОбщегоНазначения.СкопироватьРекурсивно(ПараметрыФормированияОтчета);
	
	Попытка
		НастройкиВидимости = РегламентированнаяОтчетность.НоваяСтруктураНастроекВидимостиЭлементаФормы();
		РегламентированнаяОтчетностьПереопределяемый.ПолучитьНастройкиВидимостиЭлементовФормы(
			ИДОтчета, ИмяФормыОтчета, НастройкиВидимости);

		Если НастройкиВидимости.ПостояннаяВидимость Тогда
			Показатели = НастройкиВидимости;
		Иначе

			Если СтрНачинаетсяС(ИДОтчета, "РегламентированныйОтчетБухОтчетность") Тогда
				Показатели = Истина;
			Иначе
				ОтображатьКнопкуЗаполнить = Ложь;
				Попытка
					СтруктураРеквизитовФормы = Новый Структура;
					ОтчетОбъект = Отчеты[ИДОтчета].Создать();
				//@skip-check dynamic-access-method-not-found
					ОтчетОбъект.СформироватьСтруктуруРеквизитовФормы(ИмяФормыОтчета, СтруктураРеквизитовФормы);
					ПараметрыОтчета.Вставить("СтруктураРеквизитовФормы", СтруктураРеквизитовФормы);
					СтруктураРеквизитовФормы.Свойство("ОтображатьКнопкуЗаполнить", ОтображатьКнопкуЗаполнить);
				Исключение
					ОтображатьКнопкуЗаполнить = Ложь;
				КонецПопытки;

				Если ОтображатьКнопкуЗаполнить = Истина Тогда
					Показатели = НастройкиВидимости;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Показатели = Неопределено;
	КонецПопытки;
	
	Если Показатели = Неопределено Тогда 
		Попытка
			Показатели = РегламентированнаяОтчетностьПереопределяемый.ПолучитьСведенияОПоказателяхОтчета(
					ИДОтчета, ИмяФормыОтчета, ПараметрыОтчета);
		Исключение
			Показатели = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(Показатели);
	
КонецФункции

// Возвращает значение заголовка HTTP по имени (регистронезависимый)
//
// Параметры:
//  ЗаголовкиHTTP	 - Соответствие Из КлючИЗначение:
//  * Ключ - Строка
//  * Значение - Строка
//  ИмяЗаголовка	 - Строка
// 
// Возвращаемое значение:
//   Неопределено, Строка -
Функция ЗначениеЗаголовкаHTTP(ЗаголовкиHTTP, ИмяЗаголовка)
	
	Возврат Отчетность24БРО.ЗначениеЗаголовкаHTTP(ЗаголовкиHTTP, ИмяЗаголовка);
	
КонецФункции

#Область ПодключениеКШинеОтчетности

// Записывает whitelist организаций получателя в регистр ограничения передачи данных
//
// Параметры:
//  Получатель - Строка - код получателя настройки
//  Организации - Массив Из СправочникСсылка.Организации - организации разрешенные для передачи
//
Процедура ЗаписатьОграничениеПоОрганизациям(Получатель, Организации)

	Если Не ЗначениеЗаполнено(Получатель) Или Организации = Неопределено Тогда
		Возврат;
	КонецЕсли;

	МассивОрганизаций = Новый Массив(); // см. ЗаписатьОграничениеПоОрганизациям.Организации
	Для Каждого Организация Из Организации Цикл

		Если Не ЗначениеЗаполнено(Организация) Тогда
			Продолжить;
		КонецЕсли;

		Если МассивОрганизаций.Найти(Организация) = Неопределено Тогда
			МассивОрганизаций.Добавить(Организация);
		КонецЕсли;
	КонецЦикла;

	НаборОграничений = РегистрыСведений.Отчетность24БРООграниченияПоОрганизациям.СоздатьНаборЗаписей();
	НаборОграничений.Отбор.Получатель.Установить(Получатель);
	Для Каждого Организация Из МассивОрганизаций Цикл
		НоваяЗапись = НаборОграничений.Добавить();
		НоваяЗапись.Получатель = Получатель;
		НоваяЗапись.Организация = Организация;
	КонецЦикла;
	НаборОграничений.Записать();

КонецПроцедуры

// Заполняет пользователей учетной базы для подтверждения отправки по получателю
//
// Параметры:
//  Получатель - Строка - код получателя настройки
Процедура ЗаполнитьПользователейДляПодтвержденияОтправки(Получатель)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность.Пользователь КАК Пользователь
		|ИЗ
		|	РегистрСведений.Отчетность24БРОНастройкиПодтверждения КАК
		|		НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность
		|ГДЕ
		|	НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность.РазрешеноПодтверждениеОтправки
		|	И НастройкиПодтвержденияПередачиДанныхВОблачнуюОтчетность.Получатель = &Получатель";

	Запрос.УстановитьПараметр("Получатель", Получатель);

	РезультатЗапроса = Запрос.Выполнить();

	МассивПользователей = Новый Массив(); // Массив Из ОпределяемыйТип.Пользователь
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ВыборкаПользователь = Выборка["Пользователь"]; // ОпределяемыйТип.Пользователь
		
		Если Не ЗначениеЗаполнено(ВыборкаПользователь) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеСписка = МассивПользователей.Найти(ВыборкаПользователь);
		Если ЗначениеСписка = Неопределено Тогда
			МассивПользователей.Добавить(ВыборкаПользователь);
		КонецЕсли;
		
	КонецЦикла;

	Для Каждого Пользователь Из МассивПользователей Цикл // ОпределяемыйТип.Пользователь
		ЗаписьПодтверждения = РегистрыСведений.Отчетность24БРОНастройкиПодтверждения.СоздатьМенеджерЗаписи();
		ЗаписьПодтверждения.Получатель = Получатель;
		ЗаписьПодтверждения.Пользователь = Пользователь;
		ЗаписьПодтверждения.РазрешеноПодтверждениеОтправки = Истина;
		ЗаписьПодтверждения.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// Заполняет данные ответа по справочнику средствами библиотеки, если учетное приложение
// не сформировало их самостоятельно.
//
// Параметры:
//  ИмяТипа - Строка - имя типа объекта в приложении приемнике
//  ДанныеЗапроса - Структура - данные запроса из транспортного контейнера
//  Результат - Массив Из Структура - данные ответа, заполняется в этой процедуре
//  СтандартнаяОбработка - Булево - устанавливается в Ложь, если данные сформированы
//
Процедура ЗаполнитьДанныеСправочникаПоУмолчанию(ИмяТипа, ДанныеЗапроса, Результат, СтандартнаяОбработка)

	Если ИмяТипа <> "СправочникОбъект.ФизическиеЛица"
		И ИмяТипа <> "СправочникОбъект.БанковскиеСчета" Тогда
		Возврат;
	КонецЕсли;

	Контейнер = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗапроса, "Контейнер");
	Если ТипЗнч(Контейнер) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Отборы = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Контейнер, "Данные");
	Если ТипЗнч(Отборы) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Если ИмяТипа = "СправочникОбъект.БанковскиеСчета" Тогда
			Результат = ДанныеБанковскихСчетовПоУмолчанию(Отборы);
		ИначеЕсли КадровыйУчетДоступен() Тогда
			Результат = ДанныеСотрудниковПоКадровомуУчету(Отборы);
		Иначе
			Результат = Новый Массив;
			ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Информация, , ,
				СтрШаблон(НСтр("ru='Для типа %1 данные не сформированы: в учетном приложении
					|нет библиотеки зарплаты и кадров'"), ИмяТипа));
		КонецЕсли;
	Исключение
		Результат = Новый Массив;
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Ошибка, , ,
			СтрШаблон(НСтр("ru='Для типа %1 - ошибка формирования данных ответа'"), ИмяТипа)
				+ Символы.ПС + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	СтандартнаяОбработка = Ложь;

КонецПроцедуры

// Возвращает признак того, что в конфигурации есть библиотека зарплаты и кадров.
//
// Возвращаемое значение:
//  Булево
//
Функция КадровыйУчетДоступен()

	//@skip-check bsl-legacy-check-string-literal
	Возврат ОбщегоНазначения.ПодсистемаСуществует("ЗарплатаКадрыПодсистемы")
		И Метаданные.ОбщиеМодули.Найти("КадровыйУчет") <> Неопределено
		И МетаданныеСправочникаСотрудники() <> Неопределено;

КонецФункции

// Возвращает данные сотрудников по данным кадрового учета.
//
// Параметры:
//  Отборы - Структура - отборы запроса по организациям и физическим лицам
//
// Возвращаемое значение:
//  Массив Из Структура - см. НовыеДанныеСотрудника
//
Функция ДанныеСотрудниковПоКадровомуУчету(Отборы)

	МодульКадровыйУчет = ОбщегоНазначения.ОбщийМодуль("КадровыйУчет");

	СписокОрганизаций = ЗаполненныеСсылки(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отборы, "Организации"));
	ОтборФизлиц = ЗаполненныеСсылки(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отборы, "Физлица"));

	Сотрудники = СписокСотрудниковДляОтвета(МодульКадровыйУчет, ОтборФизлиц);
	КадровыеДанные = КадровыеДанныеСотрудниковДляОтвета(МодульКадровыйУчет, Сотрудники, СписокОрганизаций);
	КадровыеДанныеПоФизлицу = СтрокиСотрудниковПоФизлицу(КадровыеДанные);
	Физлица = ФизлицаДляОтвета(КадровыеДанныеПоФизлицу, ОтборФизлиц);
	Если Физлица.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	//@skip-check dynamic-access-method-not-found
	ДанныеФизлиц = МодульКадровыйУчет.КадровыеДанныеФизическихЛиц(Истина, Физлица,
		"Фамилия, Имя, Отчество, ДатаРождения, Пол, ИНН, СтраховойНомерПФР");

	РеквизитыОрганизаций = РеквизитыОрганизацийСотрудников(КадровыеДанные);

	Результат = Новый Массив; // Массив Из Структура
	ЭлементыПоФизлицу = Новый Соответствие;

	Для Каждого СтрокаФизлица Из ДанныеФизлиц Цикл
		СтрокиСотрудников = КадровыеДанныеПоФизлицу[СтрокаФизлица.ФизическоеЛицо];

		Если СтрокиСотрудников = Неопределено Тогда
			ДанныеСотрудника = ЭлементОтветаПоСотруднику(СтрокаФизлица, Неопределено, РеквизитыОрганизаций);
			Результат.Добавить(ДанныеСотрудника);
			ДобавитьЭлементПоФизлицу(ЭлементыПоФизлицу, СтрокаФизлица.ФизическоеЛицо, ДанныеСотрудника);
			Продолжить;
		КонецЕсли;

		Для Каждого СтрокаСотрудника Из СтрокиСотрудников Цикл
			ДанныеСотрудника = ЭлементОтветаПоСотруднику(СтрокаФизлица, СтрокаСотрудника, РеквизитыОрганизаций);
			Результат.Добавить(ДанныеСотрудника);
			ДобавитьЭлементПоФизлицу(ЭлементыПоФизлицу, СтрокаФизлица.ФизическоеЛицо, ДанныеСотрудника);
		КонецЦикла;
	КонецЦикла;

	ДополнитьОтветДокументамиФизическихЛиц(МодульКадровыйУчет, ЭлементыПоФизлицу, Физлица);

	Возврат Результат;

КонецФункции

// Возвращает сотрудников по отбору физических лиц либо всех сотрудников базы.
Функция СписокСотрудниковДляОтвета(МодульКадровыйУчет, ОтборФизлиц)

	Если ОтборФизлиц.Количество() > 0 Тогда
		//@skip-check dynamic-access-method-not-found
		Возврат МодульКадровыйУчет.СотрудникиФизическихЛиц(ОтборФизлиц).ВыгрузитьКолонку("Сотрудник");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	НЕ Сотрудники.ПометкаУдаления";

	МетаданныеСотрудников = МетаданныеСправочникаСотрудники();
	Если МетаданныеСотрудников <> Неопределено
		И МетаданныеСотрудников.Реквизиты.Найти("ВАрхиве") <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НЕ Сотрудники.ВАрхиве";
	КонецЕсли;

	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Возвращает кадровые данные сотрудников, отобранные по организациям.
Функция КадровыеДанныеСотрудниковДляОтвета(МодульКадровыйУчет, Сотрудники, СписокОрганизаций)

	Если Сотрудники.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	КадровыеДанные = "ФизическоеЛицо, ГоловнаяОрганизация, ТекущаяОрганизация, ДатаПриема, ДатаУвольнения,
		|Должность, Подразделение, ОформленПоТрудовомуДоговору, ОсновноеРабочееМестоВОрганизации";

	//@skip-check dynamic-access-method-not-found
	Результат = МодульКадровыйУчет.КадровыеДанныеСотрудников(Истина, Сотрудники, КадровыеДанные);

	Если СписокОрганизаций.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ОтбираемыеОрганизации = Новый Соответствие;
	Для Каждого Организация Из СписокОрганизаций Цикл
		ОтбираемыеОрганизации.Вставить(Организация, Истина);
	КонецЦикла;

	Лишние = Новый Массив;
	Для Каждого Строка Из Результат Цикл
		Если ОтбираемыеОрганизации[Строка.ГоловнаяОрганизация] = Неопределено
			И ОтбираемыеОрганизации[Строка.ТекущаяОрганизация] = Неопределено Тогда
			Лишние.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Лишние Цикл
		Результат.Удалить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает соответствие физических лиц строкам их кадровых данных.
Функция СтрокиСотрудниковПоФизлицу(КадровыеДанные)

	Результат = Новый Соответствие;
	Если КадровыеДанные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Строка Из КадровыеДанные Цикл
		Если Не ЗначениеЗаполнено(Строка.ФизическоеЛицо) Тогда
			Продолжить;
		КонецЕсли;
		Строки = Результат[Строка.ФизическоеЛицо];
		Если Строки = Неопределено Тогда
			Строки = Новый Массив;
			Результат.Вставить(Строка.ФизическоеЛицо, Строки);
		КонецЕсли;
		Строки.Добавить(Строка);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает физические лица, по которым формируется ответ.
Функция ФизлицаДляОтвета(КадровыеДанныеПоФизлицу, ОтборФизлиц)

	Добавленные = Новый Соответствие;
	Результат = Новый Массив; // Массив Из СправочникСсылка.ФизическиеЛица

	Для Каждого Физлицо Из ОтборФизлиц Цикл
		Если Добавленные[Физлицо] = Неопределено Тогда
			Добавленные.Вставить(Физлицо, Истина);
			Результат.Добавить(Физлицо);
		КонецЕсли;
	КонецЦикла;

	Для Каждого КлючИЗначение Из КадровыеДанныеПоФизлицу Цикл
		Если Добавленные[КлючИЗначение.Ключ] = Неопределено Тогда
			Добавленные.Вставить(КлючИЗначение.Ключ, Истина);
			Результат.Добавить(КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает реквизиты организаций, встречающихся в кадровых данных, одним обращением к базе.
Функция РеквизитыОрганизацийСотрудников(КадровыеДанные)

	Организации = Новый Массив;
	Если КадровыеДанные = Неопределено Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Добавленные = Новый Соответствие;
	Для Каждого Строка Из КадровыеДанные Цикл
		Если ЗначениеЗаполнено(Строка.ГоловнаяОрганизация)
			И Добавленные[Строка.ГоловнаяОрганизация] = Неопределено Тогда
			Добавленные.Вставить(Строка.ГоловнаяОрганизация, Истина);
			Организации.Добавить(Строка.ГоловнаяОрганизация);
		КонецЕсли;
	КонецЦикла;

	Если Организации.Количество() = 0 Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Организации, "ИНН, КПП");

КонецФункции

// Возвращает элемент ответа по данным физического лица и строке сотрудника.
Функция ЭлементОтветаПоСотруднику(СтрокаФизлица, СтрокаСотрудника, РеквизитыОрганизаций)

	Результат = НовыеДанныеСотрудника();
	Результат.ИсточникGUID = ИдентификаторЗначенияОтвета(СтрокаФизлица.ФизическоеЛицо);
	Результат.Фамилия = СтрокаЗначенияОтвета(СтрокаФизлица.Фамилия);
	Результат.Имя = СтрокаЗначенияОтвета(СтрокаФизлица.Имя);
	Результат.Отчество = СтрокаЗначенияОтвета(СтрокаФизлица.Отчество);
	Результат.ИНН = СтрокаЗначенияОтвета(СтрокаФизлица.ИНН);
	Результат.СНИЛС = СтрокаЗначенияОтвета(СтрокаФизлица.СтраховойНомерПФР);
	Результат.Пол = СтрокаЗначенияОтвета(СтрокаФизлица.Пол);
	Результат.ДатаРождения = ДатаЗначенияОтвета(СтрокаФизлица.ДатаРождения);
	Результат.Документы = Новый Массив;

	Если СтрокаСотрудника = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Результат.СотрудникGUID = ИдентификаторЗначенияОтвета(СтрокаСотрудника.Сотрудник);
	Результат.СотрудникНаименование = СтрокаЗначенияОтвета(СтрокаСотрудника.Сотрудник);
	Результат.ДолжностьНаименование = СтрокаЗначенияОтвета(СтрокаСотрудника.Должность);
	Результат.ПодразделениеНаименование = СтрокаЗначенияОтвета(СтрокаСотрудника.Подразделение);
	Результат.ДатаПриема = ДатаЗначенияОтвета(СтрокаСотрудника.ДатаПриема);
	Результат.ДатаУвольнения = ДатаЗначенияОтвета(СтрокаСотрудника.ДатаУвольнения);
	Результат.ОформленПоТрудовомуДоговору = СтрокаСотрудника.ОформленПоТрудовомуДоговору = Истина;
	Результат.ОсновноеРабочееМестоВОрганизации = СтрокаСотрудника.ОсновноеРабочееМестоВОрганизации = Истина;
	Результат.ГоловнаяОрганизацияGUID = ИдентификаторЗначенияОтвета(СтрокаСотрудника.ГоловнаяОрганизация);
	Результат.ТекущаяОрганизацияGUID = ИдентификаторЗначенияОтвета(СтрокаСотрудника.ТекущаяОрганизация);

	РеквизитыОрганизации = РеквизитыОрганизаций[СтрокаСотрудника.ГоловнаяОрганизация];
	Если РеквизитыОрганизации <> Неопределено Тогда
		Результат.ГоловнаяОрганизацияИНН = СтрокаЗначенияОтвета(РеквизитыОрганизации.ИНН);
		Результат.ГоловнаяОрганизацияКПП = СтрокаЗначенияОтвета(РеквизитыОрганизации.КПП);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Дополняет элементы ответа документами физических лиц.
Процедура ДополнитьОтветДокументамиФизическихЛиц(МодульКадровыйУчет, ЭлементыПоФизлицу, Физлица)

	//@skip-check dynamic-access-method-not-found
	ДанныеДокументов = МодульКадровыйУчет.ДокументыФизическихЛиц(Физлица, Истина);
	Если ДанныеДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВидыДокументов = ДанныеДокументов.ВыгрузитьКолонку("ВидДокумента");
	ИменаВидов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ВидыДокументов,
		"ИмяПредопределенныхДанных, Наименование");

	Для Каждого СтрокаДокумента Из ДанныеДокументов Цикл
		Элементы = ЭлементыПоФизлицу[СтрокаДокумента.ФизическоеЛицо];
		Если Элементы = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Элемент Из Элементы Цикл
			Элемент.Документы.Добавить(НовыйДокументОтвета(СтрокаДокумента, ИменаВидов));
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Возвращает данные одного документа физического лица для ответа.
Функция НовыйДокументОтвета(СтрокаДокумента, ИменаВидов)

	Результат = НовыйДокументФизическогоЛица();
	Результат.Серия = СтрокаЗначенияОтвета(СтрокаДокумента.Серия);
	Результат.Номер = СтрокаЗначенияОтвета(СтрокаДокумента.Номер);
	Результат.КемВыдан = СтрокаЗначенияОтвета(СтрокаДокумента.КемВыдан);
	Результат.КодПодразделения = СтрокаЗначенияОтвета(СтрокаДокумента.КодПодразделения);
	Результат.ДатаВыдачи = ДатаЗначенияОтвета(СтрокаДокумента.ДатаВыдачи);
	Результат.СрокДействия = ДатаЗначенияОтвета(СтрокаДокумента.СрокДействия);
	Результат.Период = ДатаЗначенияОтвета(СтрокаДокумента.Период);
	Результат.ЯвляетсяДокументомУдостоверяющимЛичность =
		СтрокаДокумента.ЯвляетсяДокументомУдостоверяющимЛичность = Истина;
	Результат.ФамилияЛатиницей = СтрокаЗначенияОтвета(СтрокаДокумента.ФамилияЛатиницей);
	Результат.ИмяЛатиницей = СтрокаЗначенияОтвета(СтрокаДокумента.ИмяЛатиницей);

	РеквизитыВида = ИменаВидов[СтрокаДокумента.ВидДокумента];
	Если РеквизитыВида <> Неопределено Тогда
		Результат.ВидДокументаИмяПредопределенного = СтрокаЗначенияОтвета(РеквизитыВида.ИмяПредопределенныхДанных);
		Результат.ВидДокументаНаименование = СтрокаЗначенияОтвета(РеквизитыВида.Наименование);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Добавляет элемент ответа в соответствие по физическому лицу.
Процедура ДобавитьЭлементПоФизлицу(ЭлементыПоФизлицу, Физлицо, Элемент)

	Элементы = ЭлементыПоФизлицу[Физлицо];
	Если Элементы = Неопределено Тогда
		Элементы = Новый Массив;
		ЭлементыПоФизлицу.Вставить(Физлицо, Элементы);
	КонецЕсли;
	Элементы.Добавить(Элемент);

КонецПроцедуры

// Возвращает метаданные справочника сотрудников или Неопределено.
Функция МетаданныеСправочникаСотрудники()

	Возврат Метаданные.Справочники.Найти("Сотрудники");

КонецФункции

// Возвращает идентификатор ссылки, для незаполненного значения - пустой идентификатор.
//
// Приемник разбирает эти поля конструктором Новый УникальныйИдентификатор, поэтому пустая строка
// здесь недопустима: она прервала бы загрузку. Пустой идентификатор он обрабатывает штатно -
// получает по нему пустую ссылку и пропускает запись.
//
Функция ИдентификаторЗначенияОтвета(Значение)

	Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Значение)) Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
	КонецЕсли;

	Возврат Значение.УникальныйИдентификатор();

КонецФункции

// Возвращает строковое представление значения, пустое для NULL и Неопределено.
Функция СтрокаЗначенияОтвета(Значение)

	Если Значение = Неопределено Или Значение = NULL Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Возвращает дату, пустую для NULL и Неопределено.
Функция ДатаЗначенияОтвета(Значение)

	Если ТипЗнч(Значение) <> Тип("Дата") Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Возвращает массив заполненных ссылок из переданного значения.
Функция ЗаполненныеСсылки(Знач Значение)

	Результат = Новый Массив;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Ссылка Из Значение Цикл
		Если ЗначениеЗаполнено(Ссылка) Тогда
			Результат.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает данные банковских счетов организаций по составу метаданных конфигурации.
//
// Параметры:
//  Отборы - Структура - отборы запроса по организациям
//
// Возвращаемое значение:
//  Массив Из Структура - см. НовыеДанныеБанковскогоСчета
//
Функция ДанныеБанковскихСчетовПоУмолчанию(Отборы)

	Результат = Новый Массив; // Массив Из Структура

	ТекстЗапроса = ТекстЗапросаБанковскихСчетов();
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Информация, , ,
			НСтр("ru='В учетном приложении не найден справочник банковских счетов организаций'"));
		Возврат Результат;
	КонецЕсли;

	СписокОрганизаций = ЗаполненныеСсылки(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отборы, "Организации"));

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("СписокОрганизаций", СписокОрганизаций);
	Запрос.УстановитьПараметр("ОтборПоОрганизациям", СписокОрганизаций.Количество() > 0);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДанныеСчета = НовыеДанныеБанковскогоСчета();
		ЗаполнитьЗначенияСвойств(ДанныеСчета, Выборка);
		Результат.Добавить(ДанныеСчета);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Возвращает текст запроса банковских счетов для той конфигурации, в которую встроена библиотека.
//
// Возвращаемое значение:
//  Строка - пустая строка, если подходящий справочник не найден
//
Функция ТекстЗапросаБанковскихСчетов()

	Если Метаданные.Справочники.Найти("БанковскиеСчетаОрганизаций") <> Неопределено Тогда
		Возврат
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Счета.Ссылка) КАК СчетGUID,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Счета.Владелец) КАК ОрганизацияGUID,
		|	Счета.НомерСчета КАК НомерСчета,
		|	Счета.БИКБанка КАК БИК,
		|	Счета.НаименованиеБанка КАК БанкНаименование,
		|	ЕСТЬNULL(Счета.ВалютаДенежныхСредств.Код, """") КАК ВалютаКод,
		|	ЕСТЬNULL(Счета.ВалютаДенежныхСредств.Наименование, """") КАК ВалютаНаименование
		|ИЗ
		|	Справочник.БанковскиеСчетаОрганизаций КАК Счета
		|ГДЕ
		|	НЕ Счета.Закрыт
		|	И НЕ Счета.ПометкаУдаления
		|	И Счета.НомерСчета <> """"
		|	И (&ОтборПоОрганизациям = ЛОЖЬ
		|			ИЛИ Счета.Владелец В (&СписокОрганизаций))";
	КонецЕсли;

	Если Метаданные.Справочники.Найти("БанковскиеСчета") <> Неопределено Тогда
		Возврат
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Счета.Ссылка) КАК СчетGUID,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Счета.Владелец) КАК ОрганизацияGUID,
		|	Счета.НомерСчета КАК НомерСчета,
		|	ЕСТЬNULL(Счета.Банк.Код, """") КАК БИК,
		|	ЕСТЬNULL(Счета.Банк.Наименование, """") КАК БанкНаименование,
		|	ЕСТЬNULL(Счета.ВалютаДенежныхСредств.Код, """") КАК ВалютаКод,
		|	ЕСТЬNULL(Счета.ВалютаДенежныхСредств.Наименование, """") КАК ВалютаНаименование
		|ИЗ
		|	Справочник.БанковскиеСчета КАК Счета
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(Счета.Владелец) = ТИП(Справочник.Организации)
		|	И НЕ Счета.ПометкаУдаления
		|	И Счета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
		|	И Счета.НомерСчета <> """"
		|	И (&ОтборПоОрганизациям = ЛОЖЬ
		|			ИЛИ Счета.Владелец В (&СписокОрганизаций))";
	КонецЕсли;

	МетаданныеПроектов = Метаданные.Справочники.Найти("ЗарплатныеПроекты");
	Если МетаданныеПроектов <> Неопределено Тогда
		УсловиеАрхива = "";
		Если МетаданныеПроектов.Реквизиты.Найти("ВАрхиве") <> Неопределено Тогда
			УсловиеАрхива = "
			|	И НЕ ЗарплатныеПроекты.ВАрхиве";
		КонецЕсли;

		Возврат
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗарплатныеПроекты.Ссылка) КАК СчетGUID,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ЗарплатныеПроекты.Организация) КАК ОрганизацияGUID,
		|	ЗарплатныеПроекты.РасчетныйСчет КАК НомерСчета,
		|	ЕСТЬNULL(ЗарплатныеПроекты.Банк.Код, """") КАК БИК,
		|	ЕСТЬNULL(ЗарплатныеПроекты.Банк.Наименование, """") КАК БанкНаименование,
		|	ЕСТЬNULL(ЗарплатныеПроекты.Валюта.Код, """") КАК ВалютаКод,
		|	ЕСТЬNULL(ЗарплатныеПроекты.Валюта.Наименование, """") КАК ВалютаНаименование
		|ИЗ
		|	Справочник.ЗарплатныеПроекты КАК ЗарплатныеПроекты
		|ГДЕ
		|	НЕ ЗарплатныеПроекты.ПометкаУдаления
		|	И ЗарплатныеПроекты.РасчетныйСчет <> """"
		|	И (&ОтборПоОрганизациям = ЛОЖЬ
		|			ИЛИ ЗарплатныеПроекты.Организация В (&СписокОрганизаций))" + УсловиеАрхива;
	КонецЕсли;

	Возврат "";

КонецФункции

#КонецОбласти