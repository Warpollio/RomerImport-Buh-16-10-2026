			КонецЕсли;
		КонецЕсли;
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("Использование", Ложь);
		РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, ПараметрыЗадания);
	КонецЦикла;
	
КонецПроцедуры

// Исправляет использование предопределенного регламентного задания получения сообщений из Отчетность24.
//
// Обработчик обновления информационной базы разделенных данных, см.
// ОбновлениеИнформационнойБазыБРО.ПриДобавленииОбработчиковОбновления.
// Выполняется отложенно в каждой области данных (в локальном режиме работы - один раз),
// поэтому вход в область данных и анализ признака ОбластьДанных заданий не требуются.
//
// Параметры:
//  Параметры - Структура - параметры отложенного обработчика обновления,
//              см. ОбновлениеИнформационнойБазыСлужебный.ВыполнитьОтложенныйОбработчик.
//
Процедура ИсправлениеРегламентныхЗаданий(Параметры) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОбновлениеИнформационнойБазы.ЗаписатьСобытиеВЖурналРегистрации(
		НСтр("ru = 'Начало исправления регламентных заданий получения сообщений из Отчетность24.'"),
		УровеньЖурналаРегистрации.Информация,
		Параметры);
	
	МетаданныеЗадания = Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24;
	ДолжноИспользоваться = ИнтеграцияСОтчетность24ВызовСервера.ЕстьНастроенныеИнтеграции();
	
	Если РаботаВМоделиСервиса.РазделениеВключено() Тогда
		
		// В модели сервиса задания хранятся в очереди заданий: актуально только задание,
		// созданное по шаблону предопределенного задания, остальные задания устарели.
		РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(МетаданныеЗадания);
		Если РегламентноеЗадание = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		// Задания, созданные без шаблона, устарели.
		Отбор = Новый Структура;
		Отбор.Вставить("ИмяМетода", МетаданныеЗадания.ИмяМетода);
		Отбор.Вставить("Шаблон", Справочники.ШаблоныЗаданийОчереди.ПустаяСсылка());
		УдалитьЗадания(РегламентныеЗаданияСервер.НайтиЗадания(Отбор));
		
		ШаблонЗадания = Справочники.ШаблоныЗаданийОчереди.ПолучитьСсылку(РегламентноеЗадание.УникальныйИдентификатор);
		ЗаданияПоШаблону = РегламентныеЗаданияСервер.НайтиЗадания(Новый Структура("Шаблон", ШаблонЗадания));
		
		// Задание включается только при наличии настроенных подключений к Отчетность24.
		Для Каждого Задание Из ЗаданияПоШаблону Цикл
			УстановитьИспользованиеЗадания(Задание, ДолжноИспользоваться);
		КонецЦикла;
		
	Иначе
		
		// В локальном режиме работы устаревшие задания распознаются по ключу задания.
		Отбор = Новый Структура("Ключ", МетаданныеЗадания.Ключ);
		Для Каждого Задание Из РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор) Цикл
			Если Задание.Предопределенное Тогда
				УстановитьИспользованиеЗадания(Задание, ДолжноИспользоваться);
			Иначе
				УдалитьЗадание(Задание);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// См. ВыгрузкаЗагрузкаДанныхПереопределяемый.ПриЗаполненииТиповИсключаемыхИзВыгрузкиЗагрузки.
Процедура ПриЗаполненииТиповИсключаемыхИзВыгрузкиЗагрузки(Типы) Экспорт

	Если Не ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.ВыгрузкаЗагрузкаДанных") Тогда
		Возврат;
	КонецЕсли;
	
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРОЗапросы);
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРОНастройкиПодтверждения);
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРООграниченияПоОрганизациям);
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРОПараметрыШины);
	Типы.Добавить(Метаданные.РегистрыСведений.Отчетность24БРОПодключения);
	Типы.Добавить(Метаданные.РегистрыСведений.УдалитьОтчетность24БРОПараметрыШины);

КонецПроцедуры

// Возвращает параметры базы данных.
// 
// Возвращаемое значение:
//  Структура:
// * Имя                - Строка
// * АдресОбласти       - Строка
// * ИдентификаторБазы  - Строка
// * ЭтоФайловаяБаза    - Булево
// * ВерсияКонфигурации - Строка
// * Конфигурация       - Строка
Функция ПараметрыБазыДанных() Экспорт
	
	Результат = Новый Структура(); 
	Результат.Вставить("Имя", Строка(ОбменДаннымиПовтИсп.ИмяЭтойИнформационнойБазы()));
	Результат.Вставить("АдресОбласти", Отчетность24БРО.АдресОбласти());
	Результат.Вставить("ИдентификаторБазы", Отчетность24БРО.ИдентификаторБазы());
	Результат.Вставить("ЭтоФайловаяБаза", ОбщегоНазначения.ИнформационнаяБазаФайловая());
	Результат.Вставить("ВерсияКонфигурации", ИнтернетПоддержкаПользователей.ВерсияКонфигурации());
	Результат.Вставить("Конфигурация", 
		Строка(УдалитьВерсиюИзНаименованияКонфигурации(ИнтернетПоддержкаПользователей.СинонимКонфигурации())));
	
	Возврат Результат;
	
КонецФункции

// Возвращает параметры авторизации.
// 
// Параметры:
//  Соединение    - HTTPСоединение, Неопределено - Соединение
//  Принудительно - Булево - Принудительно
// 
// Возвращаемое значение:
//  Структура:
// * Токен    - Строка 
// * ТикетИТС - Строка 
Функция ПолучитьПараметрыАвторизации(Соединение = Неопределено, Принудительно = Ложь) Экспорт
	
	Возврат Отчетность24БРО.ПараметрыАвторизации(Соединение, Принудительно);
	
КонецФункции

