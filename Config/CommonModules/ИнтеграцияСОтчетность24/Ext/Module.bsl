// Корректировка параметров отчета.
// 
// Параметры:
//  ПараметрыОтчета - Структура
//  ИДОтчета        - Строка
//  Контейнер       - Неопределено, Структура, Произвольный -
Процедура СкорректироватьПараметрыОтчета(ПараметрыОтчета, ИДОтчета, Контейнер)

	КлючСвойства = "АдресВоВременномХранилище";
	Если ПараметрыОтчета.Свойство(КлючСвойства) Тогда
		ПараметрыОтчета[КлючСвойства] = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	КонецЕсли;

	КлючСвойства = "АдресВременногоХранилищаРасшифровки";
	Если ПараметрыОтчета.Свойство(КлючСвойства) Тогда
		ПараметрыОтчета[КлючСвойства] = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	КонецЕсли;

	КлючСвойства = "АдресХранилища";
	Если ПараметрыОтчета.Свойство(КлючСвойства) Тогда
		ПараметрыОтчета[КлючСвойства] = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	КонецЕсли;

	КлючСвойства = "ИсточникДанныхДляОблака";
	Если ПараметрыОтчета.Свойство(КлючСвойства) И ТипЗнч(Контейнер) = Тип("Структура") И Не Контейнер.Свойство(
		КлючСвойства) Тогда
		Контейнер.Вставить(КлючСвойства, ПараметрыОтчета[КлючСвойства]);
	КонецЕсли;

	Для Каждого КлючИЗначение Из ПараметрыОтчета Цикл // КлючИЗначение
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("ДокументСсылка.РегламентированныйОтчет") Тогда
				// Очищаем ссылки на отчеты чтобы они не были перезаписаны в учетной системе

			Если СтрНачинаетсяС(ИДОтчета, "РегламентированныйОтчетАлко") Тогда
					// Для заполнения и передачи данных регистров в конфигурацию Отчетность
				Если ТипЗнч(Контейнер) = Тип("Структура") И Не Контейнер.Свойство("Регистры") Тогда
					Контейнер.Вставить("Регистры", Новый Структура);
				КонецЕсли;
				ПараметрыОтчета[КлючИЗначение.Ключ] = Контейнер["Регистры"];
			Иначе
				ПараметрыОтчета[КлючИЗначение.Ключ] = Неопределено;
			КонецЕсли;

		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Возвращает актульную редакцию отчета в учетной базе
// 
// Параметры:
//  МетаданныеОтчета - ОбъектМетаданныхОтчет
//  ИДРедакцииОтчета - Строка - 
// 
// Возвращаемое значение:
//  Строка - Имя формы отчета
Функция ПодобратьРедакциюОтчета(МетаданныеОтчета, ИДРедакцииОтчета)

	Результат = Строка(ИДРедакцииОтчета);

	ПрефиксИмениФормы = "";
	МассивЦифр = "0123456789";
	Для СчетчикСимволов = 1 По СтрДлина(ИДРедакцииОтчета) Цикл
		ТекущийСимвол = Сред(ИДРедакцииОтчета, СчетчикСимволов, 1);
		Если СтрНайти(МассивЦифр, ТекущийСимвол) > 0 Тогда
			Прервать;
		Иначе
			ПрефиксИмениФормы = ПрефиксИмениФормы + ТекущийСимвол;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(ПрефиксИмениФормы) Тогда
		МаксИмяФормы = "";

		Для Каждого ФормаОтчетаМетаданные Из МетаданныеОтчета.Формы Цикл // ОбъектМетаданных
			Если СтрНачинаетсяС(ФормаОтчетаМетаданные.Имя, Строка(ПрефиксИмениФормы)) И ФормаОтчетаМетаданные.Имя
				> МаксИмяФормы Тогда
				МаксИмяФормы = ФормаОтчетаМетаданные.Имя;
			КонецЕсли;
		КонецЦикла;

		Если ЗначениеЗаполнено(МаксИмяФормы) Тогда
			Результат = Строка(МаксИмяФормы);
		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает структуру заголовков сообщения.
