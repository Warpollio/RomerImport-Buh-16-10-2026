	Отбор = Новый Структура();
	Если РаботаВМоделиСервиса.РазделениеВключено() Тогда
		Отбор.Вставить("ИмяМетода", Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24.ИмяМетода);
	Иначе
		Отбор.Вставить("Ключ", Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24.Ключ);
	КонецЕсли;
	Отбор.Вставить("Использование", Истина);
	НайденныеЗадания = РегламентныеЗаданияСервер.НайтиЗадания(Отбор);
	Для Каждого Задание Из НайденныеЗадания Цикл
		Если РаботаВМоделиСервиса.РазделениеВключено() Тогда
			Если Не ЗначениеЗаполнено(Задание.Шаблон) Тогда
				ПараметрыЗадания = Новый Структура;
				ПараметрыЗадания.Вставить("Использование", Ложь);
				РегламентныеЗаданияСервер.ИзменитьЗадание(Задание.УникальныйИдентификатор, ПараметрыЗадания);
				РегламентныеЗаданияСервер.УдалитьЗадание(Задание.УникальныйИдентификатор);
				Продолжить;
			КонецЕсли;
		Иначе
			Если Не Задание.Предопределенное Тогда
