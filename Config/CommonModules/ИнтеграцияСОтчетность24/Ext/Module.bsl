// Возвращает признак того, что учетное приложение умеет заполнять документы персучета
// программно через менеджер объекта.
//
// Возвращаемое значение:
//  Булево
Функция ЗаполнениеДокументовПоддерживается()

	МинимальнаяВерсияБЗК = "3.1.38.92";

	ВерсияБЗК = Отчетность24БРО.ВерсияБЗК();
	Если Не ЗначениеЗаполнено(ВерсияБЗК) Тогда
		// В конфигурации без подсистемы зарплаты версию сравнивать не с чем,
		// поэтому заполнение не запрещается: объект заполнит свой менеджер, если метод в нем есть.
		Возврат Истина;
	КонецЕсли;

	Результат = Истина;
	Попытка
		Результат = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияБЗК, МинимальнаяВерсияБЗК) >= 0;
	Исключение
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРегистрации(), УровеньЖурналаРегистрации.Информация, , ,
			СтрШаблон(НСтр("ru='Версия БЗК %1 не распознана, заполнение выполняется без проверки версии'"),
			ВерсияБЗК));
	КонецПопытки;

	Возврат Результат;

КонецФункции

Процедура ОбработатьОтложенныеЗапросы() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗапросыПодтверждения.Идентификатор КАК Идентификатор,
	|	ЗапросыПодтверждения.Получатель КАК Получатель,
	|	ЗапросыПодтверждения.Отправитель КАК Отправитель,
	|	ЗапросыПодтверждения.ИДОтчета КАК ИДОтчета,
	|	ЗапросыПодтверждения.ИДРедакцииОтчета КАК ИДРедакцииОтчета,
	|	ЗапросыПодтверждения.ИмяТипа КАК ИмяТипа,
	|	ЗапросыПодтверждения.ТелоЗапроса КАК ТелоЗапроса,
	|	ЗапросыПодтверждения.Подтверждено КАК Подтверждено,
	|	ЗапросыПодтверждения.Отклонено КАК Отклонено,
	|	Отчетность24Подключения.Госорганы КАК Госорганы
	|ИЗ
	|	РегистрСведений.Отчетность24БРОЗапросы КАК ЗапросыПодтверждения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Отчетность24БРОПодключения КАК
	|			Отчетность24Подключения
	|		ПО ЗапросыПодтверждения.Отправитель = Отчетность24Подключения.Получатель
	|ГДЕ
	|	ЗапросыПодтверждения.Подтверждено = ИСТИНА
	|	ИЛИ ЗапросыПодтверждения.Отклонено = ИСТИНА";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;

	Выборка = Новый Структура();
	Выборка.Вставить("Идентификатор", "");
	Выборка.Вставить("Получатель", "");
	Выборка.Вставить("Отправитель", "");
	Выборка.Вставить("ИДОтчета", "");
	Выборка.Вставить("ИДРедакцииОтчета", "");
	Выборка.Вставить("ИмяТипа", "");
	Выборка.Вставить("ТелоЗапроса", "");
	Выборка.Вставить("Подтверждено", ложь);
	Выборка.Вставить("Отклонено", Ложь);
	Выборка.Вставить("Госорганы", "");
	
	ВыборкаЗапроса = РезультатЗапроса.Выбрать();
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(Выборка, ВыборкаЗапроса);
		
		Если Выборка.ТелоЗапроса = "" Тогда
			УдалитьЗапросИзОчереди(Выборка.Идентификатор);
			Продолжить;
		КонецЕсли;

		Попытка
			ДанныеЗапроса = Отчетность24БРОСериализация.JSONВЗначение(Выборка.ТелоЗапроса, Ложь);
		Исключение
			ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации(
				ИмяСобытияЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки);
			Возврат;
		КонецПопытки;
	
		ВходящийКонтейнер = Неопределено;
		
		ИмяСвойстваКонтейнер = "Контейнер";

		Если ТипЗнч(ДанныеЗапроса) = Тип("Структура") И ДанныеЗапроса.Свойство(ИмяСвойстваКонтейнер, ВходящийКонтейнер) Тогда
			
			Если ТипЗнч(ВходящийКонтейнер) = Тип("Строка") Тогда
				ВходящийКонтейнерХранилище = XMLЗначение(Тип("ХранилищеЗначения"), ВходящийКонтейнер); // ХранилищеЗначения
				Если ВходящийКонтейнерХранилище <> Неопределено Тогда
					КонтейнерJSON = ВходящийКонтейнерХранилище.Получить(); // Строка
					Попытка
						НовыйВходящийКонтейнер = Отчетность24БРОСериализация.JSONВЗначение(КонтейнерJSON, Ложь);
					Исключение
						ОписаниеОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
						ЗаписьЖурналаРегистрации(
						ИмяСобытияЖурналаРегистрации(),
						УровеньЖурналаРегистрации.Ошибка,,,
						ОписаниеОшибки);
						Возврат;
					КонецПопытки;
					ДанныеЗапроса[ИмяСвойстваКонтейнер] = НовыйВходящийКонтейнер;
				КонецЕсли;
			КонецЕсли;	
			
		КонецЕсли;
		
		
		ИмяТипа = "";
		Если ЗначениеЗаполнено(Выборка.ИмяТипа) Тогда
			ИмяТипа = Выборка.ИмяТипа;
		КонецЕсли;
		
		ИДОтчета = "";
		ИДРедакцииОтчета = "";
		Если Не ЗначениеЗаполнено(ИмяТипа) И 
			(ДанныеЗапроса.Свойство("ИДОтчета", ИДОтчета) = Ложь 
				Или ДанныеЗапроса.Свойство("ИДРедакцииОтчета", ИДРедакцииОтчета) = Ложь) Тогда
			УдалитьЗапросИзОчереди(Выборка.Идентификатор);
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяТипа) Тогда
			ГосорганОтчета = ИнтеграцияСОтчетность24КлиентСервер.ГосорганПоИмениТипа(ИмяТипа);
		Иначе
			ГосорганОтчета = ГосорганОтчета(ИДОтчета);
		КонецЕсли;
		
		ТранспортныйКонтейнер = НовыйТранспортныйКонтейнер();
		
		Если Выборка.Отклонено Тогда
			ТранспортныйКонтейнер.ДоступРазрешен = Ложь;
			ТранспортныйКонтейнер.ТекстОшибки = НСтр("ru = 'Передача данных по этому отчету отклонена
			|пользователем учетного приложения'");
		ИначеЕсли Не ЗначениеЗаполнено(ГосорганОтчета) Тогда
			ТранспортныйКонтейнер.ДоступРазрешен = Истина;
		Иначе
			ТранспортныйКонтейнер.Госорган = ГосорганОтчета;
			Если СтрНайти(Выборка.Госорганы, ГосорганОтчета) = 0 Тогда
				ТранспортныйКонтейнер.ДоступРазрешен = Ложь;
				ТранспортныйКонтейнер.ТекстОшибки = НСтр("ru = 'Доступ к данным для заполнения отчета в'") 
					+ СтрШаблон(" %1 запрещен", ГосорганОтчета);
			Иначе
				ТранспортныйКонтейнер.ДоступРазрешен = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ТранспортныйКонтейнер.ДоступРазрешен Тогда
			ДобавитьРезультатЗаполненияВТранспортныйКонтейнер(ТранспортныйКонтейнер, ДанныеЗапроса);
		Иначе
			ТранспортныйКонтейнер.Вставить("ЕстьВерсия");
		КонецЕсли;
		
		ОтправитьТранспортныйКонтейнер(ТранспортныйКонтейнер, Выборка.Получатель, Выборка.Отправитель, Выборка.Идентификатор); 
		
		УдалитьЗапросИзОчереди(Выборка.Идентификатор);
	КонецЦикла;
	
КонецПроцедуры  

Процедура РегламентноеЗаданиеПолучениеСообщенийИзОтчетность24() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ПолучениеСообщенийИзОтчетность24);
	
	ПолучитьСообщенияПоHttp();
	
КонецПроцедуры
	
// Получить контейнер ответа по объекту.
// 
// Параметры:
//  Объект - СправочникОбъект, ДокументОбъект - 
// 
// Возвращаемое значение:
//  Структура
Функция ПолучитьКонтейнерОтветаПоОбъекту(Объект) Экспорт

	Результат = Новый Структура; 
	
	МетаданныеОбъекта = Объект.Метаданные();
	
	Результат = Новый Структура;
	Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл 
		Результат.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);		
	КонецЦикла;

	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл 
		Результат.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);		
	КонецЦикла;
	
	Для Каждого ТабЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл 
		МассивТабЧасти = Новый Массив; // Массив Из Структура
		Для Каждого СтрокаОбъекта Из Объект[ТабЧасть.Имя] Цикл // СтрокаТабличнойЧасти
			СтруктураСтроки = Новый Структура;
			Для Каждого КолокаТабЧасти Из ТабЧасть.Реквизиты Цикл 
				СтруктураСтроки.Вставить(КолокаТабЧасти.Имя, СтрокаОбъекта[КолокаТабЧасти.Имя]);		
			КонецЦикла;     
			МассивТабЧасти.Добавить(СтруктураСтроки);	
		КонецЦикла;
		Результат.Вставить(ТабЧасть.Имя, МассивТабЧасти);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает имена стандартных реквизитов, которые нельзя присвоить объекту из кода.
//
// Возвращаемое значение:
//  Массив Из Строка
Функция НедоступныеДляЗаписиСтандартныеРеквизиты()

	Результат = Новый Массив;
	Результат.Добавить("Ссылка");
	Результат.Добавить("Проведен");
	Результат.Добавить("ЭтоГруппа");
	Результат.Добавить("Предопределенный");
	Результат.Добавить("ИмяПредопределенныхДанных");

	Возврат Результат;

КонецФункции

// Загрузить контейнер в объект.
// 
// Параметры:
//  Объект           - ДокументОбъект, СправочникОбъект - 
//  ДанныеЗаполнения - Структура
Процедура ЗагрузитьКонтейнерВОбъект(Объект, ДанныеЗаполнения) Экспорт
	
	МетаданныеОбъекта = Объект.Метаданные();
	
	НедоступныеДляЗаписи = НедоступныеДляЗаписиСтандартныеРеквизиты();
	Для Каждого Реквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
		Если НедоступныеДляЗаписи.Найти(Реквизит.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ЗначениеРеквизита = Неопределено;
		Если ДанныеЗаполнения.Свойство(Реквизит.Имя, ЗначениеРеквизита) Тогда
			Объект[Реквизит.Имя] = ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл   
		ЗначениеРеквизита = Неопределено;
		Если ДанныеЗаполнения.Свойство(Реквизит.Имя, ЗначениеРеквизита) Тогда
			Объект[Реквизит.Имя] = ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;  
	
	Для Каждого ТабЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		МассивСтрок = Неопределено;
		Если ДанныеЗаполнения.Свойство(ТабЧасть.Имя, МассивСтрок) И ТипЗнч(МассивСтрок) = Тип("Массив") Тогда
			ОбъектТабЧасть = Объект[ТабЧасть.Имя]; // ТабличнаяЧасть
			Для Каждого СтруктураСтроки Из МассивСтрок Цикл
				ЗаполнитьЗначенияСвойств(ОбъектТабЧасть.Добавить(), СтруктураСтроки)	
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

// Контрольная сумма тикета ИТС.
