#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Создает запись в регистре сведений для выбранной позиции
//
// Параметры:
//  Номенклатура - СправочникСсылка.Номенклатура - Регистрируемый элемент
//  Отказ - Булево - Признак отказа от записи (устанавливается в Истина при ошибке)
//
Процедура ЗарегистрироватьИзменениеНоменклатуры(Номенклатура, Отказ) Экспорт

	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНоменклатуры.Добавить().Номенклатура = Номенклатура;

	ЗарегистрироватьИзмененияНоменклатуры(ТаблицаНоменклатуры, Отказ);

КонецПроцедуры

// Создает записи в регистре сведений для выбранных позиций номенклатуры.
//
// Параметры:
//  ТаблицаНоменклатуры - ТаблицаЗначений - регистрируемая номенклатура:
//   * Номенклатура - СправочникСсылка.Номенклатура - регистрируемый элемент.
//  Отказ - Булево - признак отказа от записи (устанавливается в Истина при ошибке).
//
Процедура ЗарегистрироватьИзмененияНоменклатуры(ТаблицаНоменклатуры, Отказ) Экспорт

	Если ТаблицаНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТаблицаРегистрации = ТаблицаНоменклатуры.Скопировать(, "Номенклатура");
	ТаблицаРегистрации.Свернуть("Номенклатура");
	ТаблицаРегистрации.Сортировать("Номенклатура");

	ДатаРегистрации = ТекущаяДатаСеанса();
	ТаблицаРегистрации.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата", , , , ,
		Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ТаблицаРегистрации.Колонки.Добавить("ИдентификаторИзменения",
		Новый ОписаниеТипов("УникальныйИдентификатор"));

	Для Каждого СтрокаРегистрации Из ТаблицаРегистрации Цикл
		СтрокаРегистрации.Период = ДатаРегистрации;
		СтрокаРегистрации.ИдентификаторИзменения = Новый УникальныйИдентификатор;
	КонецЦикла;

	НачатьТранзакцию();

	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(
			"РегистрСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = ТаблицаРегистрации;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
		Блокировка.Заблокировать();

		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Загрузить(ТаблицаРегистрации);
		НаборЗаписей.Записать(РежимЗамещения.Слияние);

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Отказ = Истина;
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ИмяСобытия = НСтр("ru = 'Сопоставление номенклатуры в сервисе NSM.Ошибка регистрации записи'");
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов, , ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

КонецПроцедуры

// Удаляет отправленные версии записей очереди или полностью очищает регистр.
//
// Параметры:
//  ТаблицаНоменклатуры - ТаблицаЗначений, Неопределено - отправленные записи очереди:
//   * Номенклатура - СправочникСсылка.Номенклатура - отправленная номенклатура;
//   * Период - Дата - период отправленной записи;
//   * ИдентификаторИзменения - УникальныйИдентификатор - версия отправленной записи.
//    Если Неопределено, очищаются все записи регистра.
//
Процедура ОчиститьОчередьРегистрации(ТаблицаНоменклатуры = Неопределено) Экспорт

	Попытка
		Если ТаблицаНоменклатуры = Неопределено Тогда
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Записать(Истина);
		Иначе
			УдалитьОтправленныеЗаписи(ТаблицаНоменклатуры);
		КонецЕсли;
	Исключение
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УдалитьОтправленныеЗаписи(ТаблицаНоменклатуры)

	ТаблицаБлокировки = ТаблицаНоменклатуры.Скопировать(, "Номенклатура");
	ТаблицаБлокировки.Свернуть("Номенклатура");
	ТаблицаБлокировки.Сортировать("Номенклатура");
	
	НачатьТранзакцию();
	
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(
			"РегистрСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = ТаблицаБлокировки;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
		Блокировка.Заблокировать();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаНоменклатуры", ТаблицаНоменклатуры);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
		|	ТаблицаНоменклатуры.Период КАК Период,
		|	ТаблицаНоменклатуры.ИдентификаторИзменения КАК ИдентификаторИзменения
		|ПОМЕСТИТЬ ОтправленныеЗаписи
		|ИЗ
		|	&ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Номенклатура,
		|	Период,
		|	ИдентификаторИзменения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Очередь.Номенклатура КАК Номенклатура,
		|	Очередь.Период КАК Период
		|ИЗ
		|	РегистрСведений.СопоставлениеНоменклатурыРаспознаваниеДокументов КАК Очередь
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОтправленныеЗаписи КАК ОтправленныеЗаписи
		|		ПО Очередь.Номенклатура = ОтправленныеЗаписи.Номенклатура
		|			И Очередь.Период = ОтправленныеЗаписи.Период
		|			И Очередь.ИдентификаторИзменения = ОтправленныеЗаписи.ИдентификаторИзменения";
		
		ТаблицаДляУдаления = Запрос.Выполнить().Выгрузить();
		
		Если ТаблицаДляУдаления.Количество() > 0 Тогда
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Загрузить(ТаблицаДляУдаления);
			НаборЗаписей.Записать(РежимЗамещения.Удаление);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
