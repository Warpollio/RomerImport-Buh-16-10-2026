
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ВариантОтправки = Параметры.ВариантОтправки;
	Контрагент = Параметры.Контрагент;

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьКонтактнуюИнформацию();
	УправлениеФормой(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)

	Если Не ЗначениеЗаполнено(АдресЭлектроннойПочты)
			И Не ЗначениеЗаполнено(НомерТелефона) Тогда
		Возврат;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("АдресЭлектроннойПочты", АдресЭлектроннойПочты);
	Результат.Вставить("НомерТелефона", НомерТелефона);

	СохранитьВыборНаСервере(Контрагент, АдресЭлектроннойПочты, НомерТелефона);

	Закрыть(Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Управляет видимостью элементов формы в зависимости от варианта отправки.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма ввода адреса отправки чека.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)

	Элементы = Форма.Элементы;
	ВариантыОтправки = ЧекиНПДКлиентСервер.ВариантыОтправкиЧека();

	Элементы.АдресЭлектроннойПочты.Видимость =
		(Форма.ВариантОтправки = ВариантыОтправки.ЭлектроннаяПочта);
	Элементы.НомерТелефона.Видимость =
		(Форма.ВариантОтправки = ВариантыОтправки.СМС);

	Если Форма.ВариантОтправки = ВариантыОтправки.ЭлектроннаяПочта Тогда
		Форма.Заголовок = НСтр("ru = 'Отправка чека по электронной почте'");
	Иначе
		Форма.Заголовок = НСтр("ru = 'Отправка чека по СМС'");
	КонецЕсли;

	Если ЗначениеЗаполнено(Форма.Контрагент) Тогда
		СсылкаНаКонтрагента = ПолучитьНавигационнуюСсылку(Форма.Контрагент);
		ПредставлениеКонтрагента = Строка(Форма.Контрагент);

		ЧастиТекстаПодсказки = Новый Массив;
		ЧастиТекстаПодсказки.Добавить(НСтр("ru = 'Адреса электронной почты контрагента'"));
		ЧастиТекстаПодсказки.Добавить(" ");
		ЧастиТекстаПодсказки.Добавить(
			Новый ФорматированнаяСтрока(ПредставлениеКонтрагента, , , , СсылкаНаКонтрагента));
		Элементы.АдресЭлектроннойПочты.РасширеннаяПодсказка.Заголовок =
			Новый ФорматированнаяСтрока(ЧастиТекстаПодсказки);

		ЧастиТекстаПодсказки = Новый Массив;
		ЧастиТекстаПодсказки.Добавить(НСтр("ru = 'Номера телефонов контрагента'"));
		ЧастиТекстаПодсказки.Добавить(" ");
		ЧастиТекстаПодсказки.Добавить(
			Новый ФорматированнаяСтрока(ПредставлениеКонтрагента, , , , СсылкаНаКонтрагента));
		Элементы.НомерТелефона.РасширеннаяПодсказка.Заголовок =
			Новый ФорматированнаяСтрока(ЧастиТекстаПодсказки);
	КонецЕсли;

КонецПроцедуры

// Заполняет реквизит формы адресом или телефоном контрагента в зависимости от варианта отправки.
//
&НаСервере
Процедура ЗаполнитьКонтактнуюИнформацию()

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	ВариантыОтправки = ЧекиНПДКлиентСервер.ВариантыОтправкиЧека();

	Если ВариантОтправки = ВариантыОтправки.ЭлектроннаяПочта Тогда
		ВидКИ = Справочники.ВидыКонтактнойИнформации.EmailКонтрагенты;
		СписокВыбора = Элементы.АдресЭлектроннойПочты.СписокВыбора;
	ИначеЕсли ВариантОтправки = ВариантыОтправки.СМС Тогда
		ВидКИ = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		СписокВыбора = Элементы.НомерТелефона.СписокВыбора;
	Иначе
		Возврат;
	КонецЕсли;

	СписокВыбора.Очистить();
	ЗаполнитьСписокВыбораИзКонтактнойИнформации(СписокВыбора, Контрагент, ВидКИ);

	Если СписокВыбора.Количество() > 0 Тогда
		УстановитьНачальноеЗначение(СписокВыбора);
	КонецЕсли;	

КонецПроцедуры

// Устанавливает начальное значение реквизита формы из сохранённой настройки
// или первого значения списка выбора.
//
// Параметры:
//  СписокВыбора - СписокЗначений - список выбора реквизита формы.
//
&НаСервере
Процедура УстановитьНачальноеЗначение(СписокВыбора)

	СохраненноеЗначение = ЗагрузитьСохраненноеЗначение(Контрагент, ВариантОтправки);
	НайденноеЗначение = НайтиВСпискеВыбора(СписокВыбора, СохраненноеЗначение);

	Если НайденноеЗначение <> Неопределено Тогда
		Если ВариантОтправки = ЧекиНПДКлиентСервер.ВариантыОтправкиЧека().ЭлектроннаяПочта Тогда
			АдресЭлектроннойПочты = НайденноеЗначение;
		Иначе
			НомерТелефона = НайденноеЗначение;
		КонецЕсли;
	ИначеЕсли ВариантОтправки = ЧекиНПДКлиентСервер.ВариантыОтправкиЧека().ЭлектроннаяПочта Тогда
		АдресЭлектроннойПочты = СписокВыбора[0].Значение;
	Иначе
		НомерТелефона = СписокВыбора[0].Значение;
	КонецЕсли;

КонецПроцедуры

// Заполняет список выбора значениями контактной информации указанного вида.
//
// Параметры:
//  СписокВыбора - СписокЗначений - список выбора реквизита формы.
//  ВладелецКИ - СправочникСсылка - ссылка на объект-владелец контактной информации.
//  ВидКИ - СправочникСсылка.ВидыКонтактнойИнформации - вид контактной информации.
//
&НаСервереБезКонтекста
Процедура ЗаполнитьСписокВыбораИзКонтактнойИнформации(СписокВыбора, ВладелецКИ, ВидКИ)

	КонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
		ВладелецКИ, ВидКИ, ТекущаяДатаСеанса(), Ложь);

	Для Каждого СтрокаКИ Из КонтактнаяИнформация Цикл
		Представление = СтрокаКИ.Представление;
		Примечание = УправлениеКонтактнойИнформацией.КомментарийКонтактнойИнформации(СтрокаКИ.Значение);
		Если ЗначениеЗаполнено(Примечание) Тогда
			Представление = СтрШаблон("%1 (%2)", Представление, Примечание);
		КонецЕсли;
		СписокВыбора.Добавить(СтрокаКИ.Представление, Представление);
	КонецЦикла;

КонецПроцедуры

// Ищет значение в списке выбора.
//
// Параметры:
//  СписокВыбора - СписокЗначений Из Строка - список выбора.
//  ИскомоеЗначение - Строка, Неопределено - значение для поиска.
//
// Возвращаемое значение:
//  Строка, Неопределено - найденное значение или Неопределено.
//
&НаКлиентеНаСервереБезКонтекста
Функция НайтиВСпискеВыбора(СписокВыбора, ИскомоеЗначение)

	Если Не ЗначениеЗаполнено(ИскомоеЗначение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	НайденныйЭлемент = СписокВыбора.НайтиПоЗначению(ИскомоеЗначение);
	Если НайденныйЭлемент <> Неопределено Тогда
		Возврат НайденныйЭлемент.Значение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаСервереБезКонтекста
Функция КлючНастроекВыбора(Контрагент, ВариантОтправки)

	Возврат СтрШаблон("%1/%2", ОбщегоНазначения.ЗначениеВСтрокуXML(Контрагент), ВариантОтправки);

КонецФункции

&НаСервереБезКонтекста
Функция КлючОбъекта()

	Возврат "РегистрСведений.ЧекиНПД.ФормаВводаАдресаОтправки";

КонецФункции

// Загружает ранее сохранённое значение выбора контактной информации.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент.
//  ВариантОтправки - Строка - вариант отправки чека.
//
// Возвращаемое значение:
//  Строка, Неопределено - сохранённое значение или Неопределено, если настройки нет.
//
&НаСервереБезКонтекста
Функция ЗагрузитьСохраненноеЗначение(Контрагент, ВариантОтправки)
	
	КлючНастроек = КлючНастроекВыбора(Контрагент, ВариантОтправки);

	СохраненноеЗначение = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта(), КлючНастроек);
	Если ТипЗнч(СохраненноеЗначение) = Тип("Строка") Тогда
		Возврат СохраненноеЗначение;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Сохраняет выбор контактной информации для последующего использования.
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты - контрагент.
//  АдресЭлектроннойПочты - Строка - выбранный адрес электронной почты.
//  НомерТелефона - Строка - выбранный номер телефона.
//
&НаСервереБезКонтекста
Процедура СохранитьВыборНаСервере(Знач Контрагент, Знач АдресЭлектроннойПочты, Знач НомерТелефона)

	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	ЗначениеДляСохранения = ?(ЗначениеЗаполнено(АдресЭлектроннойПочты),
		АдресЭлектроннойПочты, НомерТелефона);
	Если Не ЗначениеЗаполнено(ЗначениеДляСохранения) Тогда
		Возврат;
	КонецЕсли;

	ВариантыОтправки = ЧекиНПДКлиентСервер.ВариантыОтправкиЧека();
	Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		ВариантОтправки = ВариантыОтправки.ЭлектроннаяПочта;
	Иначе
		ВариантОтправки = ВариантыОтправки.СМС;
	КонецЕсли;

	КлючНастроек = КлючНастроекВыбора(Контрагент, ВариантОтправки);

	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта(), КлючНастроек, ЗначениеДляСохранения);

КонецПроцедуры

#КонецОбласти
