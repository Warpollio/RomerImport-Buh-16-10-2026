Функция РасчетыПоАвансам(Реквизиты, ВидыОплат)
	
	Контрагенты = ОбщегоНазначения.ВыгрузитьКолонку(ВидыОплат, "Контрагент", Истина);
	ДоговорыКонтрагентов = ОбщегоНазначения.ВыгрузитьКолонку(ВидыОплат, "ДоговорКонтрагента", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РасчетыПриЭквайрингеОстатки.Контрагент КАК Контрагент,
		|	РасчетыПриЭквайрингеОстатки.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	РасчетыПриЭквайрингеОстатки.РасчетныйДокумент КАК РасчетныйДокумент,
		|	ЕСТЬNULL(РеквизитыДокументовОплаты.ДатаРегистратора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДокументаРасчетов,
		|	РасчетыПриЭквайрингеОстатки.СуммаОстаток КАК СуммаОстаток,
		|	РасчетыПриЭквайрингеОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток
		|ИЗ
		|	РегистрНакопления.РасчетыПриЭквайринге.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Контрагент В (&Контрагенты)
		|				И ДоговорКонтрагента В (&ДоговорыКонтрагентов)
		|				И ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЭквайрингу.Возврат)
		|				И ТИПЗНАЧЕНИЯ(РасчетныйДокумент) = ТИП(Документ.СписаниеСРасчетногоСчета)) КАК РасчетыПриЭквайрингеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПервичныхДокументов КАК РеквизитыДокументовОплаты
		|		ПО (РеквизитыДокументовОплаты.Организация = &Организация)
		|			И РасчетыПриЭквайрингеОстатки.РасчетныйДокумент = РеквизитыДокументовОплаты.Документ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагент,
		|	ДоговорКонтрагента,
		|	РасчетныйДокумент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасчетыПриЭквайрингеОстатки.Контрагент КАК Контрагент,
		|	РасчетыПриЭквайрингеОстатки.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	РасчетыПриЭквайрингеОстатки.РасчетныйДокумент КАК РасчетныйДокумент,
		|	ЕСТЬNULL(РеквизитыДокументовОплаты.ДатаРегистратора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДокументаРасчетов,
		|	РасчетыПриЭквайрингеОстатки.СуммаОстаток КАК СуммаОстаток,
		|	РасчетыПриЭквайрингеОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток
		|ИЗ
		|	РегистрНакопления.РасчетыПриЭквайринге.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Контрагент В (&Контрагенты)
		|				И ДоговорКонтрагента В (&ДоговорыКонтрагентов)
		|				И ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЭквайрингу.Оплата)
		|				И ТИПЗНАЧЕНИЯ(РасчетныйДокумент) = ТИП(Документ.ПоступлениеНаРасчетныйСчет)) КАК РасчетыПриЭквайрингеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПервичныхДокументов КАК РеквизитыДокументовОплаты
		|		ПО (РеквизитыДокументовОплаты.Организация = &Организация)
		|			И РасчетыПриЭквайрингеОстатки.РасчетныйДокумент = РеквизитыДокументовОплаты.Документ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагент,
		|	ДоговорКонтрагента,
		|	РасчетныйДокумент";
	
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	Запрос.УстановитьПараметр("Период", Реквизиты.Период);
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(Реквизиты.Период, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("ДоговорыКонтрагентов", ДоговорыКонтрагентов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	Результат = Новый Структура();
	Результат.Вставить("ОстаткиСписаний", РезультатЗапроса[0].Выгрузить());
	Результат.Вставить("ОстаткиАвансов", РезультатЗапроса[1].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

Функция РасчетыПоВозвратам(Реквизиты, ТаблицаОплаты)
	
	Контрагенты = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаОплаты, "Контрагент", Истина);
	ДоговорыКонтрагентов = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаОплаты, "ДоговорКонтрагента", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РасчетыПриЭквайрингеОстатки.Контрагент КАК Контрагент,
		|	РасчетыПриЭквайрингеОстатки.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	РасчетыПриЭквайрингеОстатки.РасчетныйДокумент КАК РасчетныйДокумент,
		|	ЕСТЬNULL(РеквизитыДокументовОплаты.ДатаРегистратора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДокументаРасчетов,
		|	РасчетыПриЭквайрингеОстатки.СуммаОстаток КАК СуммаОстаток,
		|	РасчетыПриЭквайрингеОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток
		|ПОМЕСТИТЬ втОстаткиВозвратов
		|ИЗ
		|	РегистрНакопления.РасчетыПриЭквайринге.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Контрагент В (&Контрагенты)
		|				И ДоговорКонтрагента В (&ДоговорыКонтрагентов)
		|				И ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЭквайрингу.Возврат)) КАК РасчетыПриЭквайрингеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПервичныхДокументов КАК РеквизитыДокументовОплаты
		|		ПО (РеквизитыДокументовОплаты.Организация = &Организация)
		|			И РасчетыПриЭквайрингеОстатки.РасчетныйДокумент = РеквизитыДокументовОплаты.Документ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Контрагент,
		|	ДоговорКонтрагента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасчетыПриЭквайрингеОбороты.Регистратор КАК Регистратор,
		|	ЕСТЬNULL(РеквизитыДокументовОплаты.ДатаРегистратора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРегистратора,
		|	РасчетыПриЭквайрингеОбороты.РасчетныйДокумент КАК РасчетныйДокумент,
		|	втОстаткиВозвратов.ДатаДокументаРасчетов КАК ДатаДокументаРасчетов,
		|	РасчетыПриЭквайрингеОбороты.Контрагент КАК Контрагент,
		|	РасчетыПриЭквайрингеОбороты.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	РасчетыПриЭквайрингеОбороты.СуммаРасход КАК СуммаРасход,
		|	РасчетыПриЭквайрингеОбороты.СуммаНДСРасход КАК СуммаНДСРасход
		|ИЗ
		|	втОстаткиВозвратов КАК втОстаткиВозвратов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыПриЭквайринге.Обороты(
		|				,
		|				&КонецПериода,
		|				Регистратор,
		|				Организация = &Организация
		|					И Контрагент В (&Контрагенты)
		|					И ДоговорКонтрагента В (&ДоговорыКонтрагентов)
		|					И ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЭквайрингу.Возврат)) КАК РасчетыПриЭквайрингеОбороты
		|		ПО втОстаткиВозвратов.РасчетныйДокумент = РасчетыПриЭквайрингеОбороты.РасчетныйДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПервичныхДокументов КАК РеквизитыДокументовОплаты
		|		ПО (РеквизитыДокументовОплаты.Организация = &Организация)
		|			И (РасчетыПриЭквайрингеОбороты.Регистратор = РеквизитыДокументовОплаты.Документ)
		|ГДЕ
		|	(РасчетыПриЭквайрингеОбороты.СуммаРасход <> 0
		|			ИЛИ РасчетыПриЭквайрингеОбороты.СуммаНДСРасход <> 0)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагент,
		|	ДоговорКонтрагента,
		|	РасчетныйДокумент";
	
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	Запрос.УстановитьПараметр("Период", Реквизиты.Период);
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(Реквизиты.Период, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("ДоговорыКонтрагентов", ДоговорыКонтрагентов);
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	Результат = Новый Структура();
	Результат.Вставить("ОстаткиВозвратов", РезультатЗапроса[0].Выгрузить());
	Результат.Вставить("ОборотыВозвратов", РезультатЗапроса[1].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

Функция РасчетыПоОплатам(Реквизиты, ТаблицаВозвраты)
	
	Контрагенты = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаВозвраты, "Контрагент", Истина);
	ДоговорыКонтрагентов = ОбщегоНазначения.ВыгрузитьКолонку(ТаблицаВозвраты, "ДоговорКонтрагента", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	РасчетыПриЭквайрингеОстатки.Контрагент КАК Контрагент,
		|	РасчетыПриЭквайрингеОстатки.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	РасчетыПриЭквайрингеОстатки.РасчетныйДокумент КАК РасчетныйДокумент,
		|	ЕСТЬNULL(РеквизитыДокументовОплаты.ДатаРегистратора, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаДокументаРасчетов,
		|	РасчетыПриЭквайрингеОстатки.СуммаОстаток КАК СуммаОстаток,
		|	РасчетыПриЭквайрингеОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток
		|ИЗ
		|	РегистрНакопления.РасчетыПриЭквайринге.Остатки(
		|			&Период,
		|			Организация = &Организация
		|				И Контрагент В (&Контрагенты)
		|				И ДоговорКонтрагента В (&ДоговорыКонтрагентов)
		|				И ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЭквайрингу.Оплата)) КАК РасчетыПриЭквайрингеОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПервичныхДокументов КАК РеквизитыДокументовОплаты
		|		ПО (РеквизитыДокументовОплаты.Организация = &Организация)
		|			И РасчетыПриЭквайрингеОстатки.РасчетныйДокумент = РеквизитыДокументовОплаты.Документ
		|ГДЕ
		|	РасчетыПриЭквайрингеОстатки.СуммаОстаток + РасчетыПриЭквайрингеОстатки.СуммаНДСОстаток > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Контрагент,
		|	ДоговорКонтрагента";
	
	Запрос.УстановитьПараметр("Период", Реквизиты.Период);
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
	Запрос.УстановитьПараметр("ДоговорыКонтрагентов", ДоговорыКонтрагентов);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#КонецЕсли
